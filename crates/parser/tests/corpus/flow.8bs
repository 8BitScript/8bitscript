    if n > 7 { n = 1; }
    while n > 0 { n -= 1; continue; }
    loop { break; }
    for i in 0..10 { n += i; }
    for j: u8 in 1..=n { }
    for (let mut k: u8 = 9; k > 0; k -= 1) { }
    for (let c = 0; ; ) { }
    for (n = 0; n < 3; n += 1) { }
    for (;;) { break; }
    { let inner = 1; }
    ;
    #[unroll] for q in 0..4 { }
    asm6502 { nop }
    return n;
}

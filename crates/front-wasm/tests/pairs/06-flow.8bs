// rows: if, while, infinite loop, other for, return, break, continue, comments
fn g(n: u8) -> u8 {
    if n == 0 { return 1; } else if n < 5 { return 2; } else { n = 3; }
    if n > 7 { n = 1; }
    while n > 0 { n -= 1; continue; }
    loop { break; }
    /* counting down */
    for (let mut k: u8 = 9; k > 0; k -= 1) { n += k; }
    for (;;) { break; }
    { let inner: u8 = 1; }
    return n;
}

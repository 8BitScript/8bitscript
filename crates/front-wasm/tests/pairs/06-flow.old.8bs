// rows: if, while, infinite loop, other for, return, break, continue, comments
function g(n: u8): u8 {
  if (n == 0) return 1; else if (n < 5) { return 2; } else n = 3;
  if (n > 7) n = 1;
  while (n > 0) { n--; continue; }
  while (true) { break; }
  /* counting down */
  for (let k: u8 = 9; k > 0; k--) { n += k; }
  for (;;) { break; }
  { let inner: u8 = 1; }
  return n;
}

{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "8BitX",
  "scopeName": "source.8bx",
  "patterns": [
    {
      "include": "#component"
    },
    {
      "include": "#state"
    },
    {
      "include": "#element"
    },
    {
      "include": "source.8bs"
    }
  ],
  "repository": {
    "state": {
      "comment": "`state name: type = value;` inside a component: storage per static instance.",
      "match": "\\b(state)\\s+([a-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.type.state.8bx"
        },
        "2": {
          "name": "variable.other.state.8bx"
        }
      }
    },
    "component": {
      "comment": "`component Name(` — the one keyword 8BX adds; the name is the component's, PascalCase.",
      "match": "\\b(export\\s+)?(component)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.export.8bs"
        },
        "2": {
          "name": "storage.type.component.8bx"
        },
        "3": {
          "name": "entity.name.type.component.8bx"
        }
      }
    },
    "element": {
      "comment": "An element, from its `<Name` to the `/>` that closes it or the `</Name>` that matches it (a back-reference to the begin's name), with the children in between; or a fragment, `<>` … `</>`. `<` opens one only before a PascalCase name, `slot`, or `>`: `a < b`, `array<u8, 4>` and `x << 2` never match.",
      "patterns": [
        {
          "include": "#tag"
        },
        {
          "include": "#fragment"
        }
      ]
    },
    "tag": {
      "begin": "(<)(slot\\b|[A-Z][A-Za-z0-9_]*(?:\\.[A-Z][A-Za-z0-9_]*)*)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.8bx"
        },
        "2": {
          "name": "entity.name.tag.component.8bx"
        }
      },
      "end": "(/>)|(<)(/)(\\2)\\s*(>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.8bx"
        },
        "2": {
          "name": "punctuation.definition.tag.begin.8bx"
        },
        "3": {
          "name": "punctuation.definition.tag.begin.8bx"
        },
        "4": {
          "name": "entity.name.tag.component.8bx"
        },
        "5": {
          "name": "punctuation.definition.tag.end.8bx"
        }
      },
      "name": "meta.tag.8bx",
      "patterns": [
        {
          "include": "#attributes"
        },
        {
          "include": "#children"
        }
      ]
    },
    "fragment": {
      "begin": "(<)(>)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.8bx"
        },
        "2": {
          "name": "punctuation.definition.tag.end.8bx"
        }
      },
      "end": "(<)(/)(>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.8bx"
        },
        "2": {
          "name": "punctuation.definition.tag.begin.8bx"
        },
        "3": {
          "name": "punctuation.definition.tag.end.8bx"
        }
      },
      "name": "meta.tag.fragment.8bx",
      "patterns": [
        {
          "include": "#children"
        }
      ]
    },
    "attributes": {
      "comment": "From right after the name to the `>` that ends the opening tag (or the `/>` the tag rule ends on): attribute names, `=`, string and `{ … }` values.",
      "begin": "\\G",
      "end": "(>)|(?=/>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.8bx"
        }
      },
      "name": "meta.tag.attributes.8bx",
      "patterns": [
        {
          "comment": "An attribute name; `=` follows a valued one, nothing follows a bare (true) one.",
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\b(\\s*(=))?",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.8bx"
            },
            "3": {
              "name": "keyword.operator.assignment.8bx"
            }
          }
        },
        {
          "include": "source.8bs#strings"
        },
        {
          "include": "#expression"
        },
        {
          "include": "source.8bs#comments"
        }
      ]
    },
    "children": {
      "comment": "Between an opening tag and its closing tag: nested elements, `{ … }` expressions, `{/* … */}` comments; text is left plain, as JSX leaves it.",
      "patterns": [
        {
          "include": "#element"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "expression": {
      "comment": "`{ … }` in a tag or between tags: ordinary 8BitScript, braces nesting, with `?:` and `&&` composing elements (spec §48–§50).",
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.8bx"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.8bx"
        }
      },
      "name": "meta.embedded.expression.8bx",
      "patterns": [
        {
          "include": "source.8bs#comments"
        },
        {
          "include": "#element"
        },
        {
          "match": "\\?|:|&&",
          "name": "keyword.operator.ternary.8bx"
        },
        {
          "include": "#expression"
        },
        {
          "include": "source.8bs"
        }
      ]
    }
  }
}

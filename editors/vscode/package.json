{
  "name": "8bitscript-lang",
  "displayName": "8BitScript",
  "description": "Syntax highlighting, language server, and a project runner for 8BitScript (.8bs) source files.",
  "icon": "media/8bitscript-icon.png",
  "version": "0.2.1",
  "private": true,
  "publisher": "8bitscript",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/8BitScript/8bitscript.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://8bitscript.org/",
  "bugs": {
    "url": "https://github.com/8BitScript/8bitscript/issues"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "contributes": {
    "languages": [
      {
        "id": "8bitscript",
        "aliases": [
          "8BitScript",
          "8bs"
        ],
        "extensions": [
          ".8bs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "8bitscript",
        "scopeName": "source.8bs",
        "path": "./syntaxes/8bs.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "8bitscript",
        "path": "./snippets/8bs.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "8bitscript",
          "title": "8BitScript",
          "icon": "media/8bitscript-logo.svg"
        }
      ]
    },
    "views": {
      "8bitscript": [
        {
          "id": "8bitscript.launcher",
          "name": "8BitScript",
          "type": "webview",
          "icon": "media/8bitscript-logo.svg",
          "contextualTitle": "8BitScript",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "8bitscript.run",
        "title": "Run",
        "category": "8BitScript",
        "icon": "$(play)"
      },
      {
        "command": "8bitscript.build",
        "title": "Build",
        "category": "8BitScript",
        "icon": "$(tools)"
      },
      {
        "command": "8bitscript.boot",
        "title": "Boot (no program loaded)",
        "category": "8BitScript",
        "icon": "$(chip)"
      },
      {
        "command": "8bitscript.stop",
        "title": "Stop",
        "category": "8BitScript",
        "icon": "$(debug-stop)"
      },
      {
        "command": "8bitscript.launchStudio",
        "title": "Launch Studio",
        "category": "8BitScript",
        "icon": "$(rocket)"
      },
      {
        "command": "8bitscript.launchApp",
        "title": "Launch App\u2026",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.launchExample",
        "title": "Launch Example\u2026",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.doctor",
        "title": "Doctor: Check Toolchains",
        "category": "8BitScript",
        "icon": "$(pulse)"
      },
      {
        "command": "8bitscript.saveSystem",
        "title": "Save as a System\u2026",
        "category": "8BitScript",
        "icon": "$(save)"
      },
      {
        "command": "8bitscript.toggleExamples",
        "title": "Show or Hide Examples",
        "category": "8BitScript",
        "icon": "$(book)"
      },
      {
        "command": "8bitscript.refresh",
        "title": "Refresh Projects",
        "category": "8BitScript",
        "icon": "$(refresh)"
      },
      {
        "command": "8bitscript.install",
        "title": "Install Dependencies",
        "category": "8BitScript",
        "icon": "$(cloud-download)"
      },
      {
        "command": "8bitscript.selectProject",
        "title": "Select Project",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.selectSystem",
        "title": "Select System",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.selectRegion",
        "title": "Select Region (NTSC \u2014 US/Japan, PAL \u2014 Europe)",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.openEntry",
        "title": "Open Entry File",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.openConfig",
        "title": "Open 8bs.config.ts",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.restartServer",
        "title": "Restart Language Server",
        "category": "8BitScript"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "8bitscript.toggleExamples",
          "when": "view == 8bitscript.launcher && 8bitscript.hasExamples",
          "group": "navigation@0"
        },
        {
          "command": "8bitscript.launchStudio",
          "when": "view == 8bitscript.launcher",
          "group": "navigation@1"
        },
        {
          "command": "8bitscript.doctor",
          "when": "view == 8bitscript.launcher",
          "group": "navigation@2"
        },
        {
          "command": "8bitscript.refresh",
          "when": "view == 8bitscript.launcher",
          "group": "navigation@3"
        },
        {
          "command": "8bitscript.launchApp",
          "when": "view == 8bitscript.launcher",
          "group": "1_launch@0"
        },
        {
          "command": "8bitscript.launchExample",
          "when": "view == 8bitscript.launcher",
          "group": "1_launch@1"
        },
        {
          "command": "8bitscript.saveSystem",
          "when": "view == 8bitscript.launcher",
          "group": "2_system@0"
        }
      ]
    },
    "configuration": {
      "title": "8BitScript",
      "properties": {
        "8bitscript.region": {
          "type": "string",
          "enum": [
            "ntsc",
            "pal"
          ],
          "enumDescriptions": [
            "NTSC (US/Japan), 60Hz \u2014 the machine model 8bs run and 8bs build use by default.",
            "PAL (Europe), 50Hz \u2014 passes --pal to 8bs run and 8bs build."
          ],
          "default": "ntsc",
          "description": "The machine region the launcher runs with: NTSC (US/Japan) or PAL (Europe). Passed as --pal for the machines that have a region, ignored for the ones that do not. Set from the Region dropdown under Hardware \u00b7 Region \u00b7 Facts in the 8BitScript side bar."
        },
        "8bitscript.system": {
          "type": "string",
          "enum": [
            "pet",
            "web"
          ],
          "default": "pet",
          "description": "The system the launcher's Run and Build buttons use. Set from the System dropdown in the 8BitScript side bar, or 8BitScript: Select System. 0.2.0 builds for the PET and the web only, so that is the list; the other seven machines return here once their native backends land."
        },
        "8bitscript.project": {
          "type": "string",
          "default": "",
          "description": "The project the launcher's Run and Build buttons act on, as an absolute directory. Empty means the first project the workspace offers. Set from the Project dropdown in the 8BitScript side bar."
        },
        "8bitscript.examplesPath": {
          "type": "string",
          "default": "",
          "description": "A directory of your own examples to list in the launcher's Project dropdown, instead of the ones that ship with the toolchain (@8bitscript/examples). Each subdirectory with an 8bs.config.ts is one."
        },
        "8bitscript.hardware": {
          "type": "object",
          "default": {},
          "description": "The hardware fitted to each system when the launcher runs it: an object keyed by system, each `{ profile, options }` \u2014 a profile name (a preset from the machine's catalog, or one the project composes in its 8bs.config.ts) and option values set on top, passed as --profile and --hardware. Set under Hardware \u00b7 Region \u00b7 Facts in the 8BitScript side bar; `8bs targets` lists what each system can be fitted with.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "profile": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "options": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        },
        "8bitscript.showExamples": {
          "type": "boolean",
          "default": true,
          "description": "List the examples that ship with the toolchain (@8bitscript/examples, installed with @8bitscript/cli) in the launcher's Project dropdown, in a group of their own under the workspace's projects and beside the toolchain's apps. On by default. Toggled with the book icon in the 8BitScript side bar's title bar, which is only offered when there are examples to show. Launch Example\u2026 reaches them either way."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "8bs",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "run",
              "build",
              "doctor",
              "install"
            ],
            "description": "The 8bs subcommand to run."
          },
          "project": {
            "type": "string",
            "description": "The project directory, relative to the workspace folder. Defaults to the workspace folder itself."
          },
          "target": {
            "type": "string",
            "enum": [
              "pet",
              "web"
            ],
            "description": "The system to build for or run on. Required for run and build."
          },
          "pal": {
            "type": "boolean",
            "description": "Use the PAL (50Hz) machine model instead of NTSC. Ignored for web."
          }
        }
      }
    ]
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "workspaceContains:**/*.8bs",
    "workspaceContains:**/8bs.config.ts"
  ],
  "scripts": {
    "test": "node --test",
    "bundle": "esbuild src/extension.cjs --bundle --minify --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs",
    "package": "pnpm run bundle && vsce package --out dist/8bitscript-lang.vsix",
    "vscode:prepublish": "pnpm run bundle"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1",
    "esbuild": "0.28.1",
    "ovsx": "^0.10.1"
  },
  "files": [
    "dist",
    "media",
    "syntaxes",
    "snippets",
    "language-configuration.json",
    "README.md",
    "LICENSE"
  ]
}

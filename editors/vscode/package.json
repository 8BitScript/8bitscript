{
  "name": "8bitscript-lang",
  "displayName": "8BitScript",
  "description": "Syntax highlighting, language server, and a launcher for 8BitScript (.8bs, .8bx, .8bg, .8ba): run any program of a project on any system, in an editor tab, a browser or a native emulator.",
  "icon": "media/8bitscript-icon.png",
  "version": "0.24.0",
  "private": true,
  "publisher": "8bitscript",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/8BitScript/8bitscript.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://8bitscript.org/",
  "bugs": {
    "url": "https://github.com/8BitScript/8bitscript/issues"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "contributes": {
    "languages": [
      {
        "id": "8bitscript",
        "aliases": [
          "8BitScript",
          "8bs"
        ],
        "extensions": [
          ".8bs"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/src/8bs-light.svg",
          "dark": "./icons/src/8bs-dark.svg"
        }
      },
      {
        "id": "8bitextensible",
        "aliases": [
          "8BitX",
          "8bx"
        ],
        "extensions": [
          ".8bx"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/src/8bx-light.svg",
          "dark": "./icons/src/8bx-dark.svg"
        }
      },
      {
        "id": "8bitgraphics",
        "aliases": [
          "8BitGraphics",
          "8bg"
        ],
        "extensions": [
          ".8bg"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/src/8bg-light.svg",
          "dark": "./icons/src/8bg-dark.svg"
        }
      },
      {
        "id": "8bitaudio",
        "aliases": [
          "8BitAudio",
          "8ba"
        ],
        "extensions": [
          ".8ba"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/src/8ba-light.svg",
          "dark": "./icons/src/8ba-dark.svg"
        }
      },
      {
        "id": "8bitscript-asm",
        "aliases": [
          "8BitScript Generated Assembly"
        ],
        "configuration": "./language-configuration.asm.json"
      }
    ],
    "grammars": [
      {
        "language": "8bitscript",
        "scopeName": "source.8bs",
        "path": "./syntaxes/8bs.tmLanguage.json"
      },
      {
        "language": "8bitextensible",
        "scopeName": "source.8bx",
        "path": "./syntaxes/8bx.tmLanguage.json"
      },
      {
        "language": "8bitgraphics",
        "scopeName": "source.8bg",
        "path": "./syntaxes/8bg.tmLanguage.json"
      },
      {
        "language": "8bitaudio",
        "scopeName": "source.8ba",
        "path": "./syntaxes/8ba.tmLanguage.json"
      },
      {
        "language": "8bitscript-asm",
        "scopeName": "source.asm-8bs",
        "path": "./syntaxes/asm-8bs.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "8bitscript",
        "path": "./snippets/8bs.json"
      },
      {
        "language": "8bitgraphics",
        "path": "./snippets/8bg.json"
      },
      {
        "language": "8bitaudio",
        "path": "./snippets/8ba.json"
      }
    ],
    "iconThemes": [
      {
        "id": "8bitscript",
        "label": "8BitScript",
        "path": "./themes/8bitscript-icon-theme.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "8bitscript",
          "title": "8BitScript",
          "icon": "media/8bitscript-logo.svg"
        }
      ]
    },
    "views": {
      "8bitscript": [
        {
          "id": "8bitscript.launcher",
          "name": "8BitScript",
          "type": "webview",
          "icon": "media/8bitscript-logo.svg",
          "contextualTitle": "8BitScript",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "8bitscript.run",
        "title": "Run Program (Last Used Runtime)",
        "category": "8BitScript",
        "icon": "$(play)"
      },
      {
        "command": "8bitscript.runUnit",
        "title": "Run Program…",
        "category": "8BitScript",
        "icon": "$(play)"
      },
      {
        "command": "8bitscript.runEditor",
        "title": "Run in Editor Tab (WebAssembly)",
        "category": "8BitScript",
        "icon": "$(open-preview)"
      },
      {
        "command": "8bitscript.runBrowser",
        "title": "Run in Browser (WebAssembly)",
        "category": "8BitScript",
        "icon": "$(globe)"
      },
      {
        "command": "8bitscript.runNative",
        "title": "Run in Native Emulator",
        "category": "8BitScript",
        "icon": "$(device-desktop)"
      },
      {
        "command": "8bitscript.openBareEmulator",
        "title": "Open Bare Emulator (Nothing Loaded)",
        "category": "8BitScript",
        "icon": "$(chip)"
      },
      {
        "command": "8bitscript.revealProgram",
        "title": "Reveal Program in Config",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.build",
        "title": "Build (Compile Only, Writes dist/)",
        "category": "8BitScript",
        "icon": "$(tools)"
      },
      {
        "command": "8bitscript.boot",
        "title": "Boot (Alias of Open Bare Emulator)",
        "category": "8BitScript",
        "icon": "$(chip)"
      },
      {
        "command": "8bitscript.viewGeneratedAssembly",
        "title": "View Generated Assembly",
        "category": "8BitScript",
        "icon": "$(file-binary)"
      },
      {
        "command": "8bitscript.viewGeneratedAssemblyFor",
        "title": "View Generated Assembly For…",
        "category": "8BitScript",
        "icon": "$(file-binary)"
      },
      {
        "command": "8bitscript.assemblyView.openForMachine",
        "title": "Open For Another Machine…",
        "category": "8BitScript",
        "icon": "$(target)"
      },
      {
        "command": "8bitscript.assemblyView.toggleExplain",
        "title": "Toggle Plain-English Comments",
        "category": "8BitScript",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "8bitscript.stop",
        "title": "Stop",
        "category": "8BitScript",
        "icon": "$(debug-stop)"
      },
      {
        "command": "8bitscript.launchStudio",
        "title": "Launch Studio",
        "category": "8BitScript",
        "icon": "$(rocket)"
      },
      {
        "command": "8bitscript.openStudio",
        "title": "Open Studio",
        "category": "8BitScript",
        "icon": "$(tools)"
      },
      {
        "command": "8bitscript.openStudioNative",
        "title": "Open Studio in the Native Emulator",
        "category": "8BitScript",
        "icon": "$(device-desktop)"
      },
      {
        "command": "8bitscript.openStudioX16emu",
        "title": "Open Studio in x16emu (in a Tab)",
        "category": "8BitScript",
        "icon": "$(window)"
      },
      {
        "command": "8bitscript.openStudioTab",
        "title": "Open Studio in a Tab",
        "category": "8BitScript",
        "icon": "$(window)"
      },
      {
        "command": "8bitscript.studioTab.show",
        "title": "Show the Studio Tab",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.previewOn",
        "title": "Preview On…",
        "category": "8BitScript",
        "icon": "$(window)"
      },
      {
        "command": "8bitscript.previewTab.show",
        "title": "Show the Preview Tab",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.launchApp",
        "title": "Launch App…",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.launchExample",
        "title": "Launch Example…",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.doctor",
        "title": "Doctor: Check Toolchains",
        "category": "8BitScript",
        "icon": "$(pulse)"
      },
      {
        "command": "8bitscript.doctorSetup",
        "title": "Doctor: Choose Emulators",
        "category": "8BitScript",
        "icon": "$(checklist)"
      },
      {
        "command": "8bitscript.controllerSetup",
        "title": "Controller Setup",
        "category": "8BitScript",
        "icon": "$(game)"
      },
      {
        "command": "8bitscript.enableLocalExtension",
        "title": "Enable Local Development Extension",
        "category": "8BitScript",
        "icon": "$(link)"
      },
      {
        "command": "8bitscript.useOfficialExtension",
        "title": "Use Official Extension",
        "category": "8BitScript",
        "icon": "$(check)"
      },
      {
        "command": "8bitscript.configureSystem",
        "title": "Configure System",
        "category": "8BitScript",
        "icon": "$(settings-gear)"
      },
      {
        "command": "8bitscript.showProject",
        "title": "Show Project",
        "category": "8BitScript",
        "icon": "$(info)"
      },
      {
        "command": "8bitscript.useLocal",
        "title": "Use Local 8BitScript",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.usePublished",
        "title": "Use Published Packages",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.saveSystem",
        "title": "Save as a System…",
        "category": "8BitScript",
        "icon": "$(save)"
      },
      {
        "command": "8bitscript.toggleExamples",
        "title": "Show or Hide Examples",
        "category": "8BitScript",
        "icon": "$(book)"
      },
      {
        "command": "8bitscript.refresh",
        "title": "Refresh Projects",
        "category": "8BitScript",
        "icon": "$(refresh)"
      },
      {
        "command": "8bitscript.install",
        "title": "Install Dependencies",
        "category": "8BitScript",
        "icon": "$(cloud-download)"
      },
      {
        "command": "8bitscript.selectProject",
        "title": "Select Project (Moved to the Side Bar)",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.selectSystem",
        "title": "Select System (Moved to the Side Bar)",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.selectRegion",
        "title": "Select Region (NTSC or PAL)",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.openEntry",
        "title": "Open Entry File",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.openConfig",
        "title": "Open 8bitscript.config.8bs",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.restartServer",
        "title": "Restart Language Server",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.rebuildExtension",
        "title": "Rebuild Local Extension",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.reloadWindow",
        "title": "Reload Window",
        "category": "8BitScript"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "8bitscript.studioTab.show",
          "when": "false"
        },
        {
          "command": "8bitscript.previewTab.show",
          "when": "false"
        },
        {
          "command": "8bitscript.rebuildExtension",
          "when": "8bitscript.localRebuildNeeded"
        },
        {
          "command": "8bitscript.reloadWindow",
          "when": "8bitscript.localReloadPending"
        },
        {
          "command": "8bitscript.viewGeneratedAssembly",
          "when": "editorLangId == 8bitscript || editorLangId == 8bitextensible || editorLangId == 8bitgraphics || editorLangId == 8bitaudio"
        },
        {
          "command": "8bitscript.viewGeneratedAssemblyFor",
          "when": "editorLangId == 8bitscript || editorLangId == 8bitextensible || editorLangId == 8bitgraphics || editorLangId == 8bitaudio"
        },
        {
          "command": "8bitscript.assemblyView.openForMachine",
          "when": "resourceScheme == 8bitscript-asm"
        },
        {
          "command": "8bitscript.assemblyView.toggleExplain",
          "when": "resourceScheme == 8bitscript-asm"
        },
        {
          "command": "8bitscript.boot",
          "when": "false"
        },
        {
          "command": "8bitscript.selectProject",
          "when": "false"
        },
        {
          "command": "8bitscript.selectSystem",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "8bitscript.viewGeneratedAssembly",
          "when": "editorLangId == 8bitscript || editorLangId == 8bitextensible || editorLangId == 8bitgraphics || editorLangId == 8bitaudio",
          "group": "8bitscript"
        },
        {
          "command": "8bitscript.viewGeneratedAssemblyFor",
          "when": "editorLangId == 8bitscript || editorLangId == 8bitextensible || editorLangId == 8bitgraphics || editorLangId == 8bitaudio",
          "group": "8bitscript"
        }
      ],
      "editor/title": [
        {
          "command": "8bitscript.assemblyView.toggleExplain",
          "when": "resourceScheme == 8bitscript-asm",
          "group": "navigation@0"
        },
        {
          "command": "8bitscript.assemblyView.openForMachine",
          "when": "resourceScheme == 8bitscript-asm",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "8bitscript.toggleExamples",
          "when": "view == 8bitscript.launcher && 8bitscript.hasExamples",
          "group": "navigation@0"
        },
        {
          "command": "8bitscript.launchStudio",
          "when": "view == 8bitscript.launcher",
          "group": "navigation@1"
        },
        {
          "command": "8bitscript.doctor",
          "when": "view == 8bitscript.launcher",
          "group": "navigation@2"
        },
        {
          "command": "8bitscript.refresh",
          "when": "view == 8bitscript.launcher",
          "group": "navigation@3"
        },
        {
          "command": "8bitscript.launchApp",
          "when": "view == 8bitscript.launcher",
          "group": "1_launch@0"
        },
        {
          "command": "8bitscript.launchExample",
          "when": "view == 8bitscript.launcher",
          "group": "1_launch@1"
        },
        {
          "command": "8bitscript.configureSystem",
          "when": "view == 8bitscript.launcher",
          "group": "2_system@0"
        },
        {
          "command": "8bitscript.showProject",
          "when": "view == 8bitscript.launcher",
          "group": "2_system@1"
        },
        {
          "command": "8bitscript.saveSystem",
          "when": "view == 8bitscript.launcher",
          "group": "2_system@2"
        },
        {
          "command": "8bitscript.doctorSetup",
          "when": "view == 8bitscript.launcher",
          "group": "2_system@3"
        },
        {
          "command": "8bitscript.controllerSetup",
          "when": "view == 8bitscript.launcher",
          "group": "2_system@4"
        },
        {
          "command": "8bitscript.enableLocalExtension",
          "when": "view == 8bitscript.launcher && !8bitscript.usingLocalExtension",
          "group": "2_system@5"
        },
        {
          "command": "8bitscript.useOfficialExtension",
          "when": "view == 8bitscript.launcher && 8bitscript.usingLocalExtension",
          "group": "2_system@5"
        }
      ]
    },
    "configuration": {
      "title": "8BitScript",
      "properties": {
        "8bitscript.region": {
          "type": "string",
          "enum": [
            "ntsc",
            "pal"
          ],
          "enumDescriptions": [
            "NTSC (US/Japan), 60Hz — the machine model 8bs run and 8bs build use by default.",
            "PAL (Europe), 50Hz — passes --pal to 8bs run and 8bs build."
          ],
          "default": "ntsc",
          "description": "The machine region the launcher runs with: NTSC (US/Japan) or PAL (Europe). Passed as --pal for the machines that have a region (the CLI says which), ignored for the ones that do not. Chosen in Configure System, or with 8BitScript: Select Region."
        },
        "8bitscript.system": {
          "type": "string",
          "default": "pet",
          "description": "The machine the launcher uses when no named system is selected: any machine id `8bs targets` lists (pet, c64, vic20, cx16, web …). Chosen with the System selector in the 8BitScript side bar. Named systems live in 8bitscript.namedSystem."
        },
        "8bitscript.program": {
          "type": "object",
          "default": {},
          "description": "Which program Run and Build act on in a project with several `programs` in its config: an object keyed by the project's directory, each value a program name (`8bs run --program`). A project with a `main` program, or only one, needs no entry here; the launcher's program list writes it.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "8bitscript.namedSystem": {
          "type": "string",
          "default": "",
          "description": "The named system the launcher's Run and Build buttons use (`8bs run --system`). Empty means a bare machine id from 8bitscript.system. Named systems come from 8bitscript.config.8bs, .8bitscript/systems.json, or ~/.config/8bitscript/systems.json."
        },
        "8bitscript.doctorEmulators": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "default": null,
          "description": "Emulators 8BitScript: Doctor installs. null (the default) is all of them. An empty array is host tools only. Set from Doctor: Choose Emulators."
        },
        "8bitscript.checkout": {
          "type": "string",
          "default": "",
          "description": "Absolute path of a local 8BitScript monorepo to run instead of the published @8bitscript/* packages in node_modules. Empty means published. The same path is written to .8bitscript/toolchain.json so a terminal in that clone sees it too. Does not rewrite package.json."
        },
        "8bitscript.project": {
          "type": "string",
          "default": "",
          "description": "The project the launcher's Run and Build buttons act on, as an absolute directory. Empty means the first project the workspace offers. Set from the Project dropdown in the 8BitScript side bar."
        },
        "8bitscript.examplesPath": {
          "type": "string",
          "default": "",
          "description": "A directory of your own examples to list in the launcher's Project dropdown, instead of the ones that ship with the toolchain (@8bitscript/examples). Each subdirectory with an 8bitscript.config.8bs (or an older .ts name) is one."
        },
        "8bitscript.hardware": {
          "type": "object",
          "default": {},
          "description": "The hardware fitted to each machine when a bare machine (not a named system) is launched: an object keyed by machine, each `{ profile, options }`. Set in Configure System; `8bs targets` lists what each machine can be fitted with.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "profile": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "options": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        },
        "8bitscript.showExamples": {
          "type": "boolean",
          "default": true,
          "description": "List the examples that ship with the toolchain (@8bitscript/examples, installed with @8bitscript/cli) in the launcher's Project dropdown, in a group of their own under the workspace's projects and beside the toolchain's apps. On by default. Toggled with the book icon in the 8BitScript side bar's title bar, which is only offered when there are examples to show. Launch Example… reaches them either way."
        },
        "8bitscript.preferWebPreview": {
          "type": "boolean",
          "default": true,
          "description": "Deprecated: the launcher remembers the runtime (Editor, Browser or Native) per program. This only decides the first run of a program with no history: on (the default) is Editor, off is Native. A machine with no WebAssembly build always starts Native. Open Studio does not consult it: Studio always opens in an editor tab on the WebAssembly build.",
          "deprecationMessage": "The launcher remembers the runtime per program. This setting now only picks the first run's default.",
          "markdownDeprecationMessage": "The launcher remembers the runtime per program. This setting now only picks the first run's default."
        },
        "8bitscript.assemblyView.explain": {
          "type": "boolean",
          "default": true,
          "description": "In View Generated Assembly, comment every instruction in plain English beside the 6502 — `LDA #$06  ; A = 6`, `JSR $0668  ; call screen_blank`, `BEQ $043C  ; if zero, loop back to $043C` — naming your globals and functions in place of bare addresses. On by default. Toggled with the comment icon in an assembly tab's title bar; the source-line comments above each run of instructions stay either way."
        },
        "8bitscript.webLan": {
          "type": "boolean",
          "default": true,
          "description": "When running the web target, listen on the LAN so a phone on the same Wi-Fi can open the printed HTTPS URL. On by default (`8bs run web`). The launcher shows a QR of that URL. Turn this off to pass --local (loopback only) on an untrusted network."
        },
        "8bitscript.cx16.captureMouse": {
          "type": "boolean",
          "default": true,
          "description": "When Run or Boot launches the Commander X16 in a native x16emu window, pass --capture-mouse so the emulator grabs the mouse at start (x16emu's -capture). Off passes --no-capture-mouse and leaves the pointer free to leave the window; ⇧⌘M (Ctrl+M on Linux/Windows) still toggles grab. Does not apply to the editor tab (`8bs run cx16 --web`), which is where Open Studio runs by default."
        },
        "8bitscript.cx16.fullscreen": {
          "type": "boolean",
          "default": false,
          "description": "When Run or Boot launches the Commander X16 in a native x16emu window, pass --fullscreen so x16emu starts maximized. Off leaves a normal window. Open Studio in the Native Emulator is always fullscreen regardless. Does not apply to the editor tab (`8bs run cx16 --web`), which is where Open Studio runs by default."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "8bs",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "run",
              "build",
              "boot",
              "doctor",
              "install"
            ],
            "description": "The 8bs subcommand to run. `boot` opens the machine's emulator with nothing loaded."
          },
          "project": {
            "type": "string",
            "description": "The project directory, relative to the workspace folder. Defaults to the workspace folder itself."
          },
          "target": {
            "type": "string",
            "description": "The system to build for or run on: any machine id `8bs targets` lists (pet, c64, vic20, cx16, web …). Required for run, build and boot."
          },
          "system": {
            "type": "string",
            "description": "Run a named system from the project's `systems` instead of a bare machine (`8bs run --system`). It supplies the target, hardware and region."
          },
          "program": {
            "type": "string",
            "description": "Which of the project's several `programs` to run or build (`8bs run --program`). Optional: without it the program chosen in the launcher is used, or `main`."
          },
          "runtime": {
            "type": "string",
            "enum": [
              "editor",
              "browser",
              "native"
            ],
            "enumDescriptions": [
              "Serve the WebAssembly page on loopback (`8bs run <target> --web --no-open`) and print its URL; the launcher's Editor run also shows it in a tab.",
              "Open the WebAssembly page in the system browser (`8bs run <target> --web`).",
              "The machine's own emulator (`8bs run <target>`). The default."
            ],
            "description": "Where a run goes. Without it the run is native (the synthetic `web` target is a browser page)."
          },
          "define": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "description": "The program's inputs for this run, `NAME: value` (`8bs run --define NAME=value`). A name the program does not read is an error."
          },
          "locale": {
            "type": "string",
            "description": "The language to build the messages in (`8bs run --locale`)."
          },
          "profile": {
            "type": "string",
            "description": "A hardware profile for the target (`8bs run --profile`)."
          },
          "hardware": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Hardware options for the target, `option: value` (`8bs run --hardware option=value,…`)."
          },
          "pal": {
            "type": "boolean",
            "description": "Use the PAL (50Hz) machine model instead of NTSC. Ignored for web."
          },
          "web": {
            "type": "boolean",
            "description": "Shorthand for `\"runtime\": \"browser\"`: run the WebAssembly page in the system browser (`8bs run <target> --web`)."
          }
        }
      }
    ]
  },
  "main": "./bootstrap.cjs",
  "activationEvents": [
    "workspaceContains:**/*.8bs",
    "workspaceContains:**/*.8bx",
    "workspaceContains:**/*.8bg",
    "workspaceContains:**/*.8ba",
    "workspaceContains:**/8bitscript.config.8bs",
    "workspaceContains:**/8bitscript.config.ts",
    "workspaceContains:**/8bs.config.ts"
  ],
  "scripts": {
    "test": "node --test",
    "icons": "node scripts/build-icons.cjs",
    "bundle": "node scripts/build-icons.cjs && esbuild src/extension.cjs --bundle --minify --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs && node scripts/post-bundle.cjs",
    "link-local": "node scripts/link-local.cjs",
    "package": "pnpm run bundle && vsce package --out dist/8bitscript-lang.vsix",
    "vscode:prepublish": "pnpm run bundle"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1",
    "esbuild": "0.28.1",
    "linkedom": "^0.18.13",
    "ovsx": "^0.10.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "files": [
    "bootstrap.cjs",
    "dist",
    "media",
    "syntaxes",
    "snippets",
    "icons",
    "themes",
    "language-configuration.json",
    "language-configuration.asm.json",
    "README.md",
    "LICENSE"
  ]
}

{
  "name": "8bitscript-lang",
  "displayName": "8BitScript",
  "description": "Syntax highlighting, language server, and a project runner for 8BitScript (.8bs) source files.",
  "version": "0.0.0",
  "publisher": "8bitscript",
  "license": "MIT",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "contributes": {
    "languages": [
      {
        "id": "8bitscript",
        "aliases": [
          "8BitScript",
          "8bs"
        ],
        "extensions": [
          ".8bs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "8bitscript",
        "scopeName": "source.8bs",
        "path": "./syntaxes/8bs.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "8bitscript",
          "title": "8BitScript",
          "icon": "media/8bitscript.svg"
        }
      ]
    },
    "views": {
      "8bitscript": [
        {
          "id": "8bitscript.controls",
          "name": "Run Settings",
          "type": "webview",
          "icon": "media/8bitscript.svg",
          "contextualTitle": "8BitScript run settings",
          "visibility": "visible",
          "initialSize": 1
        },
        {
          "id": "8bitscript.projects",
          "name": "Projects",
          "icon": "media/8bitscript.svg",
          "contextualTitle": "8BitScript projects",
          "visibility": "visible",
          "initialSize": 4
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "8bitscript.projects",
        "contents": "No 8BitScript projects found.\n\nA project is a directory with an `8bs.config.ts` in it; every one in this workspace is listed here with a Run and Build button for each system it targets.\n\n[Refresh](command:8bitscript.projects.refresh)",
        "when": "!8bitscript.hasProjects"
      }
    ],
    "commands": [
      {
        "command": "8bitscript.restartServer",
        "title": "Restart Language Server",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.projects.refresh",
        "title": "Refresh Projects",
        "category": "8BitScript",
        "icon": "$(refresh)"
      },
      {
        "command": "8bitscript.projects.viewMode",
        "title": "Change Projects View",
        "category": "8BitScript",
        "icon": "$(list-tree)"
      },
      {
        "command": "8bitscript.selectSystem",
        "title": "Select System",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.selectRegion",
        "title": "Select Region (NTSC/PAL)",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.toggleExamples",
        "title": "Show or Hide Example Projects",
        "category": "8BitScript",
        "icon": "$(book)"
      },
      {
        "command": "8bitscript.doctor",
        "title": "Doctor: Check Toolchains",
        "category": "8BitScript",
        "icon": "$(pulse)"
      },
      {
        "command": "8bitscript.run",
        "title": "Run",
        "category": "8BitScript",
        "icon": "$(play)"
      },
      {
        "command": "8bitscript.build",
        "title": "Build",
        "category": "8BitScript",
        "icon": "$(tools)"
      },
      {
        "command": "8bitscript.runNtsc",
        "title": "Run (NTSC)",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.buildNtsc",
        "title": "Build (NTSC)",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.runPal",
        "title": "Run (PAL)",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.buildPal",
        "title": "Build (PAL)",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.stop",
        "title": "Stop",
        "category": "8BitScript",
        "icon": "$(debug-stop)"
      },
      {
        "command": "8bitscript.openConfig",
        "title": "Open 8bs.config.ts",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.revealProject",
        "title": "Reveal in Explorer",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.openTerminal",
        "title": "Open in Integrated Terminal",
        "category": "8BitScript"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "8bitscript.runNtsc",
          "when": "false"
        },
        {
          "command": "8bitscript.buildNtsc",
          "when": "false"
        },
        {
          "command": "8bitscript.runPal",
          "when": "false"
        },
        {
          "command": "8bitscript.buildPal",
          "when": "false"
        },
        {
          "command": "8bitscript.openConfig",
          "when": "false"
        },
        {
          "command": "8bitscript.revealProject",
          "when": "false"
        },
        {
          "command": "8bitscript.openTerminal",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "8bitscript.projects.viewMode",
          "when": "view == 8bitscript.projects",
          "group": "navigation@0"
        },
        {
          "command": "8bitscript.toggleExamples",
          "when": "view == 8bitscript.projects && 8bitscript.hasExamples",
          "group": "navigation@1"
        },
        {
          "command": "8bitscript.doctor",
          "when": "view == 8bitscript.projects",
          "group": "navigation@2"
        },
        {
          "command": "8bitscript.projects.refresh",
          "when": "view == 8bitscript.projects",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "8bitscript.stop",
          "when": "view == 8bitscript.projects && viewItem =~ /running/",
          "group": "inline@0"
        },
        {
          "command": "8bitscript.run",
          "when": "view == 8bitscript.projects && (viewItem =~ /^target/ || viewItem =~ /^project/)",
          "group": "inline@1"
        },
        {
          "command": "8bitscript.build",
          "when": "view == 8bitscript.projects && (viewItem =~ /^target/ || viewItem =~ /pinned/)",
          "group": "inline@2"
        },
        {
          "command": "8bitscript.runNtsc",
          "when": "view == 8bitscript.projects && viewItem =~ /machine/ && !(viewItem =~ /^system/)",
          "group": "1_run@1"
        },
        {
          "command": "8bitscript.runPal",
          "when": "view == 8bitscript.projects && viewItem =~ /machine/ && !(viewItem =~ /^system/)",
          "group": "1_run@2"
        },
        {
          "command": "8bitscript.buildNtsc",
          "when": "view == 8bitscript.projects && viewItem =~ /machine/ && !(viewItem =~ /^system/)",
          "group": "1_run@3"
        },
        {
          "command": "8bitscript.buildPal",
          "when": "view == 8bitscript.projects && viewItem =~ /machine/ && !(viewItem =~ /^system/)",
          "group": "1_run@4"
        },
        {
          "command": "8bitscript.run",
          "when": "view == 8bitscript.projects && (viewItem =~ /^target/ || viewItem =~ /^project/) && !(viewItem =~ /machine/)",
          "group": "1_run@1"
        },
        {
          "command": "8bitscript.build",
          "when": "view == 8bitscript.projects && (viewItem =~ /^target/ || viewItem =~ /^project/) && !(viewItem =~ /machine/)",
          "group": "1_run@2"
        },
        {
          "command": "8bitscript.stop",
          "when": "view == 8bitscript.projects && viewItem =~ /running/",
          "group": "1_run@9"
        },
        {
          "command": "8bitscript.openConfig",
          "when": "view == 8bitscript.projects && viewItem =~ /^project/",
          "group": "2_open@1"
        },
        {
          "command": "8bitscript.revealProject",
          "when": "view == 8bitscript.projects && viewItem =~ /^project/ && !(viewItem =~ /example/)",
          "group": "2_open@2"
        },
        {
          "command": "8bitscript.openTerminal",
          "when": "view == 8bitscript.projects && viewItem =~ /^project/",
          "group": "2_open@3"
        }
      ]
    },
    "configuration": {
      "title": "8BitScript",
      "properties": {
        "8bitscript.region": {
          "type": "string",
          "enum": [
            "ntsc",
            "pal"
          ],
          "enumDescriptions": [
            "NTSC, 60Hz — the machine model 8bs run and 8bs build use by default.",
            "PAL, 50Hz — passes --pal to 8bs run and 8bs build."
          ],
          "default": "ntsc",
          "description": "The machine region the Run and Build buttons use for vic20 and c64. Set from the Region dropdown in the 8BitScript side bar; either region is always available from a row's context menu."
        },
        "8bitscript.system": {
          "type": "string",
          "enum": [
            "vic20",
            "c64",
            "web"
          ],
          "default": "vic20",
          "description": "The system the Run and Build buttons use, and the one the \"runnable\" projects view lists. Set from the System dropdown in the 8BitScript side bar."
        },
        "8bitscript.projectsView": {
          "type": "string",
          "enum": [
            "runnable",
            "byProject",
            "bySystem"
          ],
          "enumDescriptions": [
            "Only the projects that can run on the selected system, one row each.",
            "Every project, expanded into the systems it targets.",
            "Every system, expanded into the projects that target it."
          ],
          "default": "runnable",
          "description": "How the Projects view lays out the list. Set from the View dropdown in the 8BitScript side bar."
        },
        "8bitscript.showExamples": {
          "type": "boolean",
          "default": false,
          "description": "List the example projects that ship with the 8BitScript toolchain alongside the workspace's own projects. Only offered when the toolchain in use comes from a checkout of the 8bitscript repository, which is where the examples live."
        },
        "8bitscript.examplesPath": {
          "type": "string",
          "default": "",
          "description": "A directory of example projects to list when \"Show example projects\" is on, instead of the one found beside the toolchain. Each subdirectory with an 8bs.config.ts is an example."
        },
        "8bitscript.llvmMosHome": {
          "type": "string",
          "default": "",
          "description": "The LLVM-MOS SDK directory (the one containing bin/), passed to every 8bs task as LLVM_MOS_HOME. Leave empty to use the LLVM_MOS_HOME the editor was started with, or failing that the documented install location, ~/.local/opt/llvm-mos. Set this when 8bs doctor from the side bar says LLVM_MOS_HOME is not set but your terminal has it: a task’s shell does not read ~/.zshrc."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "8bs",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "run",
              "build",
              "doctor"
            ],
            "description": "The 8bs subcommand to run."
          },
          "project": {
            "type": "string",
            "description": "The project directory, relative to the workspace folder. Defaults to the workspace folder itself."
          },
          "target": {
            "type": "string",
            "enum": [
              "vic20",
              "c64",
              "web"
            ],
            "description": "The system to build for or run on. Required for run and build."
          },
          "pal": {
            "type": "boolean",
            "description": "Use the PAL (50Hz) machine model instead of NTSC. Ignored for web."
          }
        }
      }
    ]
  },
  "main": "./src/extension.cjs",
  "activationEvents": [
    "onLanguage:8bitscript",
    "workspaceContains:**/*.8bs",
    "workspaceContains:**/8bs.config.ts"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.1"
  },
  "files": [
    "src",
    "media",
    "syntaxes",
    "language-configuration.json",
    "README.md"
  ]
}

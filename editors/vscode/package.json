{
  "name": "8bitscript-lang",
  "displayName": "8BitScript",
  "description": "Syntax highlighting, language server, and a project runner for 8BitScript (.8bs) source files.",
  "icon": "media/8bitscript-icon.png",
  "version": "0.22.0",
  "private": true,
  "publisher": "8bitscript",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/8BitScript/8bitscript.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://8bitscript.org/",
  "bugs": {
    "url": "https://github.com/8BitScript/8bitscript/issues"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "contributes": {
    "languages": [
      {
        "id": "8bitscript",
        "aliases": [
          "8BitScript",
          "8bs"
        ],
        "extensions": [
          ".8bs"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "8bitextensible",
        "aliases": [
          "8BitX",
          "8bx"
        ],
        "extensions": [
          ".8bx"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "8bitscript-asm",
        "aliases": [
          "8BitScript Generated Assembly"
        ],
        "configuration": "./language-configuration.asm.json"
      }
    ],
    "grammars": [
      {
        "language": "8bitscript",
        "scopeName": "source.8bs",
        "path": "./syntaxes/8bs.tmLanguage.json"
      },
      {
        "language": "8bitextensible",
        "scopeName": "source.8bx",
        "path": "./syntaxes/8bx.tmLanguage.json"
      },
      {
        "language": "8bitscript-asm",
        "scopeName": "source.asm-8bs",
        "path": "./syntaxes/asm-8bs.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "8bitscript",
        "path": "./snippets/8bs.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "8bitscript",
          "title": "8BitScript",
          "icon": "media/8bitscript-logo.svg"
        }
      ]
    },
    "views": {
      "8bitscript": [
        {
          "id": "8bitscript.launcher",
          "name": "8BitScript",
          "type": "webview",
          "icon": "media/8bitscript-logo.svg",
          "contextualTitle": "8BitScript",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "8bitscript.run",
        "title": "Run",
        "category": "8BitScript",
        "icon": "$(play)"
      },
      {
        "command": "8bitscript.build",
        "title": "Build",
        "category": "8BitScript",
        "icon": "$(tools)"
      },
      {
        "command": "8bitscript.boot",
        "title": "Boot (no program loaded)",
        "category": "8BitScript",
        "icon": "$(chip)"
      },
      {
        "command": "8bitscript.viewGeneratedAssembly",
        "title": "View Generated Assembly",
        "category": "8BitScript",
        "icon": "$(file-binary)"
      },
      {
        "command": "8bitscript.viewGeneratedAssemblyFor",
        "title": "View Generated Assembly For…",
        "category": "8BitScript",
        "icon": "$(file-binary)"
      },
      {
        "command": "8bitscript.assemblyView.openForMachine",
        "title": "Open For Another Machine…",
        "category": "8BitScript",
        "icon": "$(target)"
      },
      {
        "command": "8bitscript.assemblyView.toggleExplain",
        "title": "Toggle Plain-English Comments",
        "category": "8BitScript",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "8bitscript.stop",
        "title": "Stop",
        "category": "8BitScript",
        "icon": "$(debug-stop)"
      },
      {
        "command": "8bitscript.launchStudio",
        "title": "Launch Studio",
        "category": "8BitScript",
        "icon": "$(rocket)"
      },
      {
        "command": "8bitscript.openStudio",
        "title": "Open Studio",
        "category": "8BitScript",
        "icon": "$(tools)"
      },
      {
        "command": "8bitscript.openStudioTab",
        "title": "Open Studio in a Tab",
        "category": "8BitScript",
        "icon": "$(window)"
      },
      {
        "command": "8bitscript.studioTab.show",
        "title": "Show the Studio Tab",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.launchApp",
        "title": "Launch App…",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.launchExample",
        "title": "Launch Example…",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.doctor",
        "title": "Doctor: Check Toolchains",
        "category": "8BitScript",
        "icon": "$(pulse)"
      },
      {
        "command": "8bitscript.controllerSetup",
        "title": "Controller Setup",
        "category": "8BitScript",
        "icon": "$(game)"
      },
      {
        "command": "8bitscript.enableLocalExtension",
        "title": "Enable Local Development Extension",
        "category": "8BitScript",
        "icon": "$(link)"
      },
      {
        "command": "8bitscript.useOfficialExtension",
        "title": "Use Official Extension",
        "category": "8BitScript",
        "icon": "$(check)"
      },
      {
        "command": "8bitscript.configureSystem",
        "title": "Configure System",
        "category": "8BitScript",
        "icon": "$(settings-gear)"
      },
      {
        "command": "8bitscript.showProject",
        "title": "Show Project",
        "category": "8BitScript",
        "icon": "$(info)"
      },
      {
        "command": "8bitscript.useLocal",
        "title": "Use Local 8BitScript",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.usePublished",
        "title": "Use Published Packages",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.saveSystem",
        "title": "Save as a System…",
        "category": "8BitScript",
        "icon": "$(save)"
      },
      {
        "command": "8bitscript.toggleExamples",
        "title": "Show or Hide Examples",
        "category": "8BitScript",
        "icon": "$(book)"
      },
      {
        "command": "8bitscript.refresh",
        "title": "Refresh Projects",
        "category": "8BitScript",
        "icon": "$(refresh)"
      },
      {
        "command": "8bitscript.install",
        "title": "Install Dependencies",
        "category": "8BitScript",
        "icon": "$(cloud-download)"
      },
      {
        "command": "8bitscript.selectProject",
        "title": "Select Project",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.selectSystem",
        "title": "Select System",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.selectRegion",
        "title": "Select Region (NTSC — US/Japan, PAL — Europe)",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.openEntry",
        "title": "Open Entry File",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.openConfig",
        "title": "Open 8bitscript.config.ts",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.restartServer",
        "title": "Restart Language Server",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.rebuildExtension",
        "title": "Rebuild Local Extension",
        "category": "8BitScript"
      },
      {
        "command": "8bitscript.reloadWindow",
        "title": "Reload Window",
        "category": "8BitScript"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "8bitscript.studioTab.show",
          "when": "false"
        },
        {
          "command": "8bitscript.rebuildExtension",
          "when": "8bitscript.localRebuildNeeded"
        },
        {
          "command": "8bitscript.reloadWindow",
          "when": "8bitscript.localReloadPending"
        },
        {
          "command": "8bitscript.viewGeneratedAssembly",
          "when": "editorLangId == 8bitscript || editorLangId == 8bitextensible"
        },
        {
          "command": "8bitscript.viewGeneratedAssemblyFor",
          "when": "editorLangId == 8bitscript || editorLangId == 8bitextensible"
        },
        {
          "command": "8bitscript.assemblyView.openForMachine",
          "when": "resourceScheme == 8bitscript-asm"
        },
        {
          "command": "8bitscript.assemblyView.toggleExplain",
          "when": "resourceScheme == 8bitscript-asm"
        }
      ],
      "editor/context": [
        {
          "command": "8bitscript.viewGeneratedAssembly",
          "when": "editorLangId == 8bitscript || editorLangId == 8bitextensible",
          "group": "8bitscript"
        },
        {
          "command": "8bitscript.viewGeneratedAssemblyFor",
          "when": "editorLangId == 8bitscript || editorLangId == 8bitextensible",
          "group": "8bitscript"
        }
      ],
      "editor/title": [
        {
          "command": "8bitscript.assemblyView.toggleExplain",
          "when": "resourceScheme == 8bitscript-asm",
          "group": "navigation@0"
        },
        {
          "command": "8bitscript.assemblyView.openForMachine",
          "when": "resourceScheme == 8bitscript-asm",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "8bitscript.toggleExamples",
          "when": "view == 8bitscript.launcher && 8bitscript.hasExamples",
          "group": "navigation@0"
        },
        {
          "command": "8bitscript.launchStudio",
          "when": "view == 8bitscript.launcher",
          "group": "navigation@1"
        },
        {
          "command": "8bitscript.doctor",
          "when": "view == 8bitscript.launcher",
          "group": "navigation@2"
        },
        {
          "command": "8bitscript.refresh",
          "when": "view == 8bitscript.launcher",
          "group": "navigation@3"
        },
        {
          "command": "8bitscript.launchApp",
          "when": "view == 8bitscript.launcher",
          "group": "1_launch@0"
        },
        {
          "command": "8bitscript.launchExample",
          "when": "view == 8bitscript.launcher",
          "group": "1_launch@1"
        },
        {
          "command": "8bitscript.configureSystem",
          "when": "view == 8bitscript.launcher",
          "group": "2_system@0"
        },
        {
          "command": "8bitscript.showProject",
          "when": "view == 8bitscript.launcher",
          "group": "2_system@1"
        },
        {
          "command": "8bitscript.saveSystem",
          "when": "view == 8bitscript.launcher",
          "group": "2_system@2"
        },
        {
          "command": "8bitscript.controllerSetup",
          "when": "view == 8bitscript.launcher",
          "group": "2_system@3"
        },
        {
          "command": "8bitscript.enableLocalExtension",
          "when": "view == 8bitscript.launcher && !8bitscript.usingLocalExtension",
          "group": "2_system@4"
        },
        {
          "command": "8bitscript.useOfficialExtension",
          "when": "view == 8bitscript.launcher && 8bitscript.usingLocalExtension",
          "group": "2_system@4"
        }
      ]
    },
    "configuration": {
      "title": "8BitScript",
      "properties": {
        "8bitscript.region": {
          "type": "string",
          "enum": [
            "ntsc",
            "pal"
          ],
          "enumDescriptions": [
            "NTSC (US/Japan), 60Hz — the machine model 8bs run and 8bs build use by default.",
            "PAL (Europe), 50Hz — passes --pal to 8bs run and 8bs build."
          ],
          "default": "ntsc",
          "description": "The machine region the launcher runs with: NTSC (US/Japan) or PAL (Europe). Passed as --pal for the machines that have a region, ignored for the ones that do not. Set from the Region dropdown under Hardware · Region · Facts in the 8BitScript side bar."
        },
        "8bitscript.system": {
          "type": "string",
          "enum": [
            "pet",
            "c64",
            "vic20",
            "c128",
            "cx16",
            "mega65",
            "atari8",
            "nes",
            "web"
          ],
          "default": "pet",
          "description": "The machine the launcher's Run and Build buttons use when no named system is selected. Set from the System dropdown in the 8BitScript side bar, or 8BitScript: Select System. Named systems live in 8bitscript.namedSystem."
        },
        "8bitscript.namedSystem": {
          "type": "string",
          "default": "",
          "description": "The named system the launcher's Run and Build buttons use (`8bs run --system`). Empty means a bare machine id from 8bitscript.system. Named systems come from 8bitscript.config.ts, .8bitscript/systems.json, or ~/.config/8bitscript/systems.json."
        },
        "8bitscript.checkout": {
          "type": "string",
          "default": "",
          "description": "Absolute path of a local 8BitScript monorepo to run instead of the published @8bitscript/* packages in node_modules. Empty means published. The same path is written to .8bitscript/toolchain.json so a terminal in that clone sees it too. Does not rewrite package.json."
        },
        "8bitscript.project": {
          "type": "string",
          "default": "",
          "description": "The project the launcher's Run and Build buttons act on, as an absolute directory. Empty means the first project the workspace offers. Set from the Project dropdown in the 8BitScript side bar."
        },
        "8bitscript.examplesPath": {
          "type": "string",
          "default": "",
          "description": "A directory of your own examples to list in the launcher's Project dropdown, instead of the ones that ship with the toolchain (@8bitscript/examples). Each subdirectory with an 8bitscript.config.ts (or the older 8bs.config.ts) is one."
        },
        "8bitscript.hardware": {
          "type": "object",
          "default": {},
          "description": "The hardware fitted to each machine when a bare machine (not a named system) is launched: an object keyed by machine, each `{ profile, options }`. Set in Configure System; `8bs targets` lists what each machine can be fitted with.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "profile": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "options": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        },
        "8bitscript.showExamples": {
          "type": "boolean",
          "default": true,
          "description": "List the examples that ship with the toolchain (@8bitscript/examples, installed with @8bitscript/cli) in the launcher's Project dropdown, in a group of their own under the workspace's projects and beside the toolchain's apps. On by default. Toggled with the book icon in the 8BitScript side bar's title bar, which is only offered when there are examples to show. Launch Example… reaches them either way."
        },
        "8bitscript.assemblyView.explain": {
          "type": "boolean",
          "default": true,
          "description": "In View Generated Assembly, comment every instruction in plain English beside the 6502 — `LDA #$06  ; A = 6`, `JSR $0668  ; call screen_blank`, `BEQ $043C  ; if zero, loop back to $043C` — naming your globals and functions in place of bare addresses. On by default. Toggled with the comment icon in an assembly tab's title bar; the source-line comments above each run of instructions stay either way."
        },
        "8bitscript.webLan": {
          "type": "boolean",
          "default": true,
          "description": "When running the web target, listen on the LAN so a phone on the same Wi-Fi can open the printed HTTPS URL. On by default (`8bs run web`). The launcher shows a QR of that URL. Turn this off to pass --local (loopback only) on an untrusted network."
        },
        "8bitscript.cx16.captureMouse": {
          "type": "boolean",
          "default": true,
          "description": "When Run or Boot launches the Commander X16 in a native x16emu window, pass --capture-mouse so the emulator grabs the mouse at start (x16emu's -capture). Off passes --no-capture-mouse and leaves the pointer free to leave the window; ⇧⌘M (Ctrl+M on Linux/Windows) still toggles grab. Does not apply to Open Studio in a Tab (`8bs run cx16 --web`)."
        },
        "8bitscript.cx16.fullscreen": {
          "type": "boolean",
          "default": true,
          "description": "When Run or Boot launches the Commander X16 in a native x16emu window, pass --fullscreen so x16emu starts maximized. Off leaves a normal window. Does not apply to Open Studio in a Tab (`8bs run cx16 --web`)."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "8bs",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "run",
              "build",
              "doctor",
              "install"
            ],
            "description": "The 8bs subcommand to run."
          },
          "project": {
            "type": "string",
            "description": "The project directory, relative to the workspace folder. Defaults to the workspace folder itself."
          },
          "target": {
            "type": "string",
            "enum": [
              "pet",
              "c64",
              "vic20",
              "c128",
              "cx16",
              "mega65",
              "atari8",
              "nes",
              "web"
            ],
            "description": "The system to build for or run on. Required for run and build."
          },
          "pal": {
            "type": "boolean",
            "description": "Use the PAL (50Hz) machine model instead of NTSC. Ignored for web."
          },
          "web": {
            "type": "boolean",
            "description": "Run in the machine's WebAssembly emulator, served on loopback for the Studio tab (8bs run cx16 --web --no-open). Commander X16 only."
          }
        }
      }
    ]
  },
  "main": "./bootstrap.cjs",
  "activationEvents": [
    "workspaceContains:**/*.8bs",
    "workspaceContains:**/*.8bx",
    "workspaceContains:**/8bitscript.config.ts",
    "workspaceContains:**/8bs.config.ts"
  ],
  "scripts": {
    "test": "node --test",
    "bundle": "esbuild src/extension.cjs --bundle --minify --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs && node -e \"require('./src/devReload.cjs').copyRuntimeFiles(process.cwd())\"",
    "link-local": "node scripts/link-local.cjs",
    "package": "pnpm run bundle && vsce package --out dist/8bitscript-lang.vsix",
    "vscode:prepublish": "pnpm run bundle"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1",
    "esbuild": "0.28.1",
    "ovsx": "^0.10.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "files": [
    "bootstrap.cjs",
    "dist",
    "media",
    "syntaxes",
    "snippets",
    "language-configuration.json",
    "language-configuration.asm.json",
    "README.md",
    "LICENSE"
  ]
}

{
  "name": "8bitscript",
  "version": "0.0.0",
  "private": true,
  "description": "A statically compiled programming language for classic 8-bit computers and the web.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.1.0",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "scripts": {
    "docs:build": "node site/build.mjs",
    "docs:dev": "node site/build.mjs && wrangler dev",
    "docs:deploy": "node site/build.mjs && wrangler deploy",
    "check": "8bs check",
    "test": "pnpm --recursive --if-present test",
    "doctor": "8bs doctor"
  },
  "devDependencies": {
    "markdown-it": "14.1.0",
    "wrangler": "4.127.1",
    "@8bitscript/cli": "workspace:*"
  }
}

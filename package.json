{
  "name": "8bitscript",
  "version": "0.0.0",
  "private": true,
  "description": "A statically compiled programming language for classic 8-bit computers and the web.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.1.0",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "scripts": {
    "docs:build": "node site/build.mjs && pagefind --site dist/site",
    "docs:dev": "pnpm run docs:build && wrangler dev",
    "docs:deploy": "pnpm run docs:build && wrangler deploy",
    "check": "8bs check",
    "test": "pnpm --recursive --if-present test",
    "doctor": "8bs doctor",
    "examples": "node scripts/launch-example.mjs"
  },
  "devDependencies": {
    "@8bitscript/cli": "workspace:*",
    "highlight.js": "^11.12.0",
    "markdown-it": "14.1.0",
    "pagefind": "^1.5.2",
    "wrangler": "4.127.1"
  }
}

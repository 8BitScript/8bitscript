{
  "name": "8bitscript",
  "version": "0.1.0",
  "private": true,
  "description": "A statically compiled programming language for classic 8-bit computers and the web.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.1.0",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "scripts": {
    "docs:build": "node site/build-all.mjs",
    "docs:dev": "pnpm run docs:build && wrangler dev",
    "docs:deploy": "pnpm run docs:build && wrangler deploy",
    "release": "node scripts/release.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/sync-studio-version.mjs && pnpm install --no-frozen-lockfile",
    "check": "8bs check",
    "test": "pnpm --recursive --if-present test",
    "test:ci": "pnpm --recursive --if-present --filter='!@8bitscript/atari8' --filter='!@8bitscript/c128' --filter='!@8bitscript/c64' --filter='!@8bitscript/cx16' --filter='!@8bitscript/pet' --filter='!@8bitscript/pointer' test",
    "doctor": "8bs doctor",
    "examples": "node scripts/launch-example.mjs"
  },
  "devDependencies": {
    "@8bitscript/cli": "workspace:*",
    "@changesets/cli": "^3.0.2",
    "highlight.js": "^11.12.0",
    "markdown-it": "14.1.0",
    "pagefind": "^1.5.2",
    "wrangler": "4.127.1"
  }
}

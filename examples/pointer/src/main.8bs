// A mouse pointer, on every machine that has anything to draw one with —
// and an honest word on the ones that do not.
//
// This is the program @8bitscript/pointer exists for, and it is also the
// program that proves the capability: every call it offers is here, so a
// target this links for is a target the whole surface compiles on. See
// README.md for what each of the nine makes of it.
//
// The two packages work as a pair. @8bitscript/input says *where* the
// pointer is, in cells, and whether its button just went down;
// @8bitscript/pointer draws the arrow the user aims with. The ordering
// rule is the one input already has, and it is the whole contract:
// **poll() then update(), once each a frame.**
import { screen, BorderColor, BackgroundColor } from "@8bitscript/screen";
import { text, TextColor } from "@8bitscript/text";
import { input } from "@8bitscript/input";
import { pointer } from "@8bitscript/pointer";

const ROW: usmallint = text.COLUMNS;

export function main(): void {
    screen.blank(BorderColor.BLUE, BackgroundColor.BLACK);
    text.setColor(TextColor.WHITE);

    input.begin();
    pointer.begin();
    pointer.setColor(TextColor.WHITE);

    // **The top two rows are left blank on purpose.** A 1351 reads its
    // zero on both axes until it is moved, so the arrow starts in the
    // top-left corner — and packages/pointer/test/pointer.test.mjs proves
    // the arrow is drawn by finding white pixels there and none in the
    // same corner of a build with no mouse fitted. Text in those rows
    // would make that comparison meaningless.
    text.print(ROW + ROW, "POINTER");

    // `pointer.DRAWS` is a compile-time constant on every machine, so only
    // one of these two lines is compiled into any one build and the other
    // costs nothing. It is the machine's answer, not the run's: whether a
    // mouse is really plugged in is `input.pointer()`, every frame.
    if (pointer.DRAWS) {
        text.print(ROW * 3, "MOVE THE MOUSE");
    } else {
        text.print(ROW * 3, "NO ARROW ON THIS MACHINE");
    }

    // Where the pointer is, in cells — the unit @8bitscript/input reports
    // and the unit a component hit-tests against. The arrow moves a pixel
    // at a time; this number moves a cell at a time, and both come from
    // the same reading.
    let clicks: utinyint = 0;

    while (true) {
        waitFrame();
        input.poll();
        pointer.update();

        if (input.pointerButton()) {
            clicks = clicks + 1;
        }
        // RUN/STOP, or whatever this machine's cancel is, takes the arrow
        // off the screen until it moves again.
        if (input.cancel()) {
            pointer.hide();
        }

        let there: utinyint = 0;
        if (input.pointer()) {
            there = 1;
        }
        text.print(ROW * 4, `POINTER ${there:1}`);
        text.print(ROW * 5, `CELL ${input.pointerCell():5}`);
        text.print(ROW * 6, `CLICKS ${clicks:3}`);
    }
}

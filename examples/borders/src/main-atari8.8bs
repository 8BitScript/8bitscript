// examples/borders — Atari 8-bit variant.
//
// @8bitscript/atari8 has no `screen` namespace yet (see its own file
// comment: Atari screen memory floats wherever the OS's display list points
// it, not a fixed address, so this target doesn't reach it safely yet), so
// this variant drops the TICK/OPTION digit readout the shared vic20/c64/
// pet/c128/mega65/web main.8bs draws with `screen`. What it does do is
// exactly what every other target does: cycle `border` and `background`
// together, at the same 2Hz tick, four steps around the cycle — the border
// really is the border here (GTIA's COLBK) and the background really is
// the area behind the characters (COLPF2).
import { border, background, applyColors } from "@8bitscript/machine";

let logicalFramesUntilTick: utinyint = 30;
let ticks: utinyint = 0;
let option: utinyint = 0;

// Four border/background pairs of GTIA bytes: hue in bits 4-7 (16 hues),
// luminance in bits 1-3 (8 levels, bit 0 unused) — hues spread around the
// wheel, borders bright (luminance 6 of 8) against darker backgrounds
// (luminance 2) so the two are always clearly distinguishable. This project
// has not independently verified GTIA's hue-to-colour-name chart against a
// primary source, so these are picked for visible contrast, not for
// matching specific named colours the way @8bitscript/vic20's BorderColor/
// BackgroundColor namespaces do.
function applyOption(): void {
    if (option == 0) {
        border = 0x2C;
        background = 0x84;
    } else if (option == 1) {
        border = 0x6C;
        background = 0xC4;
    } else if (option == 2) {
        border = 0xAC;
        background = 0x04;
    } else {
        border = 0xEC;
        background = 0x44;
    }
}

export function main(): void {
    applyOption();
    applyColors();
}

export function frame(): void {
    logicalFramesUntilTick = logicalFramesUntilTick - 1;
    if (logicalFramesUntilTick == 0) {
        logicalFramesUntilTick = 30;

        ticks = ticks + 1;
        if (ticks % 10 == 0) {
            option = option + 1;
            if (option == 4) {
                option = 0;
            }
            applyOption();
            applyColors();
        }
    }
}

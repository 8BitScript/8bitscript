// examples/borders — NES variant.
//
// Same TICK/OPTION readout and the same cycling border/background as the
// shared vic20/c64/pet/c128/mega65/web main.8bs, on hardware that cannot
// share that file for three reasons, each documented in @8bitscript/nes:
//
//   - The NES has no border register; `border` here colours a two-tile
//     frame @8bitscript/nes draws around the screen edge. That frame owns
//     rows 0-1 and columns 0-1, so the readout cannot sit at cell 0 the
//     way main.8bs's does — it sits at row 2, column 2, the first cell
//     inside the frame: the same "top-left corner, against the border"
//     position every other target's readout has. (NTSC overscan hides row
//     0 on a television and in FCEUX; row 1, the frame's inner row, and
//     row 2 are fully visible.)
//   - Screen codes are ASCII (the font @8bitscript/nes ships is laid out
//     that way: 'A' is 65, '0' is 48, space 32), not Commodore's 1-26.
//   - Screen memory is PPU VRAM behind a port that is only safe to write
//     freely while rendering is off, and only during vertical blank once
//     it is on. applyColors() is what turns rendering on, so everything
//     drawn at setup — the clear, the labels, the two initial digits — goes
//     BEFORE it here, where main.8bs draws its initial digits after. From
//     then on, only frame() writes, and only a digit or two per tick: it
//     runs at the start of vertical blank (packages/backend-6502's
//     FRAME_SYNC.nes), which is exactly when those writes are safe.
//
// What matches every other target is the behaviour: the same 2Hz tick, the
// same four-step colour cycle, the labels and digits on screen, on a 32x30
// grid (960 cells) rather than 40x25 or 40x24.
import { border, background, applyColors, screen } from "@8bitscript/machine";

let logicalFramesUntilTick: utinyint = 30;
let ticks: utinyint = 0;
let option: utinyint = 0;

// Loop index for clearScreen() below — a global, not a local, since there
// are no local variables in the compiled subset yet.
let clearCell: usmallint = 0;

// Nametable/attribute contents are undefined at power-on on real hardware
// (FCEUX happens to zero them), so this is not optional here the way it is
// on the Commodore machines. Rendering is still off, so 960 port writes
// are fine — see the header.
function clearScreen(): void {
    clearCell = 0;
    while (clearCell < screen.CellCount) {
        screen.putChar(clearCell, 32); // 32 = space
        clearCell = clearCell + 1;
    }
}

// Row 2 is cells 64-95; column 2 is cell 66. "TICK " then its digit at
// cell 71, "OPTION " then its digit at cell 80.
function drawLabels(): void {
    screen.putChar(66, 84);   // T
    screen.putChar(67, 73);   // I
    screen.putChar(68, 67);   // C
    screen.putChar(69, 75);   // K
    screen.putChar(70, 32);   // space
    screen.putChar(72, 32);   // space
    screen.putChar(73, 79);   // O
    screen.putChar(74, 80);   // P
    screen.putChar(75, 84);   // T
    screen.putChar(76, 73);   // I
    screen.putChar(77, 79);   // O
    screen.putChar(78, 78);   // N
    screen.putChar(79, 32);   // space
}

// Four border/background pairs of 2C02 palette indices ($00-$3F): a bright
// row-$2x hue for the frame against a dark row-$0x one for the backdrop,
// so the two always read as distinct and the white ($30) text stays legible
// on the backdrop. Picked for visible contrast — this project has not
// verified the 2C02's hue-to-colour-name chart against a primary source,
// so these are not named colours the way @8bitscript/vic20's BorderColor/
// BackgroundColor namespaces are.
function applyOption(): void {
    if (option == 0) {
        border = 0x2C;
        background = 0x01;
    } else if (option == 1) {
        border = 0x27;
        background = 0x06;
    } else if (option == 2) {
        border = 0x2A;
        background = 0x0F;
    } else {
        border = 0x24;
        background = 0x03;
    }
}

export function main(): void {
    clearScreen();
    drawLabels();
    screen.showDigit(71, 0);
    screen.showDigit(80, 0);
    applyOption();
    applyColors(); // lays the frame, sets the palette, turns rendering on
}

export function frame(): void {
    logicalFramesUntilTick = logicalFramesUntilTick - 1;
    if (logicalFramesUntilTick == 0) {
        logicalFramesUntilTick = 30;

        ticks = ticks + 1;
        screen.showDigit(71, ticks % 10);

        if (ticks % 10 == 0) {
            option = option + 1;
            if (option == 4) {
                option = 0;
            }
            applyOption();
            applyColors();
            screen.showDigit(80, option);
        }
    }
}

// The web version of examples/border. Same colours, same @8bitscript/machine
// import, different shape: main.8bs's `while (true)` plus a busy-wait delay
// counter assumes the program owns the machine forever, which is true on a
// VIC-20 or a C64 and false in a browser tab, where something is always
// waiting for control back — see docs/learn/step1-main-loop.md.
//
// So here `main()` only sets up, once, and `frame()` is the per-frame
// callback the host calls back into on every logical tick of its own
// requestAnimationFrame loop (packages/cli/src/web-runtime.mjs). That host
// runs a *fixed* 60Hz logical step regardless of the display's actual
// refresh rate — 60Hz, 120Hz, 144Hz, 50Hz, whatever it is — so counting
// logical frames here, instead of busy-waiting cycles, is what makes "every
// half second" mean the same thing on every screen this runs on. There is no
// web equivalent of `--pal` for exactly that reason: nothing here is tied to
// a machine's real refresh rate to begin with.
import { border, background, applyColors } from "@8bitscript/machine";

let framesUntilStep: utinyint = 30;

export function main(): void {
    background = 1;
    applyColors();
}

export function frame(): void {
    framesUntilStep = framesUntilStep - 1;
    if (framesUntilStep == 0) {
        framesUntilStep = 30;
        // Wraps at 256, which the web palette's 16 colours divide evenly;
        // applyColors() masks it to the colours it actually has.
        border = border + 1;
        applyColors();
    }
}

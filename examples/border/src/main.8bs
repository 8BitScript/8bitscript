// A screen with three things going on: a small tick counter, a curated set
// of colour options the program cycles through, and the border/background
// colours it sets from whichever option is currently picked — the classic
// first sign of life, now with a bit more happening on screen, on whichever
// machine you build for. One file, one program, on the VIC-20, the C64, and
// the web: `main()` sets up once and `frame()` runs once per tick, forever,
// and nothing in this file drives that loop itself.
//
// Every target calls frame() at the same real-world rate — an exact 60Hz
// of real time, not a per-target guess and not whatever the display
// hardware happens to refresh at — but *how* differs entirely below the
// language, which is the point: this file never says which target it's
// building for. On the VIC-20 and C64, the 6502 backend notices this module
// exports both `main` and `frame` and synthesises the driving loop itself:
// it waits for the video chip's raster to reach the top of the screen (real
// vertical blank, not a busy-wait calibrated by hand), and because no
// machine's frame is exactly 1/60s — 59.83Hz on an NTSC C64, 60.29Hz on an
// NTSC VIC-20, ~50Hz on PAL — it drains an exact fixed-point accumulator of
// logical frames owed rather than blindly calling frame() once per blank
// (see packages/backend-6502's FRAME_PACING). On the web, the host's
// requestAnimationFrame loop paces the same fixed 60Hz timestep against
// real elapsed time (packages/cli/src/web-runtime.mjs). All three tick in
// lockstep as a result, indefinitely — none of them drifts. A module
// that only exports `main`, with no `frame`, is unaffected — it keeps
// meaning exactly what it always has (`examples/counter`, `examples/
// step1-main-loop`): the whole program, looping forever on its own.
//
// @8bitscript/machine resolves at build time to the target package for the
// machine being built — @8bitscript/vic20, @8bitscript/c64, or
// @8bitscript/web. All three export the same surface: `border`/
// `background`/`applyColors()` for the colour registers, and
// `screen.putChar()`/`putColor()`/`showDigit()`/`CellCount` for the screen
// — a real character grid on the VIC-20/C64, a virtual one a browser host
// renders as text on the web (see @8bitscript/web's header comment). There
// is no general text API yet (that's `screen.putChar(x, y, code)`/
// `input.*` in docs/roadmap.md, not built — this package's `screen.putChar`
// takes one flat cell index instead), so what this file pokes onto the
// screen — clearing it, the "TICK"/"OPTION" labels, the two digits — is
// entirely this program's own doing, not something the machine packages do
// for it. There is also no keyboard/joystick input at all, so "changing" an
// option here means editing `applyOption` below and rebuilding, not
// pressing a key while it runs.
import { border, background, applyColors, screen } from "@8bitscript/machine";

// 30 calls of frame() at 60Hz is half a second. Every *tick* (not every
// frame() call) advances the ones digit shown at cell 5, and every ten
// ticks the colour option (shown at cell 14) advances too — "TICK" on
// screen, not "FRAME": a real frame counter would advance 60 times a
// second, and this deliberately advances at about 2Hz instead, the same
// real-world rate on every target.
let logicalFramesUntilTick: utinyint = 30;
let ticks: utinyint = 0;
let option: utinyint = 0;

// Loop index for clearScreen() below — a global, not a local, since there
// are no local variables in the compiled subset yet.
let clearCell: usmallint = 0;

// Blanking the screen is this program's own choice, not something
// screen.showDigit or applyColors does automatically: on real hardware the
// VIC-20/C64 boot into BASIC and leave its banner and "READY." on screen,
// and a program that never touches the rest of screen memory leaves it
// there, mixed in with whatever it draws. Other programs that want that
// text left alone just don't call this.
function clearScreen(): void {
    clearCell = 0;
    while (clearCell < screen.CellCount) {
        screen.putChar(clearCell, 32); // 32 = space, in every VIC/C64 charset
        clearCell = clearCell + 1;
    }
}

// The row-0 labels this program draws once, so the two digits below mean
// something without a general text API to lean on: "TICK " then its digit
// at cell 5, "OPTION " then its digit at cell 14. Screen codes 1-26 are
// 'A'-'Z' in every VIC/C64 charset — not their ASCII values, unlike the
// digits and the space above, which is why this is spelled out letter by
// letter instead of reusing a text literal.
function drawLabels(): void {
    screen.putChar(0, 20);  // T
    screen.putColor(0, 1);
    screen.putChar(1, 9);   // I
    screen.putColor(1, 1);
    screen.putChar(2, 3);   // C
    screen.putColor(2, 1);
    screen.putChar(3, 11);  // K
    screen.putColor(3, 1);
    screen.putChar(4, 32);  // space
    screen.putChar(6, 32);  // space
    screen.putChar(7, 15);  // O
    screen.putColor(7, 1);
    screen.putChar(8, 16);  // P
    screen.putColor(8, 1);
    screen.putChar(9, 20);  // T
    screen.putColor(9, 1);
    screen.putChar(10, 9);  // I
    screen.putColor(10, 1);
    screen.putChar(11, 15); // O
    screen.putColor(11, 1);
    screen.putChar(12, 14); // N
    screen.putColor(12, 1);
    screen.putChar(13, 32); // space
}

// Four curated border/background pairs instead of cycling raw values 0-255
// — values kept at 7 or under for border, since the VIC-20's border
// register only has 3 bits either way. This is the "which colours are
// displayed" choice: add a case, bump the wrap check in frame() below from
// 4, and rebuild. None of the four backgrounds is white(1) or yellow(7):
// screen.showDigit()/drawLabels() always draw in white(1), and white text
// is invisible against a white background, barely readable against yellow.
function applyOption(): void {
    if (option == 0) {
        border = 6;      // blue
        background = 3;  // cyan
    } else if (option == 1) {
        border = 2;      // red
        background = 4;  // purple
    } else if (option == 2) {
        border = 5;      // green
        background = 0;  // black
    } else {
        border = 4;      // purple
        background = 2;  // red
    }
}

export function main(): void {
    clearScreen();
    drawLabels();
    applyOption();
    applyColors();
    screen.showDigit(5, 0);
    screen.showDigit(14, 0);
}

export function frame(): void {
    logicalFramesUntilTick = logicalFramesUntilTick - 1;
    if (logicalFramesUntilTick == 0) {
        logicalFramesUntilTick = 30;

        ticks = ticks + 1;
        screen.showDigit(5, ticks % 10);

        if (ticks % 10 == 0) {
            option = option + 1;
            if (option == 4) {
                option = 0;
            }
            applyOption();
            applyColors();
            screen.showDigit(14, option);
        }
    }
}

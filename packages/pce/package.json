{
  "name": "@8bitscript/pce",
  "version": "0.22.1",
  "description": "PC Engine / TurboGrafx-16 target support for 8BitScript: the hardware underneath the portable APIs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/8BitScript/8bitscript.git",
    "directory": "packages/pce"
  },
  "8bitscript": {
    "title": "PC Engine / TurboGrafx-16",
    "emulator": {
      "binary": "mednafen",
      "family": "dedicated",
      "screenshot": "window",
      "framesUnit": "frames",
      "defaultFrames": 180,
      "installer": "mednafen",
      "deferred": "Mednafen is a GUI app"
    },
    "entry": "./src/index.8bs",
    "exports": {
      "./screen": "./src/screen.8bs",
      "./text": "./src/text.8bs",
      "./input": "./src/input.8bs",
      "./pointer": "./src/pointer.8bs",
      "./rasterline": "./src/rasterline.8bs"
    },
    "hardware": {
      "build": {
        "defsym": {
          "__load_address": 57344,
          "__rom_size": 32768,
          "__bss_origin": 512,
          "__bss_ceiling": 4608,
          "__ram_ceiling": 65536
        },
        "output": "pce"
      },
      "facts": {
        "video.columns": 32,
        "video.rows": 28,
        "video.cellWidth": 8,
        "video.cellHeight": 8,
        "video.palette": 512,
        "video.cellColors": 2,
        "video.colorPerCell": false,
        "video.glyphs": 0,
        "video.blockWidth": 0,
        "video.blockHeight": 0,
        "video.bitmap": false,
        "video.layers": 1,
        "video.scroll": true,
        "video.raster": true,
        "video.sprites": 64,
        "video.spritesPerLine": 16,
        "video.spriteWidth": 32,
        "video.spriteHeight": 64,
        "video.spriteColors": 15,
        "video.frameRate": 60,
        "audio.voices": 6,
        "audio.noise": true,
        "audio.envelope": false,
        "audio.filter": false,
        "audio.pcm": false,
        "audio.volume": false,
        "audio.entropy": false,
        "input.keyboard": false,
        "input.joysticks": 0,
        "input.pads": 1,
        "input.controls": [
          "up",
          "down",
          "left",
          "right",
          "a",
          "b",
          "select",
          "start"
        ],
        "input.mouse": false,
        "input.paddles": false,
        "storage.save": false,
        "storage.kib": 0,
        "memory.ram": 8192,
        "memory.banked": false,
        "memory.bankedKib": 0
      },
      "options": {
        "media": {
          "label": "Media",
          "default": "hucard",
          "values": {
            "hucard": {
              "label": "HuCard",
              "build": {
                "output": "pce"
              }
            },
            "cdrom2": {
              "label": "CD-ROM² (later)",
              "build": {
                "output": "pce"
              }
            }
          }
        }
      },
      "presets": {}
    }
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test"
  }
}

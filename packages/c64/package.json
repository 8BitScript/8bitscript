{
  "name": "@8bitscript/c64",
  "private": true,
  "version": "0.0.0",
  "description": "C64 target support for 8BitScript: the hardware underneath the portable APIs.",
  "license": "MIT",
  "8bitscript": {
    "entry": "./src/index.8bs",
    "native": [
      "./native/6502/raster.s"
    ],
    "exports": {
      "./screen": "./src/screen.8bs",
      "./text": "./src/text.8bs",
      "./video": "./src/geometry.8bs",
      "./sprites": "./src/sprites.8bs",
      "./keyboard": "./src/keyboard.8bs",
      "./keys": "./src/keys.8bs",
      "./joystick": "./src/joystick.8bs",
      "./sid": "./src/sid.8bs",
      "./reu": "./src/reu.8bs",
      "./mouse": "./src/mouse.8bs",
      "./raster": "./src/raster.8bs",
      "./bitmap": "./src/bitmap.8bs",
      "./charset": "./src/charset.8bs",
      "./scroll": "./src/scroll.8bs",
      "./input": "./src/input.8bs",
      "./pointer": "./src/pointer.8bs"
    },
    "hardware": {
      "facts": {
        "video.columns": 40,
        "video.rows": 25,
        "video.cellWidth": 8,
        "video.cellHeight": 8,
        "video.palette": 16,
        "video.cellColors": 2,
        "video.colorPerCell": true,
        "video.glyphs": 256,
        "video.blockWidth": 2,
        "video.blockHeight": 2,
        "video.bitmap": true,
        "video.layers": 1,
        "video.scroll": true,
        "video.sprites": 8,
        "video.spritesPerLine": 8,
        "video.spriteWidth": 24,
        "video.spriteHeight": 21,
        "video.spriteColors": 3,
        "video.frameRate": 60,
        "audio.voices": 3,
        "audio.noise": true,
        "audio.envelope": true,
        "audio.filter": true,
        "audio.pcm": true,
        "audio.volume": true,
        "audio.entropy": true,
        "input.keyboard": true,
        "input.joysticks": 2,
        "input.pads": 0,
        "input.mouse": false,
        "input.paddles": false,
        "storage.save": true,
        "memory.ram": 51199,
        "memory.banked": false,
        "memory.bankedKib": 0,
        "storage.kib": 164
      },
      "options": {
        "ram": {
          "label": "RAM Expansion Unit",
          "default": "none",
          "detect": "@8bitscript/c64/reu",
          "values": {
            "none": {
              "label": "No expansion"
            },
            "reu128": {
              "label": "REU, 128 KiB",
              "run": {
                "x64sc": [
                  "-reu",
                  "-reusize",
                  "128"
                ]
              },
              "facts": {
                "memory.banked": true,
                "memory.bankedKib": 128
              }
            },
            "reu256": {
              "label": "REU, 256 KiB",
              "run": {
                "x64sc": [
                  "-reu",
                  "-reusize",
                  "256"
                ]
              },
              "facts": {
                "memory.banked": true,
                "memory.bankedKib": 256
              }
            },
            "reu512": {
              "label": "REU, 512 KiB",
              "run": {
                "x64sc": [
                  "-reu",
                  "-reusize",
                  "512"
                ]
              },
              "facts": {
                "memory.banked": true,
                "memory.bankedKib": 512
              }
            },
            "reu1m": {
              "label": "REU, 1 MiB",
              "run": {
                "x64sc": [
                  "-reu",
                  "-reusize",
                  "1024"
                ]
              },
              "facts": {
                "memory.banked": true,
                "memory.bankedKib": 1024
              }
            },
            "reu2m": {
              "label": "REU, 2 MiB",
              "run": {
                "x64sc": [
                  "-reu",
                  "-reusize",
                  "2048"
                ]
              },
              "facts": {
                "memory.banked": true,
                "memory.bankedKib": 2048
              }
            },
            "reu4m": {
              "label": "REU, 4 MiB",
              "run": {
                "x64sc": [
                  "-reu",
                  "-reusize",
                  "4096"
                ]
              },
              "facts": {
                "memory.banked": true,
                "memory.bankedKib": 4096
              }
            },
            "reu8m": {
              "label": "REU, 8 MiB",
              "run": {
                "x64sc": [
                  "-reu",
                  "-reusize",
                  "8192"
                ]
              },
              "facts": {
                "memory.banked": true,
                "memory.bankedKib": 8192
              }
            },
            "reu16m": {
              "label": "REU, 16 MiB",
              "run": {
                "x64sc": [
                  "-reu",
                  "-reusize",
                  "16384"
                ]
              },
              "facts": {
                "memory.banked": true,
                "memory.bankedKib": 16384
              }
            }
          }
        },
        "sid": {
          "label": "SID",
          "default": "6581",
          "values": {
            "6581": {
              "label": "6581 (the original SID)",
              "run": {
                "x64sc": [
                  "-sidmodel",
                  "0"
                ]
              }
            },
            "8580": {
              "label": "8580 (the later SID)",
              "run": {
                "x64sc": [
                  "-sidmodel",
                  "1"
                ]
              }
            }
          }
        },
        "port1": {
          "label": "Control port 1",
          "default": "none",
          "values": {
            "none": {
              "label": "Nothing plugged in",
              "run": {
                "x64sc": [
                  "-controlport1device",
                  "0"
                ]
              }
            },
            "joystick": {
              "label": "Joystick",
              "run": {
                "x64sc": [
                  "-controlport1device",
                  "1"
                ]
              }
            },
            "paddles": {
              "label": "Paddles",
              "run": {
                "x64sc": [
                  "-controlport1device",
                  "2"
                ]
              },
              "facts": {
                "input.paddles": true
              }
            },
            "mouse1351": {
              "label": "Commodore 1351 mouse",
              "run": {
                "x64sc": [
                  "-controlport1device",
                  "3",
                  "-mouse"
                ]
              },
              "facts": {
                "input.mouse": true
              },
              "detect": "@8bitscript/c64/mouse"
            }
          }
        },
        "port2": {
          "label": "Control port 2",
          "default": "joystick",
          "values": {
            "none": {
              "label": "Nothing plugged in",
              "run": {
                "x64sc": [
                  "-controlport2device",
                  "0"
                ]
              }
            },
            "joystick": {
              "label": "Joystick",
              "run": {
                "x64sc": [
                  "-controlport2device",
                  "1"
                ]
              }
            },
            "paddles": {
              "label": "Paddles",
              "run": {
                "x64sc": [
                  "-controlport2device",
                  "2"
                ]
              },
              "facts": {
                "input.paddles": true
              }
            },
            "mouse1351": {
              "label": "Commodore 1351 mouse",
              "run": {
                "x64sc": [
                  "-controlport2device",
                  "3",
                  "-mouse"
                ]
              },
              "facts": {
                "input.mouse": true
              },
              "detect": "@8bitscript/c64/mouse"
            }
          }
        },
        "drive": {
          "label": "Disk drive",
          "default": "1541",
          "values": {
            "none": {
              "label": "No drive (tape or nothing)",
              "facts": {
                "storage.save": false,
                "storage.kib": 0
              },
              "tag": null
            },
            "1541": {
              "label": "1541 (170K disk)",
              "facts": {
                "storage.save": true,
                "storage.kib": 164
              },
              "tag": null
            },
            "1571": {
              "label": "1571 (340K disk)",
              "facts": {
                "storage.save": true,
                "storage.kib": 329
              },
              "tag": null
            },
            "1581": {
              "label": "1581 (800K disk)",
              "facts": {
                "storage.save": true,
                "storage.kib": 783
              },
              "tag": null
            }
          }
        }
      },
      "presets": {
        "stock": {
          "ram": "none"
        },
        "reu128": {
          "ram": "reu128"
        },
        "reu256": {
          "ram": "reu256"
        },
        "reu512": {
          "ram": "reu512"
        },
        "reu1m": {
          "ram": "reu1m"
        },
        "reu2m": {
          "ram": "reu2m"
        },
        "reu4m": {
          "ram": "reu4m"
        },
        "reu8m": {
          "ram": "reu8m"
        },
        "reu16m": {
          "ram": "reu16m"
        }
      }
    }
  },
  "files": [
    "src",
    "native"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test"
  }
}

// @8bitscript/graphics on the C64, end to end: fifteen graphics sprites (more
// than the VIC-II's eight, so the multiplexer reuses hardware sprites), one
// of them at X = 300 (past 255, so the ninth X bit) and one animating.
// Twelve graphics.update() calls advance the walker six times at `every 2`,
// so it ends on frame 2 of 4 and the screenshot does not depend on timing;
// after that the sprites are only redrawn.
import { screen } from "@8bitscript/screen";
import { graphics } from "@8bitscript/graphics";
import { sprites } from "@8bitscript/sprites";
import { walker, wide, corner, dot0, dot1, dot2, dot3, dot4, dot5, dot6, dot7, dot8, dot9, dot10, dot11 } from "./graphics-probe.8bg";

export function main(): void {
    screen.blank();
    graphics.place(walker, 40, 20);
    graphics.place(wide, 276, 60);
    graphics.place(corner, 0, 0);
    graphics.place(dot0, 16, 90);
    graphics.place(dot1, 36, 98);
    graphics.place(dot2, 56, 106);
    graphics.place(dot3, 76, 114);
    graphics.place(dot4, 96, 122);
    graphics.place(dot5, 116, 130);
    graphics.place(dot6, 136, 138);
    graphics.place(dot7, 156, 146);
    graphics.place(dot8, 176, 154);
    graphics.place(dot9, 196, 162);
    graphics.place(dot10, 216, 170);
    // Stage pixels: 236 is sprite-chip X 260, past 255 (the ninth X bit).
    graphics.place(dot11, 236, 178);
    for (let n: utinyint = 0; n < 12; n++) {
        waitFrame();
        graphics.update();
    }
    while (true) {
        waitFrame();
        sprites.update();
    }
}

// The rasterline layer, run for real: the portable slot surface
// (@8bitscript/raster) resolved to this package's src/rasterline.8bs, its
// picture lines landing 50 raster lines down and its slots landing on the
// concrete registers — BORDER on $D020, BACKGROUND on $D021, SCROLL_X on
// $D016 with the program's own CSEL preserved — read from the screenshot
// at a few pixels the way raster-probe.8bs is.
//
// Columns 0-19 of every text row are solid white blocks, so a SCROLL_X
// split shows as where each scanline's white/background edge sits: picture
// pixel 160 plus that line's shift. The band at picture lines 100-129
// carries XSCROLL 7 and sits exactly 7 pixels right of the straight rows.
// The program goes to 38 columns (scroll.setNarrow) BEFORE building the
// list, so the widened left border surviving inside the band is the CSEL
// preservation made visible: a layer that baked 40 columns into its $D016
// bytes would paint picture pixels 0-6 there.
//
// The refusal path is part of the picture: picture line 200 is past the
// 200-line visible picture, the translation layer refuses it before the
// address list is touched, and the probe converts that returned false into
// the yellow band a passing capture shows.
// See test/layers.test.mjs.
import { raster, Slot } from "@8bitscript/raster";
import { screen, BorderColor, BackgroundColor } from "../src/screen.8bs";
import { scroll } from "../src/scroll.8bs";
import { screenRam, colorRam } from "../src/geometry.8bs";

export function main(): void {
    screen.blank(BorderColor.BLACK, BackgroundColor.BLACK);
    // The left half of every row: reversed spaces (code 160) in white — a
    // solid block whose right edge at pixel 160 a SCROLL_X split moves.
    let cell: usmallint = 0;
    for (let row: u8 = 0; row < 25; row++) {
        for (let column: u8 = 0; column < 40; column++) {
            if (column < 20) {
                screenRam[cell] = 160;
                colorRam[cell] = 1;
            }
            cell = cell + 1;
        }
    }
    scroll.setNarrow(true); // 38 columns: the state a SCROLL_X split must not undo
    raster.clear();
    raster.at(0, Slot.BORDER, 2);      // red border from the picture's first line (raster 50)
    raster.at(0, Slot.BACKGROUND, 5);  // a green playfield behind it
    raster.at(100, Slot.SCROLL_X, 7);  // the band: XSCROLL 7 from picture line 100 ...
    raster.at(130, Slot.SCROLL_X, 0);  // ... straight again from 130, CSEL kept both times
    raster.at(150, Slot.BORDER, 6);    // blue border from picture line 150 (raster 200)
    if (!raster.at(200, Slot.BORDER, 7)) {
        // Refused: line 200 is the first line past the picture. The
        // yellow band from picture line 180 (raster 230) exists only
        // because that refusal came back false.
        raster.at(180, Slot.BACKGROUND, 7);
    }
    raster.enable();
    while (true) {
        waitFrame();
    }
}

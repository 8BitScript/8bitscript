// The REU probe, run for real: prints what reu.detect() found and sets the
// border to a color that encodes it, so a headless screenshot can be read
// by a test without decoding text — red for no REU, then one color per
// size: purple 128 KiB, green 256, blue 512, yellow 1 MiB, orange 2, brown
// 4, light red 8, dark grey 16. See test/reu.test.mjs.
use super::src::screen::screen;
use super::src::text::text;
use super::src::reu::reu;

pub fn main() {
    screen::blank();
    let kib: usmallint = reu::detect();
    text::print(0, "REU KIB");
    text::printNumber(8, kib, 5);
    let mut color: utinyint = 2;
    if kib != 0 {
        color = 3;
        let mut size: usmallint = 64;
        while size != kib {
            size = size * 2;
            color = color + 1;
        }
    }
    screen::setColors(color, 0);
    loop {
        waitFrame();
    }
}

// Twelve green dots for graphics-line-probe.8bs, which puts them all on one
// raster line: the VIC-II shows eight sprites on a line, so four are over.
sprite d0 {
  source "./graphics-probe-dot-green.png"
  size 8x8
  transparent auto
}


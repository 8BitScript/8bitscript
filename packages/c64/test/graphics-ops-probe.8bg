// The sprites graphics-ops-probe.8bs places: two four-frame walkers (one
// paused by setFrame/animate, one paused then resumed), a marker that is
// hidden and placed again, one that stays hidden, one that is recoloured,
// ten staircase dots (more than eight, so the multiplexer reuses hardware
// sprites; two of them are recoloured), and three full-size sprites at the
// playfield's right, bottom and past-the-bottom edges. The PNGs are the ones
// graphics-probe.8bg uses (graphics-probe-assets.mjs makes them).
sprite stepper {
  source "./graphics-probe-walker.png"
  size 16x16
  transparent auto
  animation walk {
    frames 0, 1, 2, 3
    every 2
  }
}

sprite runner {
  source "./graphics-probe-walker.png"
  size 16x16
  transparent auto
  animation walk {
    frames 0, 1, 2, 3
    every 2
  }
}

sprite mover {
  source "./graphics-probe-corner.png"
  size 8x8
  transparent auto
}


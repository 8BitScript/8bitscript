// Bitmap mode, run for real: a white rectangle on blue cells, a red cell,
// and a sprite drawn from a shape block under the I/O area. A screenshot
// reads a pixel inside the rectangle, one outside, and one on the sprite.
// See test/layers.test.mjs.
import { screen, BorderColor, BackgroundColor } from "../src/screen.8bs";
import { bitmap } from "../src/bitmap.8bs";
import { sprites } from "../src/sprites.8bs";
import { Bitmap } from "../src/geometry.8bs";

export function main(): void {
    screen.blank(BorderColor.BLACK, BackgroundColor.BLACK);
    bitmap.enter(false);
    bitmap.clear();
    bitmap.fillColors(1, 6); // white pixels on blue cells
    for (let y: u8 = 40; y < 100; y++) {
        for (let x: u16 = 40; x < 120; x++) {
            bitmap.plot(x, y);
        }
    }
    for (let i: u8 = 0; i < 63; i++) {
        sprites.setShapeByte(Bitmap.SHAPE_BLOCK_FIRST, i, 255);
    }
    sprites.setShape(0, Bitmap.SHAPE_BLOCK_FIRST);
    sprites.setColor(0, 7); // yellow
    sprites.place(0, 250, 180);
    sprites.show(0);
    while (true) {
        waitFrame();
    }
}

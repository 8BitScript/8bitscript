// @8bitscript/c64/idle — the VIC-II's idle graphics, and the "ghost byte"
// they are drawn from.
//
// Named by "8bitscript".exports["./idle"] in this package's package.json:
//
//     import { idle, Pattern } from "@8bitscript/c64/idle";
//     import { raster } from "@8bitscript/c64/raster";
//
//     idle.setPattern(Pattern.BLACK);          // an opened border draws black
//     raster.at(200, idle.PATTERN, Pattern.DITHER); // ... and dithered from line 200
//
// ---- what idle graphics are ------------------------------------------------
//
// The VIC-II has two states while it draws (Bauer, "The MOS 6567/6569 video
// controller", §3.7.1): DISPLAY state, from the first bad line of a frame
// (raster $30-$F7 whose low three bits equal YSCROLL — 51 with the default
// 3) to the end of the last text row, and IDLE state everywhere else. In
// idle state it still draws: "the access is always to address $3fff
// ($39ff when the ECM bit is set). The graphics are displayed by the
// sequencer exactly as in display state, but with the video matrix data
// treated as 0 bits" — one byte, repeated across the line, its 1 bits in
// color 0 (black) and its 0 bits the background color ($D021), in standard,
// multicolor and extended-color text modes alike. (Bitmap mode is the
// exception: with the matrix data 0 both of a hi-res cell's colors are
// black, so an idle area is solid black whatever the byte holds; in
// multicolor bitmap mode only the %00 pairs show $D021.) The idle lines a
// program sees:
//
//   - the gap YSCROLL opens: with 25 rows on and YSCROLL 4-7 (the classic
//     POKE 53265,31), the display window starts at line 51 but the first
//     bad line is at 48 + YSCROLL, and the lines between are idle — the
//     "garbage" a vertical scroller shows above its top row. YSCROLL 0-2
//     opens the same gap below row 24 instead. Bauer, §3.7.1: "If you set
//     a YSCROLL other than 3 in a 25 line display window and store a value
//     not equal to zero in $3fff you can see the stripes generated by the
//     sequencer in idle state on the upper or lower side of the window."
//   - the opened vertical border (./border.8bs): the whole area above the
//     first row and below the last is idle, and once the border no longer
//     covers it the idle graphics are what is there — under the sprites.
//   - the lines FLD (delaying the first bad line by stepping YSCROLL) holds
//     the VIC in idle, if a program does that itself with $D011 entries.
//
// ---- the ghost byte, and where this package keeps it ------------------------
//
// $3FFF in the VIC's bank: this package's picture is in bank 3 (./geometry.8bs),
// so the byte is $FFFF — the high byte of the CPU's IRQ vector. That is
// not a coincidence to work around by moving the picture; it is why
// native/6502/raster.s routes the IRQ through page zero: with the handler
// in program RAM, its page number is what the gap and the opened border
// draw ($0A drew `....#.#.` under x64sc), and with the IRQ target at
// $00FD the byte is 0 — TRANSPARENT: every idle line is the background
// color, in every C64 program, with nothing to set. `idle.GHOST` names it
// for reading (`ghost()`), and nothing should write it: a raster-list
// entry to $FFFF would send the next interrupt into the wrong page.
//
// A program that wants a pattern instead — solid black under an opened
// border so the sprites float on black while the playfield stays blue, a
// dither, a per-line gradient — sets ECM ($D011 bit 6) for those lines,
// which moves the fetch to $39FF: $F9FF here, the 64th byte of sprite
// shape block 231, which no sprite uses (a shape is 63 bytes). That is
// `idle.PATTERN`, plain RAM: `setPattern()` writes it, and because the
// raster list writes any address, `raster.at(line, idle.PATTERN, bits)`
// changes it at a line — eight pixels a cell, so a byte per two or three
// lines paints a dithered gradient down an opened border for one entry
// each. ECM only means "$39FF" in TEXT modes: with BMM or MCM set as well
// the VIC is in an invalid mode and draws black (Bauer §3.7.3.9), which is
// also a way to get a black band. ./border.8bs sets ECM in the lines it
// opens and clears it before the first row; a program that opens a gap
// with YSCROLL and wants a pattern there sets ECM for those lines itself
// (an entry at 47 + YSCROLL clears it in time for the first bad line, as
// border.top() does).
//
// Under x64sc the byte at $F9FF is whatever the RAM held, so `setPattern`
// (or border.bottom(), which does it once) must run before ECM is first
// set — `patternSet` is what border.bottom() checks.
const GHOST_ADDRESS: usmallint = 0xFFFF; // $3FFF in bank 3: read-only by this package's rules
const PATTERN_ADDRESS: usmallint = 0xF9FF; // $39FF in bank 3: block 231's pad byte

@address(PATTERN_ADDRESS)
let patternByte: volatile<u8>;

export let patternSet: bool = false;

// Some bytes. Bits are pixels left to right; 1 is black, 0 the background.
export namespace Pattern {
    const TRANSPARENT: utinyint = 0x00; // the background color, as $FFFF's 0 gives without ECM
    const BLACK: utinyint = 0xFF;
    const DITHER: utinyint = 0x55;      // alternate pixels: a 50% mix
    const DITHER_2: utinyint = 0x33;    // pairs
    const LEFT_HALF: utinyint = 0xF0;   // each cell's left four pixels black
    const LINE: utinyint = 0x80;        // one pixel in eight: a fine vertical grid
    const SPARSE: utinyint = 0x11;      // two in eight
    const DENSE: utinyint = 0xEE;       // six in eight
}

export namespace idle {
    const GHOST: usmallint = GHOST_ADDRESS;     // what the VIC reads with ECM clear: 0, always
    const PATTERN: usmallint = PATTERN_ADDRESS; // what it reads with ECM set: setPattern()'s byte
    const ECM: utinyint = 0x40;                 // $D011 bit 6
    const PATTERN_BLOCK: utinyint = 231;        // the sprite shape block whose pad byte PATTERN is

    // The byte idle lines draw while ECM is set.
    function setPattern(bits: utinyint): void {
        patternByte = bits;
        patternSet = true;
    }

    function pattern(): utinyint {
        return patternByte;
    }

    // The byte idle lines draw with ECM clear — the IRQ vector's page,
    // 0 by construction. A program can check it rather than believe it.
    function ghost(): utinyint {
        return memory.read(GHOST_ADDRESS);
    }

    // The first line in display state for a YSCROLL: the first bad line,
    // 48 + YSCROLL. Above it, down to the top of the window (51), is idle.
    function firstBadLine(yscroll: utinyint): utinyint {
        return 48 + (yscroll & 7);
    }

    // The last line of row 24 for a YSCROLL: 247 + YSCROLL. Below it, up
    // to the bottom of the window (250), is idle; above 250, row 24's
    // last lines are under the border unless it is opened.
    function lastRowLine(yscroll: utinyint): utinyint {
        return 247 + (yscroll & 7);
    }
}

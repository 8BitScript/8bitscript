// input.8bs's own `.web` twin — build.mjs's internal `web` tag resolves this
// in place of input.8bs whenever this package builds through the wasm backend
// (`8bs build --target c64 --web`, `8bs run c64 --web`).
//
// The native file scans the keyboard matrix and the control ports through
// CIA 1: it writes a column to port A and reads the rows back from port B. A
// wasm build has no CIA to answer, so those reads would be zeros forever. The
// page, on the other hand, already listens for keys and stores a snapshot of
// them at one byte of the program's memory (web-layout.mjs agreementFor():
// `inputOffset`), the way it does for every wasm build; this twin reads that
// byte once a frame and works out what began, which is exactly what
// `poll()` gives a program on any other machine.
//
//   - left / right / up / down — ArrowLeft / ArrowRight / ArrowUp / ArrowDown
//   - confirm                  — Enter (the C64's RETURN)
//   - cancel                   — Escape (the C64's RUN/STOP)
//
// What it does not do, and `runtime.wasm.limits` in `8bs targets --json` says
// so: no joystick (there is nothing to plug in), no mouse (`pointer()` is
// false), and the machine-level layers `@8bitscript/c64/keyboard` and
// `/joystick` still read the CIA and see nothing — a program that wants input
// on this rail uses the portable `@8bitscript/input`, as every portable
// program does.
//
// The offset below is where agreementFor() puts the byte for this machine's
// fixed 40x25 grid; packages/cli/test/web-c64.test.mjs holds it to the layout,
// so changing one without the other fails. Keep the export list identical to
// input.8bs — test/c64-web-twin.test.mjs holds the two to the same names.

// One bit per thing a program can ask about, so a frame's input is one
// byte and an edge is one AND. The page's side is web-layout.mjs's InputEdge.
namespace Edge {
    const LEFT: utinyint = 1;
    const RIGHT: utinyint = 2;
    const UP: utinyint = 4;
    const DOWN: utinyint = 8;
    const CONFIRM: utinyint = 16;
    const CANCEL: utinyint = 32;
}

const INPUT_BYTE: usmallint = 2002; // agreementFor(40x25).inputOffset

// What is held now, what was held at the last poll, and what began this
// frame — `now & ~last`, written with the XOR the language has.
let held: utinyint = 0;
let before: utinyint = 0;
let began: utinyint = 0;

export namespace input {

    // Once, at start-up, before the first poll(). One poll before the
    // program's first, so the edge detector starts from what is actually held
    // rather than from nothing: without it, a key already down when the
    // program starts reads as a fresh press on frame one.
    function begin(): void {
        input.poll();
    }

    // Read the page's snapshot and work out what began this frame. Once a
    // frame, right after waitFrame().
    function poll(): void {
        before = held;
        held = memory.read(INPUT_BYTE);
        began = held & (before ^ 0xFF);
    }

    // The four directions, each true only on the frame its press began.
    function left(): bool {
        return (began & Edge.LEFT) != 0;
    }

    function right(): bool {
        return (began & Edge.RIGHT) != 0;
    }

    function up(): bool {
        return (began & Edge.UP) != 0;
    }

    function down(): bool {
        return (began & Edge.DOWN) != 0;
    }

    // RETURN.
    function confirm(): bool {
        return (began & Edge.CONFIRM) != 0;
    }

    // RUN/STOP.
    function cancel(): bool {
        return (began & Edge.CANCEL) != 0;
    }

    // No pointer on this rail: there is no mouse to read.
    function pointer(): bool {
        return false;
    }

    function pointerCell(): usmallint {
        return 0;
    }

    function pointerButton(): bool {
        return false;
    }
}

// Compile-time names for the confirm control, interpolated into catalogs
// as {control} / {other}. The wasm build has the keyboard's RETURN only.
export namespace Input {
    const CONFIRM_LABEL: string = "RETURN";
    const ALT_CONFIRM_LABEL: string = "RETURN";
    const CONFIRM_LABELS: string = "RETURN";
}

// @8bitscript/c64/rasterline — the C64 behind @8bitscript/raster.
//
// Named by "8bitscript".exports["./rasterline"] in this package's
// package.json, and by "8bitscript".entry.c64 in @8bitscript/raster's, so a
// portable program writes
//
//     import { raster, Slot } from "@8bitscript/raster";
//
//     raster.clear();
//     raster.at(0, Slot.BORDER, 0);        // black border over the picture
//     raster.at(0, Slot.BACKGROUND, 6);    // blue playfield
//     raster.at(160, Slot.BACKGROUND, 0);  // a black status area lower down
//     raster.enable();
//
// and gets this file on a C64. It names *what the picture does at a line*
// — a slot — where ./raster.8bs, which stays directly importable and is
// what this file is a thin translation onto, names *which register to
// write*. A C64 program that wants any register beyond the four slots
// (sprite multiplexing, a $D018 screen move, $D011) wants ./raster itself,
// and is a C64 program from then on.
//
// ---- the portable surface ------------------------------------------------
//
// The same shape on all nine machines (the C64, the VIC-20 and the web
// implement it; the rest ship an honest zero-cost stub until they have an
// implementation; #fact(video.raster) says which kind a build got, so a
// program's raster branch folds away on a machine without one):
//
//   - `Slot`: BORDER, BACKGROUND, SCROLL_X — the three per-line effects
//     that mean the same thing everywhere — and CHARSET, the machine's
//     alternate character set where it has one.
//   - `raster.ENTRIES` — the list's capacity: 63 here, 0 in a stub.
//   - `raster.STRIDE` — the bytes one entry takes, the unit `setValue`
//     names an entry in: 4 here, 3 on the web and the VIC-20, 0 in a
//     stub. (examples/fancy probed for this at start-up before the
//     surface carried it.)
//   - `raster.FINE_SCROLL` — whether `Slot.SCROLL_X` entries are taken:
//     true here and on the web, false on the VIC-20 (splits, but no fine
//     scroll) and in a stub. A compile-time constant, so a wobble behind
//     it folds away where the list would refuse its entries.
//   - `raster.COLORS`, `raster.CHARSET` — the same kind of constant for
//     BORDER/BACKGROUND and for CHARSET: both true here.
//   - `clear()`, `at(line, slot, value)`, `insert(line, slot, value)`,
//     `setValue(entry, value)`, `count()`, `commit()`, `enable()`,
//     `disable()` — the same list operations ./raster.8bs documents,
//     `at` and `insert` taking a slot instead of an address and
//     `setValue` keeping the slot's value semantics (a SCROLL_X entry
//     rewrites with the 0-7 scroll amount, never a raw byte). `commit()`
//     hands a rebuilt list over whole (docs/project/frame.md: a frame is
//     a plan built between frames); it is a no-op where the list is
//     single-buffered (the web) or absent.
//
// `line` is a **picture line**: 0 is the first visible scanline on every
// machine. This file adds the display window's top offset (50 — the same
// TOP the sprite layer names) before handing the line to the address list,
// and `at` refuses a line at or past the 200-line visible picture, so the
// same portable program means the same thing here and, later, on the web.
// Entries still go in ascending line order, a write still takes effect
// from the line after its entry's, and a list is still built once and
// rewritten by value each frame, or rebuilt and committed (./raster.8bs:
// `enable()` commits the first list; a rebuilt one needs its own
// `commit()`) — ./raster.8bs's rules, which the picture-line translation
// does not change.
//
// `Slot.SCROLL_X`'s value is the 3-bit XSCROLL (0-7) only — everywhere,
// `at` and `setValue` alike; a caller never sees the $D016 encoding. The
// list mechanism stores a raw byte to write, so a read-modify-write of
// $D016 at the line is not possible; this layer folds the register's
// CURRENT upper bits (CSEL, MCM — read as the entry is stored or
// rewritten) into the byte instead, so a program that has deliberately
// gone to 38 columns or multicolor keeps that state through a scroll
// split. A program that wants to CHANGE CSEL or MCM at a line writes
// Register.CONTROL_2 through ./raster.
//
// `Slot.CHARSET`'s value is 0 or 1 (only bit 0 is read), the same meaning
// as the PET's: 0 is the set the machine boots in — upper case and
// graphics — and 1 the other one, lower and upper case. This package
// copies the whole 4K character ROM to $D000 in bank 3 (setupVideo), so
// both sets are always in VIC-visible RAM and the switch is $D018 bit 1
// alone: Video.MEMORY_POINTER_UPPERCASE ($84, the set at bank+$1000) or
// Video.MEMORY_POINTER_LOWERCASE ($86, bank+$1800) — the Programmer's
// Reference Guide's POKE 53272,21 / 23 ($15 / $17) moved to this
// package's bank. The entry's byte is one of those two constants, never a
// read of $D018, so the screen-pointer bits 4-7 it carries are the text
// screen's at $E000 whatever $D018 holds at the moment the entry is
// stored. A charset means nothing over a bitmap, and writing either byte
// there would point the VIC at the text screen mid-picture, so CHARSET
// entries are refused (false) while videoMode is VideoMode.BITMAP — and a
// program that goes to bitmap after building a list with CHARSET entries
// rebuilds the list first. No other slot writes $D018, so nothing else in
// the list clobbers a charset split.
//
// There is no `apply(table)` taking a whole list at once: array parameters
// are not lowered by the 6502 backend yet, so a program loops over its own
// `const` table calling `at()` — or, for a per-frame effect whose lines
// stand, `setValue()` per entry — itself.
import { raster as addressList, Register } from "./raster.8bs";
import { control2, videoMode, VideoMode } from "./index.8bs";
import { Video } from "./geometry.8bs";

// What the picture does at a line, named without an address. The numbers
// are arbitrary and the same in all nine rasterline files.
export namespace Slot {
    const BORDER: utinyint = 0;     // the border's color
    const BACKGROUND: utinyint = 1; // the playfield's background color
    const SCROLL_X: utinyint = 2;   // the horizontal fine scroll, 0-7
    const CHARSET: utinyint = 3;    // 0 = upper case/graphics ($D018 $84), 1 = lower/upper case ($86)
}

export namespace raster {
    const ENTRIES: utinyint = 63; // the list's capacity, ./raster.8bs's MAX
    const STRIDE: utinyint = 4;   // bytes per entry: line, address low, address high, value
    const FINE_SCROLL: bool = true; // Slot.SCROLL_X entries are accepted: $D016's XSCROLL
    const COLORS: bool = true;     // Slot.BORDER/BACKGROUND entries are accepted
    const CHARSET: bool = true;    // Slot.CHARSET entries are accepted: $D018 bit 1, text mode only
    const FRAME_COUNTER: bool = true; // frame() counts video frames since enable()
    const TOP: utinyint = 50;     // picture line 0 is raster line 50
    const LINES: utinyint = 200;  // visible picture lines, 0-199
    const KEEP: utinyint = 0xF8;  // $D016 bits 3-7 — CSEL, MCM — kept in every SCROLL_X byte

    // Empty the list.
    function clear(): void {
        addressList.clear();
    }

    // Append: at picture line `line`, give `slot` the value `value`.
    // False, and nothing added, if the line is past the visible picture,
    // the slot is not one of the four (or is CHARSET over a bitmap), or the
    // underlying list refuses it
    // (full, or a line below the last entry's).
    function at(line: utinyint, slot: utinyint, value: utinyint): bool {
        if (line >= raster.LINES) {
            return false;
        }
        if (slot == Slot.BORDER) {
            return addressList.at(line + raster.TOP, Register.BORDER, value);
        }
        if (slot == Slot.BACKGROUND) {
            return addressList.at(line + raster.TOP, Register.BACKGROUND, value);
        }
        if (slot == Slot.SCROLL_X) {
            return addressList.at(line + raster.TOP, Register.CONTROL_2, (control2 & raster.KEEP) | (value & 7));
        }
        if (slot == Slot.CHARSET && videoMode == VideoMode.TEXT) {
            return addressList.at(line + raster.TOP, Register.MEMORY_POINTER, charsetPointer(value));
        }
        return false;
    }

    // In order: the same as `at`, at a line at or above the last entry's
    // — slid into place, so a program adding a few entries of its own
    // beside another package's plan (sprites', say) need not know what
    // else the list holds. False, and nothing added, if full.
    function insert(line: utinyint, slot: utinyint, value: utinyint): bool {
        if (line >= raster.LINES) {
            return false;
        }
        if (slot == Slot.BORDER) {
            return addressList.insert(line + raster.TOP, Register.BORDER, value);
        }
        if (slot == Slot.BACKGROUND) {
            return addressList.insert(line + raster.TOP, Register.BACKGROUND, value);
        }
        if (slot == Slot.SCROLL_X) {
            return addressList.insert(line + raster.TOP, Register.CONTROL_2, (control2 & raster.KEEP) | (value & 7));
        }
        if (slot == Slot.CHARSET && videoMode == VideoMode.TEXT) {
            return addressList.insert(line + raster.TOP, Register.MEMORY_POINTER, charsetPointer(value));
        }
        return false;
    }

    // How many entries the list holds.
    function count(): utinyint {
        return addressList.count();
    }

    // Hand a rebuilt list over: live from the next frame, whole. A list
    // built once before enable() never needs it (enable() commits).
    function commit(): void {
        addressList.commit();
    }

    // Rewrite one entry's value, leaving its line and slot: `entry` is the
    // entry's byte offset (index * 4), the unit ./raster.8bs's setValue
    // takes. The value keeps `at`'s slot semantics: a SCROLL_X entry takes
    // the 0-7 scroll amount and is re-encoded here with $D016's current
    // CSEL and MCM bits — the byte `at` would store — so a per-frame
    // wobble never handles the register encoding. Other slots' values are
    // the byte to write, as they are in `at`. A CHARSET entry takes 0 or 1
    // and is re-encoded as `at` would encode it.
    function setValue(entry: utinyint, value: utinyint): bool {
        let address: usmallint = addressList.addressOf(entry);
        if (address == Register.CONTROL_2) {
            return addressList.setValue(entry, (control2 & raster.KEEP) | (value & 7));
        }
        if (address == Register.MEMORY_POINTER) {
            return addressList.setValue(entry, charsetPointer(value));
        }
        return addressList.setValue(entry, value);
    }

    // Own the IRQ: the list is applied from the next frame on.
    function enable(): void {
        addressList.enable();
    }

    // Video frames since enable(), wrapping at 256: the handler adds one at
    // line 0 of every frame, however slowly the game loop runs.
    function frame(): utinyint {
        return addressList.frame();
    }

    // Interrupts off again; the list is kept.
    function disable(): void {
        addressList.disable();
    }
}

// Slot.CHARSET's 0/1 as the $D018 byte the list writes: the text screen
// at $E000 over the upper-case set ($84) or the lower-case one ($86).
function charsetPointer(value: utinyint): utinyint {
    if ((value & 1) != 0) {
        return Video.MEMORY_POINTER_LOWERCASE;
    }
    return Video.MEMORY_POINTER_UPPERCASE;
}

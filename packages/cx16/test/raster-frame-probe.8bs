// raster.frame(), the portable video-frame counter, checked against the
// machine itself. Each pass of the loop is SLOW: it polls VERA's scanline
// counter (bit 8 of the line, $9F26 bit 6 on a read, falling = line 0 = a new
// frame) until three real frame boundaries have gone by, so one pass is three
// video frames long. raster.frame() is read before and after; if it counts
// video frames it moved by the same three (one either way: the interrupt
// lands a little after the line starts), if it counted loop passes it moved
// by one, and if the handler never counted it did not move. Twelve passes all
// agreeing leave the border green, the first that does not leaves it red.
// See test/raster-frame.test.mjs.
import { screen } from "../src/screen.8bs";
import { raster, Slot } from "../src/rasterline.8bs";

let previousHigh: utinyint = 0;
let polled: utinyint = 0;

// Count a frame boundary when the scanline's bit 8 goes from set to clear.
function poll(): void {
    let high: utinyint = memory.read(0x9F26) & 0x40;
    if (previousHigh != 0 && high == 0) {
        polled = polled + 1;
    }
    previousHigh = high;
}

export function main(): void {
    screen.blank();
    raster.clear();
    raster.at(0, Slot.BORDER, 0);
    raster.enable();
    let bad: utinyint = 0;
    let pass: utinyint = 0;
    while (pass < 12) {
        let framesBefore: utinyint = raster.frame();
        let polledBefore: utinyint = polled;
        while (polled - polledBefore < 3) {
            poll();
        }
        let framesSeen: utinyint = raster.frame() - framesBefore;
        let polledSeen: utinyint = polled - polledBefore;
        if (framesSeen + 1 < polledSeen || polledSeen + 1 < framesSeen) {
            bad = 1;
        }
        pass = pass + 1;
    }
    raster.disable();
    if (bad == 0) {
        screen.setBorder(5);
    } else {
        screen.setBorder(2);
    }
    while (true) {
        waitFrame();
    }
}

// The X16 bank probe, run for real: prints the KiB of banked RAM
// banks.kib() found and sets the border to a color that encodes it, so a
// headless screenshot can be read without decoding text — one color per
// size, 64 KiB up: red, purple, green, blue, yellow, orange. See
// test/banks.test.mjs.
use super::src::screen::screen;
use super::src::text::text;
use super::src::banks::banks;

pub fn main() {
    screen::blank();
    let kib: usmallint = banks::kib();
    text::print(0, "BANKED KIB");
    text::printNumber(11, kib, 5);
    let mut color: utinyint = 2;
    let mut size: usmallint = 64;
    while size != kib {
        size = size * 2;
        color = color + 1;
    }
    screen::setColors(color, 0);
    loop {
        waitFrame();
    }
}

{
  "name": "@8bitscript/cx16",
  "version": "0.24.0",
  "description": "Commander X16 target support for 8BitScript: the hardware underneath the portable APIs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/8BitScript/8bitscript.git",
    "directory": "packages/cx16"
  },
  "8bitscript": {
    "title": "Commander X16",
    "emulator": {
      "binary": "x16emu",
      "family": "dedicated",
      "screenshot": "gif",
      "framesUnit": "frames",
      "defaultFrames": 180,
      "installer": "cx16",
      "wasm": {
        "available": true,
        "limits": [
          "a flat text screen on a synthetic host font, not VERA: the tile layers, the bitmap layers, hardware sprites and the 128-sprite budget are not modelled; a .8bg picture is drawn as one 8x8 glyph in a single ink (8BS2111), not a VERA sprite",
          "no sound: the PSG, the YM2151 and PCM are plain memory, and a .8ba sample or song has no wasm driver (8BS2211); audio.tone is not wired for the X16's wasm build yet",
          "the X16-only modules that talk to VERA, the KERNAL or the banked RAM (@8bitscript/cx16/mouse, /pointer, /psg, /banks) read and write plain memory and see nothing",
          "the raster list (@8bitscript/raster, the X16's VERA line interrupt) is machine code and is not built for the wasm backend: a program that uses it does not build here (8bs build says 'asm' blocks are never lowered)",
          "the colours are VERA's default palette entries 0-15; a program that rewrites VERA palette entries or layer registers sees no change"
        ]
      }
    },
    "media": "./media/index.cjs",
    "wasmMedia": "web",
    "entry": "./src/index.8bs",
    "exports": {
      "./psg": "./src/psg.8bs",
      "./screen": "./src/screen.8bs",
      "./text": "./src/text.8bs",
      "./banks": "./src/banks.8bs",
      "./mouse": "./src/mouse.8bs",
      "./input": "./src/input.8bs",
      "./pointer": "./src/pointer.8bs",
      "./rasterline": "./src/rasterline.8bs",
      "./color": "./src/color.8bs"
    },
    "hardware": {
      "build": {
        "defsym": {
          "__load_address": 2049,
          "__ram_ceiling": 40704
        }
      },
      "facts": {
        "video.columns": 76,
        "video.rows": 56,
        "video.cellWidth": 8,
        "video.cellHeight": 8,
        "video.palette": 256,
        "video.cellColors": 2,
        "video.colorPerCell": true,
        "video.glyphs": 256,
        "video.blockWidth": 2,
        "video.blockHeight": 2,
        "video.bitmap": true,
        "video.layers": 2,
        "video.scroll": true,
        "video.raster": true,
        "video.colorBlend": false,
        "video.sprites": 128,
        "video.spritesPerLine": 46,
        "video.spriteWidth": 64,
        "video.spriteHeight": 64,
        "video.spriteColors": 255,
        "video.frameRate": 60,
        "audio.voices": 25,
        "audio.noise": true,
        "audio.envelope": true,
        "audio.filter": false,
        "audio.pcm": true,
        "audio.volume": true,
        "audio.entropy": false,
        "input.keyboard": true,
        "input.joysticks": 0,
        "input.pads": 2,
        "input.controls": [
          "up",
          "down",
          "left",
          "right",
          "a",
          "b",
          "x",
          "y",
          "l",
          "r",
          "start",
          "select"
        ],
        "input.mouse": true,
        "input.paddles": false,
        "storage.save": true,
        "memory.ram": 38655,
        "memory.banked": true,
        "memory.bankedKib": 512,
        "storage.kib": 32768
      },
      "run": {
        "x16emu": []
      },
      "options": {
        "ram": {
          "label": "Banked RAM",
          "default": "512",
          "detect": "@8bitscript/cx16/banks",
          "values": {
            "64": {
              "label": "64 KiB of banked RAM",
              "run": {
                "x16emu": [
                  "-ram",
                  "64"
                ]
              },
              "facts": {
                "memory.bankedKib": 64
              }
            },
            "128": {
              "label": "128 KiB of banked RAM",
              "run": {
                "x16emu": [
                  "-ram",
                  "128"
                ]
              },
              "facts": {
                "memory.bankedKib": 128
              }
            },
            "256": {
              "label": "256 KiB of banked RAM",
              "run": {
                "x16emu": [
                  "-ram",
                  "256"
                ]
              },
              "facts": {
                "memory.bankedKib": 256
              }
            },
            "512": {
              "label": "512 KiB of banked RAM",
              "run": {
                "x16emu": [
                  "-ram",
                  "512"
                ]
              },
              "facts": {
                "memory.bankedKib": 512
              }
            },
            "1024": {
              "label": "1024 KiB of banked RAM",
              "run": {
                "x16emu": [
                  "-ram",
                  "1024"
                ]
              },
              "facts": {
                "memory.bankedKib": 1024
              }
            },
            "2048": {
              "label": "2048 KiB of banked RAM",
              "run": {
                "x16emu": [
                  "-ram",
                  "2048"
                ]
              },
              "facts": {
                "memory.bankedKib": 2048
              }
            }
          }
        }
      },
      "presets": {}
    }
  },
  "files": [
    "src",
    "media"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test"
  }
}

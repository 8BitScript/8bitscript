{
  "name": "@8bitscript/cx16",
  "version": "0.4.1",
  "description": "Commander X16 target support for 8BitScript: the hardware underneath the portable APIs. Parked in 0.2.0: not a build target until its native backend lands.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/8BitScript/8bitscript.git",
    "directory": "packages/cx16"
  },
  "8bitscript": {
    "entry": "./src/index.8bs",
    "exports": {
      "./screen": "./src/screen.8bs",
      "./text": "./src/text.8bs",
      "./banks": "./src/banks.8bs",
      "./mouse": "./src/mouse.8bs",
      "./input": "./src/input.8bs",
      "./pointer": "./src/pointer.8bs"
    },
    "hardware": {
      "facts": {
        "video.columns": 76,
        "video.rows": 56,
        "video.cellWidth": 8,
        "video.cellHeight": 8,
        "video.palette": 256,
        "video.cellColors": 2,
        "video.colorPerCell": true,
        "video.glyphs": 256,
        "video.blockWidth": 2,
        "video.blockHeight": 2,
        "video.bitmap": true,
        "video.layers": 2,
        "video.scroll": true,
        "video.sprites": 128,
        "video.spritesPerLine": 46,
        "video.spriteWidth": 64,
        "video.spriteHeight": 64,
        "video.spriteColors": 255,
        "video.frameRate": 60,
        "audio.voices": 25,
        "audio.noise": true,
        "audio.envelope": true,
        "audio.filter": false,
        "audio.pcm": true,
        "audio.volume": true,
        "audio.entropy": false,
        "input.keyboard": true,
        "input.joysticks": 0,
        "input.pads": 2,
        "input.mouse": true,
        "input.paddles": false,
        "storage.save": true,
        "memory.ram": 38655,
        "memory.banked": true,
        "memory.bankedKib": 512,
        "storage.kib": 32768
      },
      "run": {
        "x16emu": [
          "-capture"
        ]
      },
      "options": {
        "ram": {
          "label": "Banked RAM",
          "default": "512",
          "detect": "@8bitscript/cx16/banks",
          "values": {
            "64": {
              "label": "64 KiB of banked RAM",
              "run": {
                "x16emu": [
                  "-ram",
                  "64"
                ]
              },
              "facts": {
                "memory.bankedKib": 64
              }
            },
            "128": {
              "label": "128 KiB of banked RAM",
              "run": {
                "x16emu": [
                  "-ram",
                  "128"
                ]
              },
              "facts": {
                "memory.bankedKib": 128
              }
            },
            "256": {
              "label": "256 KiB of banked RAM",
              "run": {
                "x16emu": [
                  "-ram",
                  "256"
                ]
              },
              "facts": {
                "memory.bankedKib": 256
              }
            },
            "512": {
              "label": "512 KiB of banked RAM",
              "run": {
                "x16emu": [
                  "-ram",
                  "512"
                ]
              },
              "facts": {
                "memory.bankedKib": 512
              }
            },
            "1024": {
              "label": "1024 KiB of banked RAM",
              "run": {
                "x16emu": [
                  "-ram",
                  "1024"
                ]
              },
              "facts": {
                "memory.bankedKib": 1024
              }
            },
            "2048": {
              "label": "2048 KiB of banked RAM",
              "run": {
                "x16emu": [
                  "-ram",
                  "2048"
                ]
              },
              "facts": {
                "memory.bankedKib": 2048
              }
            }
          }
        }
      },
      "presets": {}
    }
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test"
  }
}

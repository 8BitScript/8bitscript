// @8bitscript/cx16/input — the Commander X16 behind @8bitscript/input.
//
// Named by "8bitscript".exports["./input"] in this package's package.json,
// and by "8bitscript".entry.cx16 in @8bitscript/input's, so a portable
// program writes
//
//     import { input } from "@8bitscript/input";
//
// and gets this file on an X16.
//
// ---- what this layer answers ----------------------------------------------
//
// **The pointer, through the KERNAL.** `$FF68` mouse_config, `$FF71`
// mouse_scan and `$FF6B` mouse_get, wrapped by ./mouse.8bs. A menu asks
// "did the user just press", so the button is edge-triggered: true on the
// one frame the press begins, false while it is held. `poll()` has to be
// called exactly once a frame — twice a frame and every press is seen once
// and then swallowed. See ./mouse.8bs for why mouse_scan is called from
// here rather than left to the KERNAL IRQ (the frame driver has interrupts
// off).
//
// **Directions, confirm and cancel, through the KERNAL joystick API.**
// `waitFrame()` holds `sei` and acks VERA's VSYNC itself, so the default
// IRQ never runs `joystick_scan` or `kbd_scan`. This file does that work
// from `poll()`, after the mouse's `ps2data_fetch` (`$FEAB` A=8), in the
// same order the IRQ uses (`kernal/cbm/irq.s`): `joystick_scan` `$FF53`,
// then `kbd_scan` `$FF9F` (SCNKEY — which calls `joystick_from_ps2` so
// joy0 tracks the keyboard), then `joystick_get` `$FF56`.
//
// Bits are the ROM's, active low, from `kernal/drivers/x16/joystick.s`
// and the KERNAL reference: byte 0 is B Y SEL STA UP DN LT RT; byte 1 is
// A X L R. Joy0 is the "keyboard joystick": Enter is START, arrows are
// the D-pad (KEYCODE_ENTER / KEYCODE_*ARROW in that file's intab0).
// Joy1 and joy2 are the two SNES ports the catalog names; a pad whose
// presence byte is `$FF` is ignored so floating bits do not become
// presses.
//
//   - **left / right / up / down** — D-pad, keyboard or pad.
//   - **confirm** — START (Enter on the keyboard) or A.
//   - **cancel** — SELECT (left shift on the keyboard) or B.
//
// **`input.mouse` is true on this machine by default**, because the
// hardware really does have one. `HAS_MOUSE` is that fact, so on a future
// build that could take the mouse out the pointer half of this file is
// `if (false)` and the fold removes it. Today there is no such catalog option;
// the emulator's mouse is always there. Without a mouse this file still
// fetches PS/2 (`$FEAB`) so `kbd_scan` has a keycode to consume.
//
// **The pointer is reported in cells, not pixels.** `pointerCell()` is a
// flat cell index, the same number `text.print()` takes. The KERNAL's
// position is a pixel from the top-left of the *active area* — the same
// origin cell (0, 0) has after screen.8bs insets the display so VERA's
// border color has somewhere to show. An earlier draft subtracted that
// 16-pixel inset again, and the arrow sat two cells down-right of the
// cell `pointerCell()` named: mouse_get said (319, 239) and the sprite
// was on screen at (335, 254), which is (319, 239) plus the inset, so
// the KERNAL is already in the inset space. Shift down by the 8-pixel
// cell size; a pointer past the visible 76×56 clamps to the last cell.
import { mouse } from "./mouse.8bs";

const HAS_MOUSE: bool = #fact(input.mouse);

const COLUMNS: usmallint = #fact(video.columns);
const ROWS: usmallint = #fact(video.rows);
const CELL_SHIFT: utinyint = 3; // 8 pixels a cell

namespace Edge {
    const LEFT: utinyint = 1;
    const RIGHT: utinyint = 2;
    const UP: utinyint = 4;
    const DOWN: utinyint = 8;
    const CONFIRM: utinyint = 16;
    const CANCEL: utinyint = 32;
    const BUTTON: utinyint = 64;
}

// SNES / keyboard-joystick bits, active low. Same numbers as C_RT..C_B
// and C_A in kernal/drivers/x16/joystick.s.
namespace Snes {
    const RIGHT: utinyint = 1;
    const LEFT: utinyint = 2;
    const DOWN: utinyint = 4;
    const UP: utinyint = 8;
    const START: utinyint = 16;
    const SELECT: utinyint = 32;
    const B: utinyint = 128;
}

namespace SnesHi {
    const A: utinyint = 128;
}

// Scratch for joystick_get's A/X/Y. $80-$84 is the mouse buffer; $85-$87
// is the next three bytes of ZPKERNAL, which this poll owns under `sei`
// the same way ./mouse.8bs owns $80-$84.
@address(0x85)
let joyA: volatile<utinyint>;
@address(0x86)
let joyX: volatile<utinyint>;
@address(0x87)
let joyY: volatile<utinyint>;

let held: utinyint = 0;
let before: utinyint = 0;
let began: utinyint = 0;

let atCell: usmallint = 0;

// Pixel to a column or row on the visible grid: shift down by the cell
// size, clamp to the last cell. mouse_get's origin is the active area's
// top-left (see the header), so there is no inset to subtract.
function cellOn(pixel: usmallint, limit: usmallint): usmallint {
    let at: usmallint = pixel >> CELL_SHIFT;
    if (at >= limit) {
        return limit - 1;
    }
    return at;
}

// Active-low SNES bits into the portable held mask. START and A both
// confirm (Enter is START on joy0; a pad player's A is the reflex
// button, same as the NES layer). SELECT and B cancel.
function orSnes(lo: utinyint, hi: utinyint): void {
    if ((lo & Snes.LEFT) == 0) {
        held = held | Edge.LEFT;
    }
    if ((lo & Snes.RIGHT) == 0) {
        held = held | Edge.RIGHT;
    }
    if ((lo & Snes.UP) == 0) {
        held = held | Edge.UP;
    }
    if ((lo & Snes.DOWN) == 0) {
        held = held | Edge.DOWN;
    }
    if ((lo & Snes.START) == 0 || (hi & SnesHi.A) == 0) {
        held = held | Edge.CONFIRM;
    }
    if ((lo & Snes.SELECT) == 0 || (lo & Snes.B) == 0) {
        held = held | Edge.CANCEL;
    }
}

export namespace input {

    function begin(): void {
        if (HAS_MOUSE) {
            mouse.begin();
        }
        // One poll before the program's first, so the edge detector starts
        // from what is actually held rather than from nothing. `before` is
        // zero until something fills it, and an edge is "held now, not held
        // before" — so without this, anything already down when a program
        // starts reads as a fresh press on frame one. Measured on the
        // MEGA65, whose RETURN key is down at start-up: the joystick example
        // counted a confirm() nobody pressed until begin() primed this.
        input.poll();
    }

    // Once a frame, right after waitFrame(), and never twice.
    function poll(): void {
        if (HAS_MOUSE) {
            mouse.poll();
        } else {
            asm6502 {
                sei
                lda #8
                jsr $FEAB
            }
        }

        // IRQ is off: scan pads, then the keyboard (so joy0 sees Enter
        // and the arrows), then read joy0 always and joy1/joy2 if present.
        asm6502 {
            jsr $FF53
            jsr $FF9F
            lda #0
            jsr $FF56
            sta $85
            stx $86
            sty $87
        }
        let lo: utinyint = joyA;
        let hi: utinyint = joyX;
        asm6502 {
            lda #1
            jsr $FF56
            sta $85
            stx $86
            sty $87
        }
        if (joyY == 0) {
            lo = lo & joyA;
            hi = hi & joyX;
        }
        asm6502 {
            lda #2
            jsr $FF56
            sta $85
            stx $86
            sty $87
        }
        if (joyY == 0) {
            lo = lo & joyA;
            hi = hi & joyX;
        }

        before = held;
        held = 0;
        orSnes(lo, hi);

        if (HAS_MOUSE) {
            let column: usmallint = cellOn(mouse.x(), COLUMNS);
            let row: usmallint = cellOn(mouse.y(), ROWS);
            atCell = row * COLUMNS + column;
            if (mouse.left()) {
                held = held | Edge.BUTTON;
            }
        }

        began = held & (before ^ 0xFF);
    }

    function left(): bool {
        return (began & Edge.LEFT) != 0;
    }

    function right(): bool {
        return (began & Edge.RIGHT) != 0;
    }

    function up(): bool {
        return (began & Edge.UP) != 0;
    }

    function down(): bool {
        return (began & Edge.DOWN) != 0;
    }

    function confirm(): bool {
        return (began & Edge.CONFIRM) != 0;
    }

    function cancel(): bool {
        return (began & Edge.CANCEL) != 0;
    }

    function pointer(): bool {
        return HAS_MOUSE;
    }

    function pointerCell(): usmallint {
        return atCell;
    }

    function pointerButton(): bool {
        return (began & Edge.BUTTON) != 0;
    }
}

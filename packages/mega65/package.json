{
  "name": "@8bitscript/mega65",
  "version": "0.6.1",
  "description": "MEGA65 target support for 8BitScript: the hardware underneath the portable APIs. Parked in 0.2.0: not a build target until its native backend lands.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/8BitScript/8bitscript.git",
    "directory": "packages/mega65"
  },
  "8bitscript": {
    "entry": "./src/index.8bs",
    "exports": {
      "./screen": "./src/screen.8bs",
      "./text": "./src/text.8bs",
      "./input": "./src/input.8bs",
      "./pointer": "./src/pointer.8bs"
    },
    "hardware": {
      "build": {
        "defsym": {
          "__load_address": 8193,
          "__ram_ceiling": 53248
        }
      },
      "facts": {
        "video.columns": 80,
        "video.rows": 25,
        "video.cellWidth": 8,
        "video.cellHeight": 8,
        "video.palette": 256,
        "video.cellColors": 2,
        "video.colorPerCell": true,
        "video.glyphs": 256,
        "video.blockWidth": 2,
        "video.blockHeight": 2,
        "video.bitmap": true,
        "video.layers": 1,
        "video.scroll": true,
        "video.sprites": 8,
        "video.spritesPerLine": 8,
        "video.spriteWidth": 64,
        "video.spriteHeight": 255,
        "video.spriteColors": 15,
        "video.frameRate": 60,
        "audio.voices": 16,
        "audio.noise": true,
        "audio.envelope": true,
        "audio.filter": true,
        "audio.pcm": true,
        "audio.volume": true,
        "audio.entropy": true,
        "input.keyboard": true,
        "input.joysticks": 2,
        "input.pads": 0,
        "input.controls": [
          "up",
          "down",
          "left",
          "right",
          "a"
        ],
        "input.mouse": false,
        "input.paddles": false,
        "storage.save": true,
        "memory.ram": 45055,
        "memory.banked": true,
        "memory.bankedKib": 320,
        "storage.kib": 783
      },
      "options": {},
      "presets": {}
    }
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  }
}

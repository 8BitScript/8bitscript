// @8bitscript/mega65/text — the MEGA65's implementation of @8bitscript/text.
//
// Named by "8bitscript".exports["./text"] in this package's package.json,
// and what
//
//     import { text } from "@8bitscript/text";
//
// resolves to when the build is for the MEGA65. Built on the registers
// @8bitscript/mega65 exports. Every machine's text.8bs exports this same
// namespace — the same names, the same shapes, ASCII codes, and a cell 0
// at the top-left corner inside the border — so a program that imports it
// from @8bitscript/text draws the same thing on every target.
import { memoryPointer, vicIIIControlA, VicIIIControl } from "./index.8bs";

// The screen is addressed by flat cell index — a position is
// `y * text.COLUMNS + x` — and these are the plainest things a text API
// can be built from: poke one cell's character code, poke one cell's color, and how many
// cells the whole screen has. Whether a caller uses these to clear the
// screen, lay out a label, or nothing at all is entirely up to the caller —
// this package draws nothing on its own. mega65.h names the default screen
// character matrix directly: DEFAULT_SCREEN at $0800 — not the C64's $0400
// — and in the MEGA65 mode a build runs in, that screen is 80x25, 2000
// cells (LINESTEP 80, CHRCOUNT 80, H640 set: measured under xmega65, see
// AGENTS.md; an earlier version of this file drew for 40 columns and
// wrapped every second row onto the right half of the one above). Color
// RAM is at $D800 for cells 0-1023, and for cells 1024-1999 at
// $DC00-$DFCF only while $D030's CRAM2K bit is set — otherwise those
// addresses are the two CIAs — so prepare() sets that bit before a run.
//
// ---- character codes: ASCII in, screen codes out ----------------------------
//
// `text.putChar` takes ASCII on every machine — space (32), '0'-'9'
// (48-57), 'A'-'Z' (65-90) and the punctuation `! , - . : ?` — upper case
// only: that is the portable set, the characters every target's character
// set has (the NES ships its own font, and that is what it has). The
// hardware wants screen codes: in every Commodore character ROM, codes
// 32-63 are those same ASCII values (space, digits, that punctuation), and
// Which of the character ROM's two sets is live is not something to
// inherit — the ROM's boot state, whatever ran before, a user's SHIFT+C=
// would each give a different answer — so this package owns the choice.
// putChar() selects the **mixed-case** set, every call, through the memory
// pointer (see @8bitscript/mega65's `memoryPointer`): one register write.
//
// Mixed-case rather than upper-case/graphics, for the reason
// packages/pet/src/text.8bs gives at length and every Commodore here
// repeats: it is the only set holding both cases of the alphabet, so it is
// the only one that can draw `"Hello World"` as it was written rather than
// flattened to `HELLO WORLD`. This file used to argue the other way — that
// "TICK" should read as TICK the way it does on the NES, the Atari and the
// X16, none of which have a lower-case set to fall into — and the cost of
// that was measured under xmega65: hello-world drew `H`, four graphics
// blobs, ` W`, four more blobs, `!`, because lower-case ASCII passed
// straight through into the graphics range. $26 selecting the mixed-case
// set was measured the same way: screen codes 08 05 0C 0C 0F render as
// `hello` and 48 45 4C 4C 4F as `HELLO`.
namespace CharacterSet {
    const UPPERCASE_SCREEN_AT_0800: utinyint = 0x24;
    const MIXED_CASE_SCREEN_AT_0800: utinyint = 0x26; // the same screen, bit 1 selecting the other set
}

function asciiToScreenCode(code: utinyint): utinyint {
    // The mixed-case set keeps lower case at 1-26 and upper case at its own
    // ASCII values, 65-90 — the layout every Commodore character ROM in this
    // workspace shares, measured on each.
    if (code >= 97 && code < 123) {
        return code - 96; // 'a'-'z'
    }
    return code;
}

// ---- print: strings and number fields ------------------------------------
//
// `text.print(cell, s)` writes a string's characters into consecutive
// cells from `cell`, and `text.printNumber(cell, value, width)` writes
// `value` as exactly `width` decimal digits, zero-padded and right-aligned,
// so a field on a HUD never shifts columns. Both draw in the current color —
// white until `text.setColor(TextColor.CYAN)` changes it, and that one
// call then colors everything printed after it, on the machines that have
// per-cell color. They are also the two
// functions the compiler's template layout targets: `text.print(0,
// \`TICK ${ticks:1}\`)` is laid out at compile time into these same calls
// (see packages/compiler/src/ir).
//
// Under them: `place()` puts one character at one cell in the current
// color, and is all a run of text costs per character, with `prepare()` selecting the
// upper-case set once for the run.
// `text.putChar` and `text.putColor` stay the one-cell pokes a caller can
// build anything from.
let currentColor: utinyint = 1; // white, until text.setColor() says otherwise
let currentReverse: bool = false; // until text.setReverse() says otherwise

// Reverse video is bit 7 of the screen code, as on the C64. Color RAM's
// upper nibble is also an attribute field (blink, reverse) — keep it
// clear, and invert by the ROM copy instead.
function toScreen(code: utinyint): utinyint {
    let screen: utinyint = asciiToScreenCode(code);
    if (currentReverse) {
        screen = screen + 128;
    }
    return screen;
}

// What a run of text needs once, before its first character.
function prepare(): void {
    memoryPointer = CharacterSet.MIXED_CASE_SCREEN_AT_0800;
    vicIIIControlA = VicIIIControl.COLOR_RAM_2K;
}

// CRAM2K maps colour RAM's second KB over $DC00-$DFFF, which is where the
// two CIAs are. The 80-column screen's cells 1024-1999 need it, so a run of
// text turns it on — and has to turn it back off, which this file used not
// to do. Its own note said "the frame runtime polls $D012, not a CIA, so
// nothing here misses them", overlooking @8bitscript/mega65/input's poll()
// in the same package: with colour RAM in front of CIA1 it scans the
// keyboard matrix through colour cells and invents key presses out of
// whatever the screen happens to hold. Measured under xmega65 with an
// otherwise identical probe: no preceding text.print gave 0 presses, one
// text.print first gave a phantom LEFT and UP — which in 2048 slid the
// board and spawned a third tile before the player touched anything. Its
// writes went astray too, landing in colour cells 1024-1027.
//
// $44 is what start-up stores (VicIIIControl.STARTUP): the same bits
// without CRAM2K. Writing anything else here re-maps ROM over the program,
// which is why this restores a recorded value rather than clearing a bit.
function release(): void {
    vicIIIControlA = VicIIIControl.STARTUP;
}

function place(cell: usmallint, code: utinyint): void {
    memory.write(0x0800 + cell, toScreen(code));
    memory.write(0xD800 + cell, currentColor & 15); // the upper nibble is attributes (blink, reverse) — keep it clear
}

// ---- digits -------------------------------------------------------------
//
// A number is written one place at a time, high to low, by subtracting the
// place value until it no longer fits: the 6502 has no divide instruction,
// and `value / 10` would link a 250-byte routine to do it. Places above the
// field are still taken off, so a field narrower than its number shows the
// low digits; places the number does not reach print as zeros.
const DIGIT_PLACES: array<usmallint, 5> = [10000, 1000, 100, 10, 1];

export namespace text {
    const CELL_COUNT: usmallint = 2000; // 80 columns x 25 rows
    const COLUMNS: utinyint = 80; // cells per row, so cell = y * text.COLUMNS + x
    const ROWS: utinyint = 25;

    // The live grid. Fixed on this machine — its screen is the size its video
    // chip makes it — so both fold to the constants above and cost nothing.
    // Here so a program that lays itself out from the grid it is actually on
    // runs unchanged on every target; see the web target's Modern host, the
    // one grid that does change.
    function columns(): utinyint {
        return text.COLUMNS;
    }

    function rows(): utinyint {
        return text.ROWS;
    }


    function putChar(cell: usmallint, code: utinyint): void {
        prepare();
        memory.write(0x0800 + cell, toScreen(code));
        release();
    }

    function putColor(cell: usmallint, color: utinyint): void {
        vicIIIControlA = VicIIIControl.COLOR_RAM_2K; // cells past 1023 live behind CRAM2K
        memory.write(0xD800 + cell, color & 15);
        release();
    }

    function setColor(color: utinyint): void {
        currentColor = color;
    }

    function setReverse(on: bool): void {
        currentReverse = on;
    }

    // Tells the KERNAL screen editor the cursor is at the start of row 1,
    // through PLOT ($FFF0: carry clear, row in X, column in Y — the same
    // address cc65's cbm_kernal.inc gives for the whole C64-derived
    // family, mega65-tools/cc65/asminc/cbm_kernal.inc). print()/putChar()
    // write straight into screen memory, which the editor's own cursor
    // tracking never sees, so without this BASIC's next PRINT — READY.
    // included — lands wherever the cursor was before the program ran,
    // not under what the program just drew. Row 1, not 0: see
    // packages/vic20/src/text.8bs's own releaseCursor() for why.
    function releaseCursor(): void {
        asm6502 {
            ldx #1
            ldy #0
            clc
            jsr $FFF0
        }
    }

    function print(cell: usmallint, s: string): void {
        prepare();
        for (let i: utinyint = 0; i < s.length; i++) {
            place(cell + i, s[i]);
        }
        release();
    }

    // Writes `code` into `count` consecutive cells from `cell`, in the current
    // color. The run print() would write if a string of that width could be
    // built at run time — it cannot, so a layout whose width is only known
    // while the program runs (a responsive tile, a panel being cleared) needs
    // this instead of a string constant per possible width.
    //
    // prepare() is not optional here: place() writes colour at `$D800+cell`,
    // and without CRAM2K cells 1024–1999 are the two CIAs. A 5-cell reverse
    // fill on row 17 of the 80-column screen (2048's bottom tile row) lands
    // on a CIA2 PRA mirror, the VIC bank bits move, HOTREG then derives
    // CHARPTR from `$D018` in bank 2 (`$9800` instead of the mixed-case ROM
    // at `$1800`), and every glyph on the screen draws as the same junk
    // character. Measured under xmega65: dumpmem still had the right screen
    // codes at `$0800`; CHARPTR and `$DD00` were what moved.
    function fill(cell: usmallint, count: usmallint, code: utinyint): void {
        prepare();
        for (let i: usmallint = 0; i < count; i++) {
            place(cell + i, code);
        }
        release();
    }

    function printNumber(cell: usmallint, value: usmallint, width: utinyint): void {
        prepare();
        let k: utinyint = width;
        if (k < DIGIT_PLACES.length) {
            k = DIGIT_PLACES.length;
        }
        while (k > 0) {
            let digit: utinyint = 48; // '0'
            if (k <= DIGIT_PLACES.length) {
                while (value >= DIGIT_PLACES[DIGIT_PLACES.length - k]) {
                    value = value - DIGIT_PLACES[DIGIT_PLACES.length - k];
                    digit++;
                }
            }
            if (k <= width) {
                place(cell + width - k, digit);
            }
            k--;
        }
        release();
    }
}

// The colors `text.setColor()` takes: the eight names every machine
// shares, with this machine's color-RAM values.
export namespace TextColor {
    const BLACK: utinyint = 0;
    const WHITE: utinyint = 1;
    const RED: utinyint = 2;
    const CYAN: utinyint = 3;
    const PURPLE: utinyint = 4;
    const GREEN: utinyint = 5;
    const BLUE: utinyint = 6;
    const YELLOW: utinyint = 7;
}

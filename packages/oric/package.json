{
  "name": "@8bitscript/oric",
  "version": "0.23.0",
  "description": "Oric-1 / Atmos target support for 8BitScript: the hardware underneath the portable APIs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/8BitScript/8bitscript.git",
    "directory": "packages/oric"
  },
  "8bitscript": {
    "title": "Oric-1 / Atmos",
    "emulator": {
      "binary": "mame",
      "family": "mame",
      "screenshot": "mame",
      "framesUnit": "seconds",
      "defaultFrames": 8,
      "installer": "mame",
      "system": "oric1",
      "deferred": "MAME needs a ROM set this project does not ship",
      "slot": "cass"
    },
    "entry": "./src/index.8bs",
    "exports": {
      "./screen": "./src/screen.8bs",
      "./text": "./src/text.8bs",
      "./input": "./src/input.8bs",
      "./pointer": "./src/pointer.8bs",
      "./rasterline": "./src/rasterline.8bs"
    },
    "hardware": {
      "build": {
        "defsym": {
          "__load_address": 1280,
          "__ram_size": 48
        },
        "output": "tap",
        "mameSystem": "oric1"
      },
      "facts": {
        "video.columns": 40,
        "video.rows": 28,
        "video.cellWidth": 8,
        "video.cellHeight": 8,
        "video.palette": 8,
        "video.cellColors": 2,
        "video.colorPerCell": true,
        "video.glyphs": 0,
        "video.blockWidth": 0,
        "video.blockHeight": 0,
        "video.bitmap": false,
        "video.layers": 1,
        "video.scroll": false,
        "video.raster": false,
        "video.sprites": 0,
        "video.spritesPerLine": 0,
        "video.spriteWidth": 0,
        "video.spriteHeight": 0,
        "video.spriteColors": 0,
        "video.frameRate": 60,
        "audio.voices": 3,
        "audio.noise": true,
        "audio.envelope": false,
        "audio.filter": false,
        "audio.pcm": false,
        "audio.volume": false,
        "audio.entropy": false,
        "input.keyboard": true,
        "input.joysticks": 0,
        "input.pads": 0,
        "input.controls": [],
        "input.mouse": false,
        "input.paddles": false,
        "storage.save": false,
        "storage.kib": 0,
        "memory.ram": 49152,
        "memory.banked": false,
        "memory.bankedKib": 0
      },
      "options": {},
      "presets": {}
    }
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test"
  }
}

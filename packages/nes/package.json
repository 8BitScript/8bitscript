{
  "name": "@8bitscript/nes",
  "private": true,
  "version": "0.0.0",
  "description": "NES target support for 8BitScript: the hardware underneath the portable APIs.",
  "license": "MIT",
  "8bitscript": {
    "entry": "./src/index.8bs",
    "exports": {
      "./screen": "./src/screen.8bs",
      "./text": "./src/text.8bs"
    },
    "native": [
      "./native/6502/font.s"
    ],
    "hardware": {
      "options": {
        "mapper": {
          "label": "Cartridge board",
          "default": "nrom",
          "values": {
            "nrom": {
              "label": "NROM: 32K PRG, 8K CHR-ROM, no save",
              "build": {
                "driver": "mos-nes-nrom-clang",
                "output": "nes"
              },
              "facts": {
                "storage.save": false
              }
            }
          }
        }
      },
      "presets": {}
    }
  },
  "files": [
    "src",
    "native"
  ],
  "publishConfig": {
    "access": "public"
  }
}

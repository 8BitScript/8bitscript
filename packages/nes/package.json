{
  "name": "@8bitscript/nes",
  "private": true,
  "version": "0.0.0",
  "description": "NES target support for 8BitScript: the hardware underneath the portable APIs.",
  "license": "MIT",
  "8bitscript": {
    "entry": "./src/index.8bs",
    "exports": {
      "./screen": "./src/screen.8bs",
      "./text": "./src/text.8bs",
      "./pad": "./src/pad.8bs",
      "./input": "./src/input.8bs",
      "./pointer": "./src/pointer.8bs"
    },
    "native": [
      "./native/6502/font.s"
    ],
    "hardware": {
      "facts": {
        "video.columns": 28,
        "video.rows": 26,
        "video.cellWidth": 8,
        "video.cellHeight": 8,
        "video.palette": 25,
        "video.cellColors": 3,
        "video.colorPerCell": false,
        "video.glyphs": 0,
        "video.blockWidth": 0,
        "video.blockHeight": 0,
        "video.bitmap": false,
        "video.layers": 1,
        "video.scroll": true,
        "video.sprites": 64,
        "video.spritesPerLine": 8,
        "video.spriteWidth": 8,
        "video.spriteHeight": 16,
        "video.spriteColors": 3,
        "video.frameRate": 60,
        "audio.voices": 5,
        "audio.noise": true,
        "audio.envelope": true,
        "audio.filter": false,
        "audio.pcm": true,
        "audio.volume": true,
        "audio.entropy": false,
        "input.keyboard": false,
        "input.joysticks": 0,
        "input.pads": 2,
        "input.mouse": false,
        "input.paddles": false,
        "storage.save": false,
        "memory.ram": 1536,
        "memory.banked": false,
        "memory.bankedKib": 0,
        "storage.kib": 0
      },
      "options": {
        "mapper": {
          "label": "Cartridge board",
          "default": "nrom",
          "values": {
            "nrom": {
              "label": "NROM: 32K PRG, 8K CHR-ROM, no save",
              "build": {
                "driver": "mos-nes-nrom-clang",
                "output": "nes"
              },
              "facts": {
                "storage.save": false
              }
            }
          }
        }
      },
      "presets": {}
    }
  },
  "files": [
    "src",
    "native"
  ],
  "publishConfig": {
    "access": "public"
  }
}

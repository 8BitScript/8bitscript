// @8bitscript/audio on the C64: the song drives SID. A sample is the
// declared synth fallback (not a $D418 digi).
import { sid, Waveform } from "@8bitscript/c64/sid";

const MAX: utinyint = 4;
const DATA_MAX: utinyint = 64;
let sfx: array<u8, 64>;
let song: array<u8, 64>;
let sfxLen: array<u8, 4>;
let songLen: array<u8, 4>;
let playing: utinyint = 255;
let row: utinyint = 0;
let tick: utinyint = 0;
let sfxLeft: utinyint = 0;
let ready: bool = false;

function waveOf(code: utinyint): utinyint {
    if (code == 1) {
        return Waveform.NOISE;
    }
    if (code == 2) {
        return Waveform.TRIANGLE;
    }
    if (code == 3) {
        return Waveform.SAWTOOTH;
    }
    return Waveform.PULSE;
}

function eventAt(dataBase: utinyint, length: utinyint, atRow: utinyint, field: utinyint): utinyint {
    // bytes 0..3 header; each event 4 bytes: row, note, wave, voice
    let count: utinyint = song[dataBase + 3];
    let i: utinyint = 0;
    let off: utinyint = dataBase + 4;
    while (i < count) {
        if (off + 3 >= dataBase + length) {
            return 255;
        }
        if (song[off] == atRow) {
            return song[off + field];
        }
        off = off + 4;
        i = i + 1;
    }
    return 255;
}

export namespace audio {
    function bind(kind: utinyint, slot: utinyint, index: utinyint, value: utinyint): void {
        if (slot != 0 || index >= DATA_MAX) {
            return;
        }
        if (kind == 0) {
            sfx[index] = value;
        } else {
            song[index] = value;
        }
    }

    function meta(kind: utinyint, slot: utinyint, length: utinyint, a: utinyint, b: utinyint, c: utinyint): void {
        if (slot != 0) {
            return;
        }
        if (kind == 0) {
            sfxLen[slot] = length;
        } else {
            songLen[slot] = length;
        }
        if (!ready) {
            sid.setVolume(15);
            sid.setEnvelope(0, 0, 9, 8, 6);
            sid.setPulseWidth(0, 2048);
            ready = true;
        }
    }

    function play(slot: utinyint): void {
        if (sfxLen[slot] < 2) {
            return;
        }
        sid.setWaveform(0, waveOf(sfx[0]));
        sid.play(0, sfx[1]);
        sfxLeft = 8;
    }

    function music(slot: utinyint): void {
        playing = slot;
        row = 0;
        tick = 0;
    }

    function update(): void {
        if (sfxLeft != 0) {
            sfxLeft = sfxLeft - 1;
            if (sfxLeft == 0) {
                sid.release(0);
            }
            return;
        }
        if (playing == 255 || songLen[0] < 4) {
            return;
        }
        let speed: utinyint = song[1];
        if (speed == 0) {
            speed = 6;
        }
        tick = tick + 1;
        if (tick < speed) {
            return;
        }
        tick = 0;
        let length: utinyint = song[2];
        if (length == 0) {
            length = 16;
        }
        let note: utinyint = eventAt(0, songLen[0], row, 1);
        if (note != 255) {
            let wave: utinyint = eventAt(0, songLen[0], row, 2);
            sid.setWaveform(0, waveOf(wave));
            sid.play(0, note);
        }
        row = row + 1;
        if (row >= length) {
            row = 0;
        }
    }
}

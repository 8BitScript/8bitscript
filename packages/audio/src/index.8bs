// @8bitscript/audio — play a sample or song compiled from a .8ba file.
//
//     import { blip, theme } from "./theme.8ba";
//     import { audio } from "@8bitscript/audio";
//     audio.play(blip);
//     audio.music(theme);
//     audio.update();
//
// This file is the no-driver path: bind/meta keep the handles valid, play
// and music do nothing. A machine with a chip replaces this file.
const MAX: utinyint = 4;
let sfxLen: array<u8, 4>;
let songLen: array<u8, 4>;

export namespace audio {
    // The playable notes (the .8ba index, C0 = 0, A4 = 57): none here, so a
    // program can fold its sounds away on `audio.NOTE_HIGH == 0`.
    const NOTE_LOW: utinyint = 0;
    const NOTE_HIGH: utinyint = 0;

    // A single tone for `frames` calls of update() and its silence: both do
    // nothing on a machine with no driver.
    function tone(note: utinyint, frames: utinyint): void {
    }

    function silence(): void {
    }

    // True while something is sounding: nothing ever is here.
    function busy(): bool {
        return false;
    }

    // The loudest level `setLevel` takes, 0 (silent) to LEVEL_MAX. 0 here: a
    // machine with no driver has nothing to turn down, and both calls below do
    // nothing, so a portable program folds its volume handling away.
    const LEVEL_MAX: utinyint = 0;

    function setLevel(level: utinyint): void {
    }

    // A plucked tone: it starts at the level and dies away within `frames`.
    function blip(note: utinyint, frames: utinyint): void {
    }

    function bind(kind: utinyint, slot: utinyint, index: utinyint, value: utinyint): void {
    }

    function meta(kind: utinyint, slot: utinyint, length: utinyint, a: utinyint, b: utinyint, c: utinyint): void {
        if (kind == 0 && slot < MAX) {
            sfxLen[slot] = length;
        }
        if (kind == 1 && slot < MAX) {
            songLen[slot] = length;
        }
    }

    function play(slot: utinyint): void {
    }

    function music(slot: utinyint): void {
    }

    function update(): void {
    }
}

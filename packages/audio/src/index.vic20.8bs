// @8bitscript/audio on the VIC-20: three squares plus noise. One volume.
import { sound } from "@8bitscript/vic20/sound";

const DATA_MAX: utinyint = 64;
let sfx: array<u8, 64>;
let song: array<u8, 64>;
let sfxLen: array<u8, 4>;
let songLen: array<u8, 4>;
let playing: utinyint = 255;
let row: utinyint = 0;
let tick: utinyint = 0;
let sfxLeft: utinyint = 0;

const TONE: array<u8, 24> = [
    127, 120, 113, 107, 101, 95, 90, 85, 80, 76, 72, 68,
    64, 61, 57, 54, 51, 48, 45, 43, 40, 38, 36, 34,
];

function periodOf(note: utinyint): utinyint {
    let n: utinyint = note;
    if (n < 36) {
        n = 36;
    }
    n = n - 36;
    if (n >= 24) {
        n = 23;
    }
    return TONE[n];
}

function voiceOf(code: utinyint): utinyint {
    if (code == 1) {
        return 3;
    }
    if (code == 2) {
        return 1;
    }
    if (code == 3) {
        return 2;
    }
    return 0;
}

function eventAt(atRow: utinyint, field: utinyint): utinyint {
    let count: utinyint = song[3];
    let i: utinyint = 0;
    let off: utinyint = 4;
    while (i < count) {
        if (song[off] == atRow) {
            return song[off + field];
        }
        off = off + 4;
        i = i + 1;
    }
    return 255;
}

export namespace audio {
    function bind(kind: utinyint, slot: utinyint, index: utinyint, value: utinyint): void {
        if (slot != 0 || index >= DATA_MAX) {
            return;
        }
        if (kind == 0) {
            sfx[index] = value;
        } else {
            song[index] = value;
        }
    }

    function meta(kind: utinyint, slot: utinyint, length: utinyint, a: utinyint, b: utinyint, c: utinyint): void {
        if (slot != 0) {
            return;
        }
        if (kind == 0) {
            sfxLen[slot] = length;
        } else {
            songLen[slot] = length;
        }
        sound.volume(15);
    }

    function play(slot: utinyint): void {
        if (sfxLen[slot] < 2) {
            return;
        }
        let v: utinyint = voiceOf(sfx[0]);
        sound.tone(v, periodOf(sfx[1]));
        sfxLeft = 8;
    }

    function music(slot: utinyint): void {
        playing = slot;
        row = 0;
        tick = 0;
    }

    function update(): void {
        if (sfxLeft != 0) {
            sfxLeft = sfxLeft - 1;
            if (sfxLeft == 0) {
                sound.quiet();
            }
            return;
        }
        if (playing == 255 || songLen[0] < 4) {
            return;
        }
        let speed: utinyint = song[1];
        if (speed == 0) {
            speed = 6;
        }
        tick = tick + 1;
        if (tick < speed) {
            return;
        }
        tick = 0;
        let note: utinyint = eventAt(row, 1);
        if (note != 255) {
            let v: utinyint = voiceOf(eventAt(row, 2));
            sound.tone(v, periodOf(note));
        } else {
            sound.quiet();
        }
        row = row + 1;
        if (row >= song[2]) {
            row = 0;
        }
    }
}

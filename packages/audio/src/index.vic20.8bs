// @8bitscript/audio on the VIC-20: three squares plus noise. One volume. A song plays on the
// soprano (or the noise voice for a noise note); songs.8bs holds the bank and the sequencer.
import { sound } from "@8bitscript/vic20/sound";
import { songs } from "./songs.8bs";

let sfxLeft: utinyint = 0;
// The frames a song note has left to sound (0: it holds for its rows).
let decayLeft: utinyint = 0;
let ready: bool = false;

// The soprano voice's 7-bit divisor for the .8ba notes C3..B5 (index 36..71,
// C0 = 0, A4 = 57). The soprano is the finest of the three squares: its
// frequency is Φ2 / (64 · divisor), at NTSC's 1,022,727 Hz, so every note
// in this range lands within 50 cents and the lower two octaves within 25.
// (The bass and alto voices are 4× and 2× coarser for the same pitch.) The
// divisor falls below 16 above B5 and the pitch error grows past a
// quarter-tone, so that is where the range stops. A PAL machine's clock is
// 8% faster, so every note plays about a semitone and a half sharp there:
// the table is the NTSC one.
const DIVISOR: array<u8, 36> = [
    122, 115, 109, 103, 97, 92, 86, 82, 77, 73, 69, 65,
    61, 58, 54, 51, 48, 46, 43, 41, 38, 36, 34, 32,
    31, 29, 27, 26, 24, 23, 22, 20, 19, 18, 17, 16,
];

// Notes outside C3..B5 move by whole octaves into it: the pitch class
// survives, the octave does not.
function periodOf(note: utinyint): utinyint {
    let n: utinyint = note;
    while (n < 36) {
        n = n + 12;
    }
    while (n > 71) {
        n = n - 12;
    }
    return DIVISOR[n - 36];
}

// The volume the game asked for (0..15), the volume sounding now, and how much
// a plucked tone loses a frame (0 for a plain tone).
let level: utinyint = 15;
let shown: utinyint = 15;
let fade: utinyint = 0;

function ensure(): void {
    if (!ready) {
        sound.volume(level);
        ready = true;
    }
}

// Noise is the fourth channel; every pitched waveform plays on the soprano (voice 2), whose
// divisor is the finest. The VIC's three tones are all squares, so triangle and saw are the same
// square here.
function voiceOf(code: utinyint): utinyint {
    if (code == 1) {
        return 3;
    }
    return 2;
}

// The volume a note of `vol` (0..15) plays at under the game's level: level * vol / 16, rounded up.
function scaled(vol: utinyint): utinyint {
    let product: utinyint = level * vol;
    return (product + 15) >> 4;
}

// How much a note of `volume` loses a frame to be gone in `frames`: volume / frames, rounded up.
function stepOf(volume: utinyint, frames: utinyint): utinyint {
    let rest: utinyint = volume;
    let step: utinyint = 0;
    while (rest > 0) {
        step = step + 1;
        if (rest > frames) {
            rest = rest - frames;
        } else {
            rest = 0;
        }
    }
    return step;
}

// Start the note the sequencer says begins: the volume is the chip's one volume, so it is set
// for the note; a note with a decay is walked down by update().
function startNote(): void {
    ensure();
    let vol: utinyint = scaled(songs.volume());
    sound.quiet();
    shown = vol;
    sound.volume(vol);
    sound.tone(voiceOf(songs.wave()), periodOf(songs.note()));
    fade = 0;
    decayLeft = songs.decay();
    if (decayLeft != 0) {
        fade = stepOf(vol, decayLeft);
    }
}

// Do what the sequencer says.
function apply(event: utinyint): void {
    if (event == 1) {
        startNote();
    } else if (event == 2) {
        sound.quiet();
        decayLeft = 0;
        fade = 0;
    } else if (event == 3) {
        sound.quiet();
        decayLeft = 0;
        fade = 0;
        shown = level;
        sound.volume(level);
    }
}

export namespace audio {
    // The playable notes (the .8ba index, C0 = 0, A4 = 57): C3..B5, where
    // the soprano's 7-bit divisor keeps the pitch within half a semitone.
    const NOTE_LOW: utinyint = 36;
    const NOTE_HIGH: utinyint = 71;

    function bind(kind: utinyint, slot: utinyint, index: utinyint, value: utinyint): void {
        songs.bind(kind, slot, index, value);
    }

    function meta(kind: utinyint, slot: utinyint, length: utinyint, a: utinyint, b: utinyint, c: utinyint): void {
        songs.meta(kind, slot, length);
        ensure();
    }

    // One tone on the soprano for `frames` calls of update(), then quiet.
    // Replaces whatever tone is sounding. Nothing blocks.
    function tone(note: utinyint, frames: utinyint): void {
        ensure();
        songs.stop();
        decayLeft = 0;
        fade = 0;
        shown = level;
        sound.volume(level);
        sound.tone(2, periodOf(note));
        sfxLeft = frames;
        if (frames == 0) {
            sfxLeft = 1;
        }
    }

    // Stop now: the tone, the sample and the song, and put the volume back.
    function silence(): void {
        songs.stop();
        sound.quiet();
        sfxLeft = 0;
        fade = 0;
        decayLeft = 0;
        shown = level;
        if (ready) {
            sound.volume(level);
        }
    }

    // True while a tone, a sample or a song is sounding (a song's rests count).
    function busy(): bool {
        return sfxLeft != 0 || songs.active();
    }

    // The VIC-I has one volume, 0 (silent) to 15 for every voice; a level above
    // the maximum is the maximum.
    const LEVEL_MAX: utinyint = 15;

    function setLevel(amount: utinyint): void {
        level = amount;
        if (level > 15) {
            level = 15;
        }
        shown = level;
        fade = 0;
        ensure();
        sound.volume(level);
    }

    // A plucked tone: the chip has no envelope, so the volume is walked down a
    // step a frame (in update) until it reaches 0 on the last frame.
    function blip(note: utinyint, frames: utinyint): void {
        ensure();
        songs.stop();
        decayLeft = 0;
        let span: utinyint = frames;
        if (span == 0) {
            span = 1;
        }
        let rest: utinyint = level;
        fade = 0;
        while (rest > 0) {
            fade = fade + 1;
            if (rest > span) {
                rest = rest - span;
            } else {
                rest = 0;
            }
        }
        shown = level;
        sound.volume(level);
        sound.tone(2, periodOf(note));
        sfxLeft = span;
    }

    // A sample plays its fallback note for eight frames; a song plays once, from its start to its
    // last row, and is silent after. A new sound replaces whatever is sounding.
    function play(slot: utinyint): void {
        if (songs.isSong(slot)) {
            ensure();
            sfxLeft = 0;
            apply(songs.start(slot, false));
            return;
        }
        if (!songs.isSample(slot)) {
            return;
        }
        ensure();
        songs.stop();
        decayLeft = 0;
        fade = 0;
        shown = level;
        sound.volume(level);
        sound.tone(voiceOf(songs.sampleWave(slot)), periodOf(songs.sampleNote(slot)));
        sfxLeft = 8;
    }

    // A song, repeated for ever if its file says `loop true` (the default), until the next sound
    // or audio.silence().
    function music(slot: utinyint): void {
        ensure();
        sfxLeft = 0;
        apply(songs.start(slot, true));
    }

    function update(): void {
        if (sfxLeft != 0) {
            sfxLeft = sfxLeft - 1;
            if (sfxLeft == 0) {
                sound.quiet();
                fade = 0;
                shown = level;
                sound.volume(level);
            } else if (fade != 0) {
                if (shown > fade) {
                    shown = shown - fade;
                } else {
                    shown = 0;
                }
                sound.volume(shown);
            }
            return;
        }
        if (songs.active()) {
            if (decayLeft != 0) {
                decayLeft = decayLeft - 1;
                if (decayLeft == 0) {
                    sound.quiet();
                    fade = 0;
                } else if (fade != 0) {
                    if (shown > fade) {
                        shown = shown - fade;
                    } else {
                        shown = 0;
                    }
                    sound.volume(shown);
                }
            }
            apply(songs.step());
        }
    }
}

// @8bitscript/audio on the NES: pulse + noise through the APU driver.
use @8bitscript::nes::apu::apu;

const DATA_MAX: utinyint = 64;
let mut sfx: [u8; 64];
let mut song: [u8; 64];
let mut sfxLen: [u8; 4];
let mut songLen: [u8; 4];
let mut playing: utinyint = 255;
let mut row: utinyint = 0;
let mut tick: utinyint = 0;
let mut sfxLeft: utinyint = 0;

// Pulse timer for notes C3..B5 (36..71). NTSC: 1789773/(16*f) - 1.
const PULSE: [u16; 36] = [
    854, 806, 761, 718, 678, 640, 604, 570, 538, 508, 479, 452,
    427, 403, 380, 359, 339, 320, 302, 285, 269, 254, 239, 226,
    213, 201, 190, 179, 169, 159, 150, 142, 134, 127, 119, 113,
];

fn periodOf(note: utinyint) -> usmallint {
    let mut n: utinyint = note;
    if n < 36 {
        n = 36;
    }
    n = n - 36;
    if n >= 36 {
        n = 35;
    }
    return PULSE[n];
}

fn eventAt(atRow: utinyint, field: utinyint) -> utinyint {
    let count: utinyint = song[3];
    let mut i: utinyint = 0;
    let mut off: utinyint = 4;
    while i < count {
        if song[off] == atRow {
            return song[off + field];
        }
        off = off + 4;
        i = i + 1;
    }
    return 255;
}

fn voice(wave: utinyint, note: utinyint) {
    if wave == 1 {
        apu::noise(note & 15, 8);
    } else {
        apu::pulse(periodOf(note), 8, 2);
    }
}

pub mod audio {
    // audio.tone is not written for the APU yet: no playable notes, and the
    // calls do nothing. The machine is parked in this release; the contract
    // (packages/audio/AGENTS.md) is that a portable program still links.
    const NOTE_LOW: utinyint = 0;
    const NOTE_HIGH: utinyint = 0;

    fn tone(note: utinyint, frames: utinyint) {
    }

    fn silence() {
    }

    // True while something is sounding: nothing ever is here.
    fn busy() -> bool {
        return false;
    }

    // The loudest level `setLevel` takes, 0 (silent) to LEVEL_MAX. 0 here: a
    // machine with no driver has nothing to turn down, and both calls below do
    // nothing, so a portable program folds its volume handling away.
    const LEVEL_MAX: utinyint = 0;

    fn setLevel(level: utinyint) {
    }

    // A plucked tone: it starts at the level and dies away within `frames`.
    fn blip(note: utinyint, frames: utinyint) {
    }

    fn bind(kind: utinyint, slot: utinyint, index: utinyint, value: utinyint) {
        if slot != 0 || index >= DATA_MAX {
            return;
        }
        if kind == 0 {
            sfx[index] = value;
        } else {
            song[index] = value;
        }
    }

    fn meta(kind: utinyint, slot: utinyint, length: utinyint, a: utinyint, b: utinyint, c: utinyint) {
        if slot != 0 {
            return;
        }
        if kind == 0 {
            sfxLen[slot] = length;
        } else {
            songLen[slot] = length;
        }
    }

    fn play(slot: utinyint) {
        if sfxLen[slot] < 2 {
            return;
        }
        if sfx[0] == 255 {
            voice(1, 8);
        } else {
            voice(sfx[0], sfx[1]);
        }
        sfxLeft = 8;
    }

    fn music(slot: utinyint) {
        playing = slot;
        row = 0;
        tick = 0;
    }

    fn update() {
        if sfxLeft != 0 {
            sfxLeft = sfxLeft - 1;
            if sfxLeft == 0 {
                apu::silence();
            }
            return;
        }
        if playing == 255 || songLen[0] < 4 {
            return;
        }
        let mut speed: utinyint = song[1];
        if speed == 0 {
            speed = 6;
        }
        tick = tick + 1;
        if tick < speed {
            return;
        }
        tick = 0;
        let mut length: utinyint = song[2];
        if length == 0 {
            length = 16;
        }
        let note: utinyint = eventAt(row, 1);
        if note != 255 {
            voice(eventAt(row, 2), note);
        }
        row = row + 1;
        if row >= length {
            row = 0;
        }
    }
}

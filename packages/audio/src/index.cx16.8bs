// @8bitscript/audio on the CX16: VERA PSG voices via @8bitscript/cx16/psg. A song plays on PSG
// voice 0; songs.8bs holds the bank and the sequencer.
import { psg } from "@8bitscript/cx16/psg";
import { songs } from "./songs.8bs";

let sfxLeft: utinyint = 0;
// True once the program has asked for a song (audio.play or audio.music of one). Nothing but
// those two calls assigns it, so in a program that never plays a song the linker's optimizer
// inlines it as false, every `songsOn` test below folds away, and the sequencer and its 256-byte
// bank are not linked at all: a program that only plays tones pays nothing for songs.
let songsOn: bool = false;
// The frames a song note has left to sound (0: it holds for its rows).
let decayLeft: utinyint = 0;
let ready: bool = false;

function waveOf(code: utinyint): utinyint {
    if (code == 1) {
        return 3;
    }
    if (code == 2) {
        return 2;
    }
    if (code == 3) {
        return 1;
    }
    return 0;
}

// The volume the game asked for (0..15), the volume sounding now, and how much
// a plucked tone loses a frame (0 for a plain tone).
let level: utinyint = 15;
let shown: utinyint = 15;
let fade: utinyint = 0;

function ensure(): void {
    if (!ready) {
        psg.reset();
        ready = true;
    }
}

// The volume a note of `vol` (0..15) plays at under the game's level: level * vol / 16, rounded up.
function scaled(vol: utinyint): utinyint {
    let product: utinyint = level * vol;
    return (product + 15) >> 4;
}

// How much a note of `volume` loses a frame to be gone in `frames`: volume / frames, rounded up.
function stepOf(volume: utinyint, frames: utinyint): utinyint {
    let rest: utinyint = volume;
    let step: utinyint = 0;
    while (rest > 0) {
        step = step + 1;
        if (rest > frames) {
            rest = rest - frames;
        } else {
            rest = 0;
        }
    }
    return step;
}

// Start the note the sequencer says begins; a note with a decay is walked down by update().
function startNote(): void {
    ensure();
    let vol: utinyint = scaled(songs.volume());
    shown = vol;
    psg.play(0, songs.note(), waveOf(songs.wave()), vol);
    fade = 0;
    decayLeft = songs.decay();
    if (decayLeft != 0) {
        fade = stepOf(vol, decayLeft);
    }
}

// Do what the sequencer says.
function apply(event: utinyint): void {
    if (event == 1) {
        startNote();
    } else if (event == 2 || event == 3) {
        psg.silence(0);
        decayLeft = 0;
        fade = 0;
        shown = level;
    }
}

// One frame of a song that is playing: a note's decay, then the sequencer's next step.
function songFrame(): void {
    if (!songs.active()) {
        return;
    }
    if (decayLeft != 0) {
        decayLeft = decayLeft - 1;
        if (decayLeft == 0) {
            psg.silence(0);
            fade = 0;
        } else if (fade != 0) {
            if (shown > fade) {
                shown = shown - fade;
            } else {
                shown = 0;
            }
            psg.setVolume(0, shown);
        }
    }
    apply(songs.step());
}

export namespace audio {
    // The playable notes (the .8ba index, C0 = 0, A4 = 57): VERA's PSG
    // table is C3..B7. A note outside moves by whole octaves into it.
    const NOTE_LOW: utinyint = 36;
    const NOTE_HIGH: utinyint = 95;

    function bind(kind: utinyint, slot: utinyint, index: utinyint, value: utinyint): void {
        songs.bind(kind, slot, index, value);
    }

    function meta(kind: utinyint, slot: utinyint, length: utinyint, a: utinyint, b: utinyint, c: utinyint): void {
        songs.meta(kind, slot, length);
        ensure();
    }

    // One square-wave tone on voice 0 for `frames` calls of update(), then
    // silence. Replaces whatever tone is sounding. Nothing blocks.
    function tone(note: utinyint, frames: utinyint): void {
        ensure();
        if (songsOn) {
            songs.stop();
        }
        decayLeft = 0;
        fade = 0;
        shown = level;
        psg.play(0, note, 0, level);
        sfxLeft = frames;
        if (frames == 0) {
            sfxLeft = 1;
        }
    }

    // Stop now: the tone, the sample and the song.
    function silence(): void {
        if (songsOn) {
            songs.stop();
        }
        if (ready) {
            psg.silence(0);
        }
        sfxLeft = 0;
        fade = 0;
        decayLeft = 0;
        shown = level;
    }

    // True while a tone, a sample or a song is sounding (a song's rests count).
    function busy(): bool {
        if (sfxLeft != 0) {
            return true;
        }
        if (songsOn) {
            return songs.active();
        }
        return false;
    }

    // The PSG's volume is 64 steps; the portable level is 16 of them, 0 (silent)
    // to 15. A level above the maximum is the maximum.
    const LEVEL_MAX: utinyint = 15;

    function setLevel(amount: utinyint): void {
        level = amount;
        if (level > 15) {
            level = 15;
        }
        shown = level;
        fade = 0;
    }

    // A plucked tone: the PSG has no envelope, so the voice's volume is walked
    // down a step a frame (in update) until it reaches 0 on the last frame.
    function blip(note: utinyint, frames: utinyint): void {
        ensure();
        if (songsOn) {
            songs.stop();
        }
        decayLeft = 0;
        let span: utinyint = frames;
        if (span == 0) {
            span = 1;
        }
        let rest: utinyint = level;
        fade = 0;
        while (rest > 0) {
            fade = fade + 1;
            if (rest > span) {
                rest = rest - span;
            } else {
                rest = 0;
            }
        }
        shown = level;
        psg.play(0, note, 0, level);
        sfxLeft = span;
    }

    // A sample plays its fallback note for eight frames; a song plays once, from its start to its
    // last row, and is silent after. A new sound replaces whatever is sounding.
    function play(slot: utinyint): void {
        if (songs.isSong(slot)) {
            songsOn = true;
            ensure();
            sfxLeft = 0;
            apply(songs.start(slot, false));
            return;
        }
        if (!songs.isSample(slot)) {
            return;
        }
        ensure();
        if (songsOn) {
            songs.stop();
        }
        decayLeft = 0;
        fade = 0;
        shown = level;
        psg.play(0, songs.sampleNote(slot), waveOf(songs.sampleWave(slot)), level);
        sfxLeft = 8;
    }

    // A song, repeated for ever if its file says `loop true` (the default), until the next sound
    // or audio.silence().
    function music(slot: utinyint): void {
        songsOn = true;
        ensure();
        sfxLeft = 0;
        apply(songs.start(slot, true));
    }

    function update(): void {
        if (sfxLeft != 0) {
            sfxLeft = sfxLeft - 1;
            if (sfxLeft == 0) {
                psg.silence(0);
                fade = 0;
            } else if (fade != 0) {
                if (shown > fade) {
                    shown = shown - fade;
                } else {
                    shown = 0;
                }
                psg.setVolume(0, shown);
            }
            return;
        }
        if (songsOn) {
            songFrame();
        }
    }
}

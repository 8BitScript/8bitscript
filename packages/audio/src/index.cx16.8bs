// @8bitscript/audio on the CX16: VERA PSG voices via @8bitscript/cx16/psg.
import { psg } from "@8bitscript/cx16/psg";

const DATA_MAX: utinyint = 64;
let sfx: array<u8, 64>;
let song: array<u8, 64>;
let sfxLen: array<u8, 4>;
let songLen: array<u8, 4>;
let playing: utinyint = 255;
let row: utinyint = 0;
let tick: utinyint = 0;
let sfxLeft: utinyint = 0;
let ready: bool = false;

function waveOf(code: utinyint): utinyint {
    if (code == 1) {
        return 3;
    }
    if (code == 2) {
        return 2;
    }
    if (code == 3) {
        return 1;
    }
    return 0;
}

// The volume the game asked for (0..15), the volume sounding now, and how much
// a plucked tone loses a frame (0 for a plain tone).
let level: utinyint = 15;
let shown: utinyint = 15;
let fade: utinyint = 0;

function ensure(): void {
    if (!ready) {
        psg.reset();
        ready = true;
    }
}

function eventAt(atRow: utinyint, field: utinyint): utinyint {
    let count: utinyint = song[3];
    let i: utinyint = 0;
    let off: utinyint = 4;
    while (i < count) {
        if (song[off] == atRow) {
            return song[off + field];
        }
        off = off + 4;
        i = i + 1;
    }
    return 255;
}

export namespace audio {
    // The playable notes (the .8ba index, C0 = 0, A4 = 57): VERA's PSG
    // table is C3..B7. A note outside moves by whole octaves into it.
    const NOTE_LOW: utinyint = 36;
    const NOTE_HIGH: utinyint = 95;

    function bind(kind: utinyint, slot: utinyint, index: utinyint, value: utinyint): void {
        if (slot != 0 || index >= DATA_MAX) {
            return;
        }
        if (kind == 0) {
            sfx[index] = value;
        } else {
            song[index] = value;
        }
    }

    function meta(kind: utinyint, slot: utinyint, length: utinyint, a: utinyint, b: utinyint, c: utinyint): void {
        if (slot != 0) {
            return;
        }
        if (kind == 0) {
            sfxLen[slot] = length;
        } else {
            songLen[slot] = length;
        }
        ensure();
    }

    function play(slot: utinyint): void {
        if (sfxLen[slot] < 2) {
            return;
        }
        psg.play(0, sfx[1], waveOf(sfx[0]), level);
        sfxLeft = 8;
    }

    // One square-wave tone on voice 0 for `frames` calls of update(), then
    // silence. Replaces whatever tone is sounding. Nothing blocks.
    function tone(note: utinyint, frames: utinyint): void {
        ensure();
        fade = 0;
        shown = level;
        psg.play(0, note, 0, level);
        sfxLeft = frames;
        if (frames == 0) {
            sfxLeft = 1;
        }
    }

    function silence(): void {
        if (ready) {
            psg.silence(0);
        }
        sfxLeft = 0;
        fade = 0;
    }

    // The PSG's volume is 64 steps; the portable level is 16 of them, 0 (silent)
    // to 15. A level above the maximum is the maximum.
    const LEVEL_MAX: utinyint = 15;

    function setLevel(amount: utinyint): void {
        level = amount;
        if (level > 15) {
            level = 15;
        }
        shown = level;
        fade = 0;
    }

    // A plucked tone: the PSG has no envelope, so the voice's volume is walked
    // down a step a frame (in update) until it reaches 0 on the last frame.
    function blip(note: utinyint, frames: utinyint): void {
        ensure();
        let span: utinyint = frames;
        if (span == 0) {
            span = 1;
        }
        let rest: utinyint = level;
        fade = 0;
        while (rest > 0) {
            fade = fade + 1;
            if (rest > span) {
                rest = rest - span;
            } else {
                rest = 0;
            }
        }
        shown = level;
        psg.play(0, note, 0, level);
        sfxLeft = span;
    }

    function music(slot: utinyint): void {
        playing = slot;
        row = 0;
        tick = 0;
    }

    function update(): void {
        if (sfxLeft != 0) {
            sfxLeft = sfxLeft - 1;
            if (sfxLeft == 0) {
                psg.silence(0);
                fade = 0;
            } else if (fade != 0) {
                if (shown > fade) {
                    shown = shown - fade;
                } else {
                    shown = 0;
                }
                psg.setVolume(0, shown);
            }
            return;
        }
        if (playing == 255 || songLen[0] < 4) {
            return;
        }
        let speed: utinyint = song[1];
        if (speed == 0) {
            speed = 6;
        }
        tick = tick + 1;
        if (tick < speed) {
            return;
        }
        tick = 0;
        let note: utinyint = eventAt(row, 1);
        if (note != 255) {
            psg.play(0, note, waveOf(eventAt(row, 2)), level);
        } else {
            psg.silence(0);
        }
        row = row + 1;
        if (row >= song[2]) {
            row = 0;
        }
    }
}

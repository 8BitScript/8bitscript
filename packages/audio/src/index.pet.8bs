// @8bitscript/audio on the PET: the VIA's CB2 square wave. One voice, no volume, no envelope.
// A missing speaker (audio.voices = 0) means the lowering omitted the bytes and these calls are
// no-ops. A song is the bank and sequencer in songs.8bs: a note's waveform and volume mean
// nothing to a one-bit speaker (it is always the square; a volume of 0 is a rest), and a
// note's decay is how long the speaker sounds before it is switched off.
import { songs } from "./songs.8bs";

let sfxLeft: utinyint = 0;
// True once the program has asked for a song (audio.play or audio.music of one). Nothing but
// those two calls assigns it, so in a program that never plays a song the linker's optimizer
// inlines it as false, every `songsOn` test below folds away, and the sequencer and its 256-byte
// bank are not linked at all: a program that only plays tones pays nothing for songs.
let songsOn: bool = false;
// The frames a song note has left to sound (0: it holds for its rows).
let decayLeft: utinyint = 0;

// T2 low byte for notes C4..B5 (the .8ba index 48..71, C0 = 0, A4 = 57).
// The VIA's shift clock is half the T2 rate, so it shifts a bit out every
// 2 (T2 + 2) cycles and the pattern $0F is eight bits a wave: a note is
// 1,000,000 / (16 (T2 + 2)) Hz. C4 is 261.6 Hz (T2 237) and B5 987.8 Hz
// (T2 61); the register's low byte stops the range below at 243 Hz. Measured
// under xpet (VICE 3.10, 4032 with a speaker): A4 played 441.0 Hz, A5 the
// same wave an octave up at T2 140. A note outside C4..B5 moves by whole
// octaves into it: the pitch class survives, the octave does not. The wave
// is a square, not equal temperament; the steps round to a whole T2.
const T2: array<u8, 24> = [
    237, 223, 211, 199, 188, 177, 167, 157, 148, 140, 132, 125,
    117, 111, 104, 98, 93, 87, 82, 78, 73, 69, 65, 61,
];

function periodOf(note: utinyint): utinyint {
    let n: utinyint = note;
    while (n < 48) {
        n = n + 12;
    }
    while (n > 71) {
        n = n - 12;
    }
    return T2[n - 48];
}

// The speaker is one bit: there is no volume to turn down, only on and off.
let muted: bool = false;

function playNote(note: utinyint): void {
    memory.write(0xE84B, 0x10); // ACR: shift out at T2
    memory.write(0xE84A, 0x0F); // square
    memory.write(0xE848, periodOf(note));
}

function quiet(): void {
    memory.write(0xE84B, 0);
}

// Start the note the sequencer says begins (a volume of 0 is a rest).
function startNote(): void {
    if (muted || songs.volume() == 0) {
        quiet();
        decayLeft = 0;
        return;
    }
    playNote(songs.note());
    decayLeft = songs.decay();
}

// Do what the sequencer says.
function apply(event: utinyint): void {
    if (event == 1) {
        startNote();
    } else if (event == 2 || event == 3) {
        quiet();
        decayLeft = 0;
    }
}

// One frame of a song that is playing: a note's decay, then the sequencer's next step.
function songFrame(): void {
    if (!songs.active()) {
        return;
    }
    if (decayLeft != 0) {
        decayLeft = decayLeft - 1;
        if (decayLeft == 0) {
            quiet();
        }
    }
    apply(songs.step());
}

export namespace audio {
    // The playable notes (the .8ba index, C0 = 0, A4 = 57): the VIA's
    // shift register is 8 bits of T2, so C4..B5.
    const NOTE_LOW: utinyint = 48;
    const NOTE_HIGH: utinyint = 71;

    function bind(kind: utinyint, slot: utinyint, index: utinyint, value: utinyint): void {
        songs.bind(kind, slot, index, value);
    }

    function meta(kind: utinyint, slot: utinyint, length: utinyint, a: utinyint, b: utinyint, c: utinyint): void {
        songs.meta(kind, slot, length);
    }

    // One square tone for `frames` calls of update(), then quiet. Replaces
    // whatever tone is sounding. With no speaker fitted (audio.voices 0)
    // the CB2 wave still runs but nothing hears it. Nothing blocks.
    function tone(note: utinyint, frames: utinyint): void {
        if (songsOn) {
            songs.stop();
        }
        decayLeft = 0;
        if (muted) {
            return;
        }
        playNote(note);
        sfxLeft = frames;
        if (frames == 0) {
            sfxLeft = 1;
        }
    }

    // Stop now: the tone, the sample and the song.
    function silence(): void {
        if (songsOn) {
            songs.stop();
        }
        quiet();
        sfxLeft = 0;
        decayLeft = 0;
    }

    // True while a tone, a sample or a song is sounding (a song's rests count).
    function busy(): bool {
        if (sfxLeft != 0) {
            return true;
        }
        if (songsOn) {
            return songs.active();
        }
        return false;
    }

    // A one-bit speaker has two levels: 0 (silent) and 1 (the square wave). Any
    // level above 0 is 1; a program that wants a quieter PET plays fewer sounds.
    const LEVEL_MAX: utinyint = 1;

    function setLevel(amount: utinyint): void {
        muted = amount == 0;
        if (muted) {
            quiet();
            sfxLeft = 0;
        }
    }

    // A plucked tone is a plain one here: there is no envelope and no volume.
    function blip(note: utinyint, frames: utinyint): void {
        audio.tone(note, frames);
    }

    // A sample plays its fallback note for eight frames; a song plays once, from its start to its
    // last row, and is silent after. A new sound replaces whatever is sounding.
    function play(slot: utinyint): void {
        if (songs.isSong(slot)) {
            songsOn = true;
            sfxLeft = 0;
            apply(songs.start(slot, false));
            return;
        }
        if (!songs.isSample(slot) || muted) {
            return;
        }
        if (songsOn) {
            songs.stop();
        }
        decayLeft = 0;
        playNote(songs.sampleNote(slot));
        sfxLeft = 8;
    }

    // A song, repeated for ever if its file says `loop true` (the default), until the next sound
    // or audio.silence().
    function music(slot: utinyint): void {
        songsOn = true;
        sfxLeft = 0;
        apply(songs.start(slot, true));
    }

    function update(): void {
        if (sfxLeft != 0) {
            sfxLeft = sfxLeft - 1;
            if (sfxLeft == 0) {
                quiet();
            }
            return;
        }
        if (songsOn) {
            songFrame();
        }
    }
}

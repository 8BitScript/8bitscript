{
  "name": "@8bitscript/c128",
  "version": "0.1.2",
  "description": "C128 target support for 8BitScript: the hardware underneath the portable APIs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/8BitScript/8bitscript.git",
    "directory": "packages/c128"
  },
  "8bitscript": {
    "entry": "./src/index.8bs",
    "exports": {
      "./screen": "./src/screen.8bs",
      "./text": "./src/text.8bs",
      "./banks": "./src/banks.8bs",
      "./vdc": "./src/vdc.8bs",
      "./vdc80": "./src/vdc80.8bs",
      "./sid": "./src/sid.8bs",
      "./input": "./src/input.8bs",
      "./pointer": "./src/pointer.8bs"
    },
    "hardware": {
      "facts": {
        "video.columns": 40,
        "video.rows": 25,
        "video.cellWidth": 8,
        "video.cellHeight": 8,
        "video.palette": 16,
        "video.cellColors": 2,
        "video.colorPerCell": true,
        "video.glyphs": 256,
        "video.blockWidth": 2,
        "video.blockHeight": 2,
        "video.bitmap": true,
        "video.layers": 1,
        "video.scroll": true,
        "video.sprites": 8,
        "video.spritesPerLine": 8,
        "video.spriteWidth": 24,
        "video.spriteHeight": 21,
        "video.spriteColors": 3,
        "video.frameRate": 60,
        "audio.voices": 3,
        "audio.noise": true,
        "audio.envelope": true,
        "audio.filter": true,
        "audio.pcm": true,
        "audio.volume": true,
        "audio.entropy": true,
        "input.keyboard": true,
        "input.joysticks": 2,
        "input.pads": 0,
        "input.mouse": false,
        "input.paddles": false,
        "storage.save": true,
        "memory.ram": 41983,
        "memory.banked": true,
        "memory.bankedKib": 64,
        "storage.kib": 329
      },
      "options": {
        "ram": {
          "label": "RAM",
          "default": "128k",
          "values": {
            "128k": {
              "label": "128 KiB"
            },
            "256k": {
              "label": "256 KiB (banks 2 and 3 fitted)",
              "run": {
                "x128": [
                  "-c128fullbanks"
                ]
              },
              "facts": {
                "memory.bankedKib": 192
              },
              "detect": "@8bitscript/c128/banks",
              "tag": null
            }
          }
        },
        "vdc": {
          "label": "VDC RAM",
          "default": "16k",
          "values": {
            "16k": {
              "label": "16 KiB VDC RAM (flat C128 and C128D as sold)",
              "run": {
                "x128": [
                  "-VDC16KB"
                ]
              }
            },
            "64k": {
              "label": "64 KiB VDC RAM (C128DCR, and the common upgrade)",
              "run": {
                "x128": [
                  "-VDC64KB"
                ]
              },
              "tag": null
            }
          },
          "detect": "@8bitscript/c128/vdc"
        },
        "vdcrev": {
          "label": "VDC chip",
          "default": "8563",
          "values": {
            "8563": {
              "label": "8563 R8/R9 (flat C128, C128D)",
              "run": {
                "x128": [
                  "-VDCRevision",
                  "1"
                ]
              }
            },
            "8568": {
              "label": "8568 (C128DCR)",
              "tag": null,
              "run": {
                "x128": [
                  "-VDCRevision",
                  "2"
                ]
              }
            },
            "8563r7a": {
              "label": "8563 R7A (earliest 80-column chip)",
              "tag": null,
              "run": {
                "x128": [
                  "-VDCRevision",
                  "0"
                ]
              }
            }
          }
        },
        "sid": {
          "label": "SID",
          "default": "6581",
          "values": {
            "6581": {
              "label": "6581 (flat C128, C128D)",
              "run": {
                "x128": [
                  "-sidmodel",
                  "0"
                ]
              }
            },
            "8580": {
              "label": "8580 (C128DCR)",
              "tag": null,
              "run": {
                "x128": [
                  "-sidmodel",
                  "1"
                ]
              }
            }
          }
        },
        "cia": {
          "label": "CIA",
          "default": "6526",
          "values": {
            "6526": {
              "label": "6526 (flat C128, C128D)",
              "run": {
                "x128": [
                  "-ciamodel",
                  "0"
                ]
              }
            },
            "8521": {
              "label": "8521 (C128DCR)",
              "tag": null,
              "run": {
                "x128": [
                  "-ciamodel",
                  "1"
                ]
              }
            }
          }
        },
        "expansion": {
          "label": "RAM Expansion Unit",
          "default": "none",
          "values": {
            "none": {
              "label": "No expansion"
            },
            "reu128": {
              "label": "REU, 128 KiB (1700)",
              "tag": null,
              "run": {
                "x128": [
                  "-reu",
                  "-reusize",
                  "128"
                ]
              }
            },
            "reu256": {
              "label": "REU, 256 KiB (1764)",
              "tag": null,
              "run": {
                "x128": [
                  "-reu",
                  "-reusize",
                  "256"
                ]
              }
            },
            "reu512": {
              "label": "REU, 512 KiB (1750)",
              "tag": null,
              "run": {
                "x128": [
                  "-reu",
                  "-reusize",
                  "512"
                ]
              }
            },
            "reu1m": {
              "label": "REU, 1 MiB",
              "tag": null,
              "run": {
                "x128": [
                  "-reu",
                  "-reusize",
                  "1024"
                ]
              }
            },
            "reu2m": {
              "label": "REU, 2 MiB",
              "tag": null,
              "run": {
                "x128": [
                  "-reu",
                  "-reusize",
                  "2048"
                ]
              }
            },
            "reu4m": {
              "label": "REU, 4 MiB",
              "tag": null,
              "run": {
                "x128": [
                  "-reu",
                  "-reusize",
                  "4096"
                ]
              }
            },
            "reu8m": {
              "label": "REU, 8 MiB",
              "tag": null,
              "run": {
                "x128": [
                  "-reu",
                  "-reusize",
                  "8192"
                ]
              }
            },
            "reu16m": {
              "label": "REU, 16 MiB",
              "tag": null,
              "run": {
                "x128": [
                  "-reu",
                  "-reusize",
                  "16384"
                ]
              }
            }
          }
        },
        "port1": {
          "label": "Control port 1",
          "default": "none",
          "values": {
            "none": {
              "label": "Nothing plugged in",
              "run": {
                "x128": [
                  "-controlport1device",
                  "0"
                ]
              }
            },
            "joystick": {
              "label": "Joystick",
              "run": {
                "x128": [
                  "-controlport1device",
                  "1"
                ]
              }
            },
            "paddles": {
              "label": "Paddles",
              "run": {
                "x128": [
                  "-controlport1device",
                  "2"
                ]
              },
              "facts": {
                "input.paddles": true
              }
            },
            "mouse1351": {
              "label": "Commodore 1351 mouse",
              "run": {
                "x128": [
                  "-controlport1device",
                  "3",
                  "-mouse"
                ]
              },
              "facts": {
                "input.mouse": true
              }
            }
          }
        },
        "port2": {
          "label": "Control port 2",
          "default": "joystick",
          "values": {
            "none": {
              "label": "Nothing plugged in",
              "run": {
                "x128": [
                  "-controlport2device",
                  "0"
                ]
              }
            },
            "joystick": {
              "label": "Joystick",
              "run": {
                "x128": [
                  "-controlport2device",
                  "1"
                ]
              }
            },
            "paddles": {
              "label": "Paddles",
              "run": {
                "x128": [
                  "-controlport2device",
                  "2"
                ]
              },
              "facts": {
                "input.paddles": true
              }
            },
            "mouse1351": {
              "label": "Commodore 1351 mouse",
              "run": {
                "x128": [
                  "-controlport2device",
                  "3",
                  "-mouse"
                ]
              },
              "facts": {
                "input.mouse": true
              }
            }
          }
        },
        "drive": {
          "label": "Disk drive",
          "default": "1571",
          "values": {
            "1541": {
              "label": "1541 (170K disk)",
              "facts": {
                "storage.save": true,
                "storage.kib": 164
              },
              "tag": null
            },
            "1571": {
              "label": "1571 (340K disk) — built into the C128D",
              "facts": {
                "storage.save": true,
                "storage.kib": 329
              },
              "tag": null
            },
            "1581": {
              "label": "1581 (800K disk)",
              "facts": {
                "storage.save": true,
                "storage.kib": 783
              },
              "tag": null
            },
            "none": {
              "label": "No drive",
              "facts": {
                "storage.save": false,
                "storage.kib": 0
              },
              "tag": null
            }
          }
        }
      },
      "presets": {
        "c128": {
          "ram": "128k",
          "vdc": "16k",
          "vdcrev": "8563",
          "sid": "6581",
          "cia": "6526"
        },
        "c128d": {
          "ram": "128k",
          "vdc": "16k",
          "vdcrev": "8563",
          "sid": "6581",
          "cia": "6526"
        },
        "c128dcr": {
          "ram": "128k",
          "vdc": "64k",
          "vdcrev": "8568",
          "sid": "8580",
          "cia": "8521"
        },
        "vdc64": {
          "vdc": "64k"
        },
        "ram256": {
          "ram": "256k"
        },
        "loaded": {
          "ram": "256k",
          "vdc": "64k",
          "vdcrev": "8568",
          "sid": "8580",
          "cia": "8521",
          "expansion": "reu512",
          "port1": "mouse1351",
          "port2": "joystick"
        }
      }
    }
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test"
  }
}

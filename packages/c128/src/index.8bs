// @8bitscript/c128 — C128 target support: the hardware underneath.
//
// The module entry point named by the "8bitscript".entry field in this
// package's package.json, resolved and linked for:
//
//     import { borderColor, backgroundColor, memoryPointer } from "@8bitscript/c128";
//
// The surface is the hardware, one register at a time. What a program
// usually wants sits one layer up, in this package's own implementations of
// the portable capability packages — `./src/screen.8bs` behind
// @8bitscript/screen and `./src/text.8bs` behind @8bitscript/text, named by
// the "8bitscript".exports map in package.json — which import these
// registers and are built on nothing else.
//
// The C128's VIC-IIe is register-compatible with the C64's VIC-II for the
// registers this target uses — confirmed directly against llvm-mos-sdk's
// own c128.h, which maps the C128's VIC at $D000 using the identical
// __vic2 struct the c64 platform uses, colour RAM at the identical $D800.
// A program built for this target runs in the C128's native 40-column
// mode, at the VIC-IIe's C64-compatible register layout — the 80-column
// VDC and the second (Z80) CPU are outside what this target reaches for.
// (The VDC is a genuine second screen, with its own registers and its own
// memory; when it arrives it belongs here, as this package's own export,
// not in the portable @8bitscript/screen, which is the one picture every
// machine has.)

// $D020, the VIC-IIe border colour register — same address, same meaning
// as the C64's.
@address(0xD020)
export let borderColor: volatile<u8>;

// $D021, the VIC-IIe background colour register (background #0).
@address(0xD021)
export let backgroundColor: volatile<u8>;

// $D018, the VIC-IIe's memory pointer, laid out as the C64's: $14 is
// screen $0400 and the upper-case/graphics set at $1000 (the C128 KERNAL's
// reset value — it leaves bit 0 clear where the C64's leaves it set; the
// VIC ignores that bit either way), $16 the lower-case set at $1800.
@address(0xD018)
export let memoryPointer: volatile<u8>;

// $0A2C, VM1: the C128 KERNAL's SHADOW of $D018, which the screen editor's
// IRQ routine copies back over the register every interrupt while in text
// mode — so writing the register alone lasts until the next IRQ, and a
// caller writes the shadow first, the same class of problem
// @8bitscript/atari8 documents for GTIA's colour registers.
@address(0x0A2C)
export let memoryPointerShadow: volatile<u8>;

// ---- SID ($D400) -----------------------------------------------------------
//
// The same chip at the same address as the C64's, and every register means
// what packages/c64/AGENTS.md says it means: twenty-five registers, seven
// per voice then the filter and volume. Which SID is fitted is the board —
// a 6581 in the flat C128 and C128D, an 8580 in the C128DCR, the catalog's
// `sid` option — and the difference is the filter's character, not the
// register map.
//
// Two things that are this machine's and not the C64's. The SID has its
// own clock line, so **2 MHz mode does not change its pitch or its
// timing**: the C128 PRG lists it among the parts that "are still driven
// by a 1 MHz source". And the KERNAL's interrupt is alive here, but it
// does not touch these registers — its work is the keyboard, the jiffy
// clock and the VIC's shadows — so a program owns the SID without having
// to take the interrupt over first.
@address(0xD400)
export let sidRegisters: array<u8, 25>;

// $D419 / $D41A, the two paddle A/D converters, which are also the lines a
// 1351 mouse reports its movement on. $D41B / $D41C, voice 3's oscillator
// and envelope — the only readable outputs the chip has, and the hardware
// entropy the root AGENTS.md wants kept out of the deterministic PRNG.
@address(0xD419)
export let paddleX: volatile<u8>;
@address(0xD41A)
export let paddleY: volatile<u8>;
@address(0xD41B)
export let voice3Oscillator: volatile<u8>;
@address(0xD41C)
export let voice3Envelope: volatile<u8>;

// ---- which machine this is -------------------------------------------------
//
// $0A03, the KERNAL's PAL flag: it worked the region out at boot and wrote
// it down, so on this machine finding out costs one read. The C64 has no
// such byte and @8bitscript/c64 watches two whole frames of the raster to
// answer the same question; that difference is the reason this is here
// rather than shared. Anything whose units are the CPU clock needs it —
// the SID's pitch above all, since a note's frequency register is
// `f * 2^24 / clock` and the two clocks differ by 3.8 percent.
@address(0x0A03)
export let palFlag: volatile<u8>;

export namespace Region {
    const PAL: utinyint = 0;
    const NTSC: utinyint = 1;
}

export function detectRegion(): utinyint {
    if (palFlag != 0) {
        return Region.PAL;
    }
    return Region.NTSC;
}

// ---- CIA1 ($DC00): the keyboard matrix and the two control ports ------------
//
// The same chip at the same address as a C64's, and — for the eight
// columns by eight rows the C64 has — the same key at the same place, so
// @8bitscript/c64/keys's codes are the right codes on this machine too.
//
// What a C128 adds is a *second* matrix: the dedicated cursor keys, the
// numeric keypad, HELP, ALT, ESC, TAB, LINE FEED and NO SCROLL hang off
// three extra column lines driven by the VIC-IIe's $D02F, read back
// through this same port B. `@8bitscript/c128/input` reads the C64-shaped
// matrix only and says so; $D02F is declared here for whoever wires the
// rest up.
@address(0xDC00)
export let cia1PortA: volatile<u8>;
@address(0xDC01)
export let cia1PortB: volatile<u8>;
@address(0xDC02)
export let cia1DirectionA: volatile<u8>;
@address(0xDC03)
export let cia1DirectionB: volatile<u8>;

// The VIC-IIe's extra keyboard column lines, K0-K2 in bits 0-2: drive one
// low and port B above reads that extra column's keys. $FF selects none,
// which is the state the C64-compatible scan needs.
@address(0xD02F)
export let extraKeyboardLines: volatile<u8>;

// @8bitscript/atari8/screen — ANTIC 6 (GR.1) twin, tag `gr1`.
//
// Stock Atari text is ANTIC 2 (GR.0): 40 columns, COLPF2 behind the
// glyphs, COLPF1 luminance, no per-cell color. This file is the other
// text mode the catalog's `textmode=gr1` tag selects: 20 columns, 24
// rows, four playfield colors a cell picks with its top two bits.
// COLBK is both the border and the 0-bits of every glyph — there is no
// separate border register in this mode, so `setBorder` and
// `setBackground` both write it and the last of the two to run is what
// stays. `blank(BLUE, BLACK)` therefore yields a black border. That is
// the hardware, not a missing write.
//
// The playfield lives in a 1K window the linker does not own:
// charset at `$3C00` (512 bytes, 512-aligned), the display list at
// `$3E00` (32 bytes, inside the same 1K so ANTIC never wraps it), screen
// RAM at `$3E20` (480 cells, ending at `$3FFF`). `$4000` is left alone —
// that is the 130XE bank window `@8bitscript/atari8/banks` probes.
import {
    borderColor, borderColorShadow, backgroundColor, backgroundColorShadow,
    textColor, textColorShadow, cursorInhibit,
} from "./index.8bs";

// COLPF0 / COLPF3 and their OS shadows — GR.0 never writes these, so they
// are not in index.8bs. COLPF1/2/BK are textColor/backgroundColor/borderColor.
@address(0xD016)
let colpf0: volatile<u8>;
@address(0xD019)
let colpf3: volatile<u8>;
@address(0x02C4)
let color0: volatile<u8>;
@address(0x02C7)
let color3: volatile<u8>;

@address(0xD409)
let chbase: volatile<u8>;
@address(0x02F4)
let chbas: volatile<u8>;

@address(0xD402)
let dlistl: volatile<u8>;
@address(0xD403)
let dlisth: volatile<u8>;
@address(0x0230)
let sdlstl: volatile<u8>;
@address(0x0231)
let sdlsth: volatile<u8>;

@address(0xD400)
let dmactl: volatile<u8>;
@address(0x022F)
let sdmctl: volatile<u8>;

@address(0x3C00)
let charsetRam: array<u8, 512>;
@address(0x3E00)
let displayList: array<u8, 32>;
@address(0x3E20)
export let screenRam: array<u8, 480>;

const ROM_CHARSET: usmallint = 0xE000;
// Internal codes 0-9 are ATASCII '0'-'9' minus 32. The inverted copies
// sit in slots the portable set never prints: not space, not digits,
// not A-Z, not `! , - . : ?`, and not the parentheses Copyright pokes
// as ASCII 40/41 (internal 8/9).
const INVERT_DIGIT: array<utinyint, 10> = [2, 3, 4, 5, 6, 7, 10, 11, 15, 27];

let playfieldReady: bool = false;

function writeDisplayList(): void {
    displayList[0] = 0x70;
    displayList[1] = 0x70;
    displayList[2] = 0x70;
    displayList[3] = 0x46; // LMS + ANTIC 6
    displayList[4] = 0x20; // screen lo
    displayList[5] = 0x3E; // screen hi
    let i: utinyint = 0;
    while (i < 23) {
        displayList[6 + i] = 0x06;
        i++;
    }
    displayList[29] = 0x41; // JVB
    displayList[30] = 0x00;
    displayList[31] = 0x3E;
}

function copyCharset(): void {
    let i: usmallint = 0;
    while (i < 512) {
        charsetRam[i] = memory.read(ROM_CHARSET + i);
        i++;
    }
    let d: utinyint = 0;
    while (d < 10) {
        let src: usmallint = (16 + d) * 8;
        let dest: usmallint = INVERT_DIGIT[d] * 8;
        let row: utinyint = 0;
        while (row < 8) {
            charsetRam[dest + row] = charsetRam[src + row] ^ 255;
            row++;
        }
        d++;
    }
    let row: utinyint = 0;
    while (row < 8) {
        charsetRam[504 + row] = 255;
        row++;
    }
}

function applyPalette(): void {
    // Four hues `text.setColor` can pick, matching the portable names
    // as closely as four GTIA registers allow. WHITE/BLACK share PF0,
    // CYAN/BLUE share PF1, GREEN is PF2, YELLOW/RED/PURPLE share PF3.
    color0 = 0x0E;
    colpf0 = 0x0E;
    textColorShadow = 0xA8;
    textColor = 0xA8;
    backgroundColorShadow = 0xC6;
    backgroundColor = 0xC6;
    color3 = 0x34;
    colpf3 = 0x34;
}

function pointAntic(): void {
    sdlstl = 0x00;
    sdlsth = 0x3E;
    dlistl = 0x00;
    dlisth = 0x3E;
    chbas = 0x3C;
    chbase = 0x3C;
    sdmctl = 0x22;
    dmactl = 0x22;
}

// Called from `text.prepare` as well as from blank/setColors, so a
// program that prints before it blanks still gets a display list.
export function ensurePlayfield(): void {
    if (playfieldReady) {
        return;
    }
    playfieldReady = true;
    copyCharset();
    writeDisplayList();
    applyPalette();
    pointAntic();
    cursorInhibit = 1;
}

function writeColbk(value: u8): void {
    borderColorShadow = value;
    borderColor = value;
}

export namespace screen {
    function setColors(border: u8, background: u8): void {
        ensurePlayfield();
        // Border first so a subsequent background write is what COLBK
        // keeps — ANTIC 6 cannot split the two.
        writeColbk(border);
        writeColbk(background);
        applyPalette();
        cursorInhibit = 1;
    }

    function blank(border: utinyint = BorderColor.BLACK, background: utinyint = BackgroundColor.BLACK): void {
        if (border != BorderColor.KEEP) {
            screen.setBorder(border);
        }
        if (background != BackgroundColor.KEEP) {
            screen.setBackground(background);
        }
        cursorInhibit = 1;
        let cell: usmallint = 0;
        while (cell < 480) {
            screenRam[cell] = 0;
            cell++;
        }
    }

    function setBackground(background: u8): void {
        ensurePlayfield();
        writeColbk(background);
        applyPalette();
        cursorInhibit = 1;
    }

    function setBorder(border: u8): void {
        ensurePlayfield();
        writeColbk(border);
        applyPalette();
        cursorInhibit = 1;
    }

    const RESIZABLE: bool = false;

    function resized(): bool {
        return false;
    }
}

export namespace BorderColor {
    const BLACK: utinyint = 0x00;
    const WHITE: utinyint = 0x0E;
    const RED: utinyint = 0x34;
    const CYAN: utinyint = 0xA8;
    const PURPLE: utinyint = 0x58;
    const GREEN: utinyint = 0xC6;
    const BLUE: utinyint = 0x84;
    const YELLOW: utinyint = 0x1C;
    const KEEP: utinyint = 255;
}

export namespace BackgroundColor {
    const BLACK: utinyint = 0x00;
    const WHITE: utinyint = 0x0E;
    const RED: utinyint = 0x34;
    const CYAN: utinyint = 0xA8;
    const PURPLE: utinyint = 0x58;
    const GREEN: utinyint = 0xC6;
    const BLUE: utinyint = 0x84;
    const YELLOW: utinyint = 0x1C;
    const KEEP: utinyint = 255;
}

{
  "name": "@8bitscript/atari8",
  "version": "0.6.1",
  "description": "Atari 8-bit target support for 8BitScript: the hardware underneath the portable APIs, for the 400/800/XL/XE/XEGS family. Parked in 0.2.0: not a build target until its native backend lands.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/8BitScript/8bitscript.git",
    "directory": "packages/atari8"
  },
  "8bitscript": {
    "entry": "./src/index.8bs",
    "exports": {
      "./screen": "./src/screen.8bs",
      "./text": "./src/text.8bs",
      "./banks": "./src/banks.8bs",
      "./joystick": "./src/joystick.8bs",
      "./console": "./src/console.8bs",
      "./keyboard": "./src/keyboard.8bs",
      "./keys": "./src/keys.8bs",
      "./pokey": "./src/pokey.8bs",
      "./random": "./src/random.8bs",
      "./input": "./src/input.8bs",
      "./pointer": "./src/pointer.8bs"
    },
    "hardware": {
      "build": {
        "defsym": {
          "__load_address": 8192,
          "__ram_ceiling": 49152
        }
      },
      "facts": {
        "video.columns": 40,
        "video.rows": 24,
        "video.cellWidth": 8,
        "video.cellHeight": 8,
        "video.palette": 128,
        "video.cellColors": 2,
        "video.colorPerCell": false,
        "video.glyphs": 128,
        "video.blockWidth": 0,
        "video.blockHeight": 0,
        "video.bitmap": true,
        "video.layers": 1,
        "video.scroll": true,
        "video.sprites": 4,
        "video.spritesPerLine": 4,
        "video.spriteWidth": 8,
        "video.spriteHeight": 192,
        "video.spriteColors": 1,
        "video.frameRate": 60,
        "audio.voices": 4,
        "audio.noise": true,
        "audio.envelope": false,
        "audio.filter": false,
        "audio.pcm": true,
        "audio.volume": true,
        "audio.entropy": true,
        "input.keyboard": true,
        "input.joysticks": 2,
        "input.pads": 0,
        "input.controls": [
          "up",
          "down",
          "left",
          "right",
          "a"
        ],
        "input.mouse": false,
        "input.paddles": false,
        "storage.save": true,
        "memory.ram": 40960,
        "memory.banked": false,
        "memory.bankedKib": 0,
        "storage.kib": 86
      },
      "options": {
        "model": {
          "label": "Model",
          "default": "800xl",
          "values": {
            "400": {
              "label": "400: 8-16K, membrane keyboard, four joystick ports",
              "run": {
                "atari800": [
                  "-atari"
                ]
              },
              "facts": {
                "input.joysticks": 4
              }
            },
            "800": {
              "label": "800: up to 48K, OS-B, four joystick ports",
              "run": {
                "atari800": [
                  "-atari"
                ]
              },
              "facts": {
                "input.joysticks": 4
              }
            },
            "1200xl": {
              "label": "1200XL: 64K, the first XL, HELP key, two ports",
              "run": {
                "atari800": [
                  "-1200"
                ]
              }
            },
            "800xl": {
              "label": "800XL: 64K",
              "run": {
                "atari800": [
                  "-xl"
                ]
              }
            },
            "65xe": {
              "label": "65XE: 64K (an 800XL electrically)",
              "run": {
                "atari800": [
                  "-xl"
                ]
              }
            },
            "130xe": {
              "label": "130XE: 64K + 64K banked behind PORTB",
              "run": {
                "atari800": [
                  "-xe"
                ]
              },
              "facts": {
                "memory.banked": true,
                "memory.bankedKib": 64
              },
              "detect": "@8bitscript/atari8/banks"
            },
            "xegs": {
              "label": "XEGS console: a 65XE in a console case",
              "run": {
                "atari800": [
                  "-xegs"
                ]
              }
            }
          }
        },
        "media": {
          "label": "Media",
          "default": "xex",
          "values": {
            "xex": {
              "label": "Atari DOS executable (.xex), loaded from D: into $2000-$BFFF"
            },
            "cart8": {
              "label": "8 KiB cartridge at $A000",
              "build": {
                "startup": "cart-std",
                "output": "rom",
                "defsym": {
                  "__cart_rom_size": 8
                }
              },
              "load": {
                "atari800": [
                  "-cart",
                  "{out}",
                  "-cart-type",
                  "1"
                ]
              },
              "facts": {
                "memory.ram": 6400,
                "storage.save": false,
                "storage.kib": 0
              }
            },
            "cart16": {

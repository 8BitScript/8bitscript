        "mouse": {
          "label": "Pointing device",
          "default": "none",
          "values": {
            "none": {
              "label": "None",
              "run": {
                "atari800": [
                  "-mouse",
                  "off"
                ]
              }
            },
            "st": {
              "label": "Atari ST mouse",
              "run": {
                "atari800": [
                  "-mouse",
                  "st"
                ]
              },
              "facts": {
                "input.mouse": true
              }
            },
            "amiga": {
              "label": "Amiga mouse",
              "run": {

// The Atari extended-RAM probe, run for real: prints the KiB banks.kib()
// found and sets the border to a color that encodes it — red for none, a
// different color for each 16 KiB step up to the 130XE's 64. See
// test/banks.test.mjs.
use super::src::screen::screen;
use super::src::text::text;
use super::src::banks::banks;

pub fn main() {
    screen::blank();
    let kib: usmallint = banks::kib();
    text::print(0, "EXTRA KIB");
    text::printNumber(10, kib, 5);
    let mut color: utinyint = 52; // dark red
    if kib != 0 {
        color = 196; // bright green: a 130XE
    }
    screen::setColors(color, 0);
    loop {
        waitFrame();
    }
}

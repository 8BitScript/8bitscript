{
  "name": "@8bitscript/cli",
  "version": "0.23.0",
  "description": "The 8bs command line interface: builds, runs, and diagnoses 8BitScript projects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/8BitScript/8bitscript.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "main": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./package.json": "./package.json",
    "./bin/*": "./bin/*",
    "./src/*": "./src/*",
    "./schemas/*": "./schemas/*",
    "./data/*": "./data/*"
  },
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "8bs": "./bin/8bs.mjs"
  },
  "files": [
    "bin",
    "src",
    "schemas",
    "data"
  ],
  "dependencies": {
    "@8bitscript/atari8": "workspace:*",
    "@8bitscript/c128": "workspace:*",
    "@8bitscript/c64": "workspace:*",
    "@8bitscript/compiler": "workspace:*",
    "@8bitscript/cx16": "workspace:*",
    "@8bitscript/examples": "workspace:*",
    "@8bitscript/language-server": "workspace:*",
    "@8bitscript/mega65": "workspace:*",
    "@8bitscript/nes": "workspace:*",
    "@8bitscript/pet": "workspace:*",
    "@8bitscript/studio": "workspace:*",
    "@8bitscript/vic20": "workspace:*",
    "@8bitscript/web": "workspace:*",
    "@8bitscript/plus4": "workspace:*",
    "@8bitscript/oric": "workspace:*",
    "@8bitscript/apple2": "workspace:*",
    "@8bitscript/bbc": "workspace:*",
    "@8bitscript/atari5200": "workspace:*",
    "@8bitscript/lynx": "workspace:*",
    "@8bitscript/pce": "workspace:*",
    "@8bitscript/supervision": "workspace:*",
    "@8bitscript/atari2600": "workspace:*",
    "@8bitscript/atari7800": "workspace:*",
    "@8bitscript/gb": "workspace:*",
    "@8bitscript/gbc": "workspace:*",
    "@8bitscript/sms": "workspace:*",
    "@8bitscript/gamegear": "workspace:*",
    "@8bitscript/sg1000": "workspace:*",
    "@8bitscript/msx": "workspace:*",
    "@8bitscript/coleco": "workspace:*",
    "@8bitscript/spectrum": "workspace:*",
    "@8bitscript/cpc": "workspace:*",
    "@8bitscript/coco": "workspace:*",
    "@8bitscript/vectrex": "workspace:*",
    "@8bitscript/odyssey2": "workspace:*",
    "@8bitscript/channelf": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test"
  }
}

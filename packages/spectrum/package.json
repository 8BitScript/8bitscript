{
  "name": "@8bitscript/spectrum",
  "version": "0.23.0",
  "description": "ZX Spectrum target support for 8BitScript: the hardware underneath the portable APIs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/8BitScript/8bitscript.git",
    "directory": "packages/spectrum"
  },
  "8bitscript": {
    "title": "ZX Spectrum",
    "emulator": {
      "binary": "fuse",
      "family": "dedicated",
      "screenshot": "window",
      "framesUnit": "frames",
      "defaultFrames": 180,
      "installer": "fuse",
      "deferred": "Fuse is a GUI app"
    },
    "entry": "./src/index.8bs",
    "exports": {
      "./screen": "./src/screen.8bs",
      "./text": "./src/text.8bs",
      "./input": "./src/input.8bs",
      "./pointer": "./src/pointer.8bs",
      "./rasterline": "./src/rasterline.8bs"
    },
    "hardware": {
      "build": {
        "defsym": {
          "__load_address": 32768,
          "__ram_size": 48
        },
        "output": "tap"
      },
      "facts": {
        "video.columns": 32,
        "video.rows": 24,
        "video.cellWidth": 8,
        "video.cellHeight": 8,
        "video.palette": 8,
        "video.cellColors": 2,
        "video.colorPerCell": true,
        "video.glyphs": 0,
        "video.blockWidth": 0,
        "video.blockHeight": 0,
        "video.bitmap": true,
        "video.layers": 1,
        "video.scroll": false,
        "video.raster": false,
        "video.sprites": 0,
        "video.spritesPerLine": 0,
        "video.spriteWidth": 0,
        "video.spriteHeight": 0,
        "video.spriteColors": 0,
        "video.frameRate": 60,
        "audio.voices": 1,
        "audio.noise": false,
        "audio.envelope": false,
        "audio.filter": false,
        "audio.pcm": false,
        "audio.volume": false,
        "audio.entropy": false,
        "input.keyboard": true,
        "input.joysticks": 1,
        "input.pads": 0,
        "input.controls": [
          "up",
          "down",
          "left",
          "right",
          "a"
        ],
        "input.mouse": false,
        "input.paddles": false,
        "storage.save": false,
        "storage.kib": 0,
        "memory.ram": 49152,
        "memory.banked": false,
        "memory.bankedKib": 0
      },
      "options": {},
      "presets": {}
    }
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test"
  }
}

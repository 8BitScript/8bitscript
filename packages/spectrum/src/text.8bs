use self::geometry::Video;

fn asciiToScreenCode(code: utinyint) -> utinyint {
    if code >= 97 && code < 123 {
        return code - 96;
    }
    return code;
}

let mut ink: utinyint = 1;

pub mod text {
    const CELL_COUNT: usmallint = Video::CELL_COUNT;
    const COLUMNS: utinyint = Video::COLUMNS;
    const ROWS: utinyint = Video::ROWS;

    fn columns() -> utinyint {
        return text::COLUMNS;
    }

    fn rows() -> utinyint {
        return text::ROWS;
    }

    fn releaseCursor() {
    }

    fn setReverse(on: bool) {
    }

    fn setColor(color: utinyint) {
        ink = color;
    }

    fn putChar(cell: usmallint, code: utinyint) {
        memory::write(16384 + cell, asciiToScreenCode(code));
    }

    fn putColor(cell: usmallint, color: utinyint) {
    }

    fn print(cell: usmallint, s: string) {
        for i: utinyint in 0..s.length {
            text::putChar(cell + i, s[i]);
        }
    }

    fn fill(cell: usmallint, count: usmallint, code: utinyint) {
        for i: usmallint in 0..count {
            text::putChar(cell + i, code);
        }
    }

    fn printNumber(cell: usmallint, value: usmallint, width: utinyint) {
        let mut n: usmallint = value;
        let mut i: utinyint = width;
        while i > 0 {
            i = i - 1;
            let mut digit: utinyint = 0;
            let mut place: usmallint = 1;
            let mut w: utinyint = 0;
            while w < i {
                place = place * 10;
                w = w + 1;
            }
            while n >= place {
                n = n - place;
                digit = digit + 1;
            }
            text::putChar(cell + i, 48 + digit);
        }
    }
}

pub mod TextColor {
    const BLACK: utinyint = 0;
    const WHITE: utinyint = 1;
    const RED: utinyint = 2;
    const CYAN: utinyint = 3;
    const PURPLE: utinyint = 4;
    const GREEN: utinyint = 5;
    const BLUE: utinyint = 6;
    const YELLOW: utinyint = 7;
}

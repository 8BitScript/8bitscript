// @8bitscript/random — a small, deterministic pseudo-random generator.
//
//     import { random } from "@8bitscript/random";
//
//     random.seed(1234);
//     let roll: utinyint = random.range(6) + 1; // 1..6
//
// The root AGENTS.md rule is that "randomness must be deterministic by
// default, explicitly seeded, with small fixed state" — hardware entropy
// (a POKEY register, SID's oscillator 3, timing jitter) belongs behind its
// own separate, explicitly optional import, never silently underneath a
// program's ordinary random numbers. This package is the deterministic
// default every target can use: sixteen bits of state, one multiply-and-add
// step, nothing read from hardware. A program on one of the two targets
// that do have hardware entropy behind their own import today — POKEY's
// counter, `@8bitscript/atari8/random`, and SID voice 3's oscillator,
// `@8bitscript/c64/random` — reads a byte from one of those once and hands
// it to `seed()`; this file never reaches for a register itself, on any
// target, which is what lets it be the same sixteen lines on all nine.
//
// This is not the file to reach for if a program ever needs numbers a
// player cannot predict by reading the source — nothing here is
// cryptographic, on any target, any more than the hardware sources are.

let state: usmallint = 1;

export namespace random {
    // Replaces the generator's whole state. A program that never calls this
    // gets the same sequence on every run, starting from `state`'s own
    // initializer above — a deterministic default, not a random one nobody
    // asked for. 0 is a valid seed: the additive constant below means the
    // next `next()` still moves state away from it, unlike a generator
    // built on multiplication or XOR alone, where an all-zero state is a
    // fixed point.
    function seed(value: usmallint): void {
        state = value;
    }

    // One step of a 16-bit linear congruential generator: `state = state *
    // A + C`, wrapping the way `usmallint` arithmetic always does, which is
    // exactly the modulus a 16-bit LCG wants (mod 65536). A and C are the
    // constants several 8-bit BASICs used for their own RND — coprime with
    // 65536 and long enough for a game board or a shuffled deck.
    //
    // The result is the *high* byte of the new state, not the low one: the
    // low byte of a LCG this size cycles with a much shorter period (16 for
    // A - 1 divisible by 4, here a period of 4 in the very lowest bit) and
    // fails an obvious pattern check almost immediately, while the high
    // byte carries the full 65536-state period. `state >> 8` costs one
    // instruction on the 6502 and is exact on the web target too — no
    // divide, on either backend.
    function next(): utinyint {
        state = state * 25173 + 13849;
        return state >> 8;
    }

    // A value from 0 up to (not including) bound — the shape a caller
    // wants when picking among a fixed number of choices: a board cell, a
    // shuffled index, a die face after adding 1. `bound` must be 1 to 255.
    //
    // **Exactly uniform.** `next() % bound` is not: 256 is not a multiple of
    // `bound`, so the first `256 % bound` outcomes get one more byte than
    // the rest. Over the generator's whole period that is 7 chances in 256
    // for 0-33 and 6 for 34-36 on a 37-pocket wheel (the likeliest pocket
    // is 17% more likely than the least), 2.4% between die faces on a d6,
    // and 2x at a bound of 150 or 200. A game that publishes odds cannot
    // ship that. So the bytes that would make the split uneven — the last
    // `256 % bound` values, the incomplete final block — are thrown away and
    // a fresh byte is drawn: what is left is a whole number of complete
    // blocks, every outcome in each, and each outcome is exactly as likely
    // as any other (tested by counting, not by sampling).
    //
    // The test needs one modulo, the same `%` the biased form used: `byte -
    // remainder` is the start of the block the byte falls in, and a block
    // is complete when it ends by 255, i.e. when that start is at most `256
    // - bound`. `0 - bound` is `256 - bound` in a `utinyint`, which is how
    // 256 is written without a 9th bit. A bound that divides 256 (a power
    // of two) never rejects; any other rejects fewer than half the time, so
    // a call draws 1.0 to 2.0 bytes and, on average, under 1.5 for the
    // bounds a game uses. The number of bytes a call takes is not fixed —
    // the sequence is still fully determined by the seed.
    function range(bound: utinyint): utinyint {
        let limit: utinyint = 0 - bound;
        let value: utinyint = random.next();
        let rest: utinyint = value % bound;
        while (value - rest > limit) {
            value = random.next();
            rest = value % bound;
        }
        return rest;
    }

    // The top `count` bits of the next byte: a value from 0 up to (not
    // including) 2^count, for `count` from 1 to 8. Exactly uniform by
    // construction — no rejection, no modulo — and the right call for a
    // power-of-two choice (a coin, a 1-of-8 reel stop, a 64-stop virtual
    // reel). It takes the *top* bits because that is where an LCG is best
    // mixed; `range(64)` would take the low six bits of the same byte.
    //
    // The shift is a loop of one-bit shifts, not `>> (8 - count)`: the 6502
    // has no shift by a run-time amount and the compiler refuses one
    // ("index a table of masks instead"). A loop of constant shifts is
    // small, and exact.
    function bits(count: utinyint): utinyint {
        let value: utinyint = random.next();
        for (let i: utinyint = count; i < 8; i++) {
            value = value >> 1;
        }
        return value;
    }
}

// A program written against the intended standard library, one step past
// the compiled subset: arrays and a `for` loop with a local (which lower),
// and a `ptr` global (which does not — 8BS3001). The compiler's tests feed
// every prefix of this file to analyze(), hover, and completion to prove
// none of them throw on a half-typed program; the imports are never resolved.
//
// This directory is also the resolver's fixture: `@8bitscript/compiler`
// lists `@8bitscript/text` and `@8bitscript/vic20` as devDependencies, so a
// file under here resolves them through a real pnpm-linked node_modules.
import { text } from "@8bitscript/text";
import { input } from "@8bitscript/input";

@address(0x900F)
let vicColor: volatile<utinyint>;

let buffer: array<utinyint, 16>;
let cursor: ptr<utinyint>;

export function update(): void {
    if (input.left()) {
        cursor--;
    } else {
        cursor++;
    }

    for (let i: utinyint = 0; i < 16; i++) {
        text.putChar(i, 10, buffer[0]);
    }

    while (true) {
        break;
    }

    asm6502 {
        lda #$06
        sta $900f
    }

    return;
}

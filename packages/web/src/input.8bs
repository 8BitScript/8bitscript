// @8bitscript/web/input — the browser runtime behind @8bitscript/input.
//
// Named by "8bitscript".exports["./input"] in this package's package.json,
// and by "8bitscript".entry.web in @8bitscript/input's, so a portable
// program writes
//
//     import { input } from "@8bitscript/input";
//
// and gets this file in a browser.
//
// ---- the page writes, the program reads ----------------------------------
//
// The program runs in a worker and cannot see DOM events. The page listens
// for keys and stores a snapshot at WebRegisters.INPUT_OFFSET in the
// shared wasm memory; poll() reads that byte once a frame, the same shape
// every other machine's layer uses — a held mask, last frame's mask, and
// the bits that began this frame. No new wasm import: the agreement page
// is the port.
//
//   - **left / right / up / down** — ArrowLeft / ArrowRight / ArrowUp /
//     ArrowDown.
//   - **confirm** — Enter.
//   - **cancel** — Escape.
//
// The pointer is a second block of bytes after the tone registers
// (web-layout.mjs PointerRegister): present, buttons, x, y. It exists on
// the Modern host only — a skin is a machine with no mouse, where a touch is
// only ever translated to arrow presses by the page and `pointer()` folds to
// false. `input.mouse` is true for the Modern host and false for the skins.
// The position is the browser's own cursor (or the last touch): nothing
// draws an arrow in the picture. A touch that stays put is a click, a touch
// that travels is a swipe and arrows (web-layout.mjs pointerRoute()).
//
// `touch()` and `keyboard()` are **levels**, not edges: properties of the
// host, written at HOST_OFFSET, not presses. A touchscreen is
// maxTouchPoints and `pointer: coarse`. A keyboard is the page's best
// guess — a touch host whose pointer cannot hover (`hover: none`) is a
// phone or a tablet in the hands and has none — corrected the moment a
// real key arrives: an iPad on a keyboard folio says it has no keyboard
// until its first arrow, and has one from then on. So a program that
// names its controls (SWIPE, ARROWS) reads keyboard() when it prints,
// not once at start-up. A screenshot leaves the byte clear so CI PNGs
// stay the desktop layout: no touchscreen, a keyboard.
//
// `Input.KEYBOARD` from @8bitscript/system is the build's fact — the web
// target has arrow keys — and keyboard() is whether this host, today, has
// anything to press them on. Both are true on a desktop; only the fact
// is true on a phone.
//
// ---- edges, not levels ---------------------------------------------------
//
// Every direction/confirm/cancel answer is **edge-triggered**: true on the
// one frame the press begins, false while it is held. `poll()` must be
// called exactly once a frame, right after waitFrame().
import { WebRegisters } from "./index.8bs";
import { Video } from "./geometry.8bs";

namespace Edge {
    const LEFT: utinyint = 1;
    const RIGHT: utinyint = 2;
    const UP: utinyint = 4;
    const DOWN: utinyint = 8;
    const CONFIRM: utinyint = 16;
    const CANCEL: utinyint = 32;
}

// Bits of the HOST_OFFSET byte. Zero is a desktop with a mouse and a
// keyboard — what a screenshot host writes — so each bit says how a host
// differs from that. The page's side is web-layout.mjs's HostStatus.
namespace HostStatus {
    const TOUCH: utinyint = 1;
    const NO_KEYBOARD: utinyint = 2;
}

let held: utinyint = 0;
let before: utinyint = 0;
let began: utinyint = 0;

// The pointer, read once a frame in poll() and kept, so the arrow a program
// draws and the cell it hit-tests share one answer. Only the Modern host
// has a block (WebRegisters.HAS_POINTER); on a skin none of this is reached.
let pointerHere: bool = false;
let pointerX: usmallint = 0;
let pointerY: usmallint = 0;
let buttonHeld: bool = false;
let buttonBefore: bool = false;

export namespace input {

    // Nothing to set up: the page owns the snapshot byte. Here so a
    // program written for nine machines calls the same thing on all of
    // them.
    function begin(): void {
        // One poll before the program's first, so the edge detector starts
        // from what is actually held rather than from nothing. `before` is
        // zero until something fills it, and an edge is "held now, not held
        // before" — so without this, anything already down when a program
        // starts reads as a fresh press on frame one. Measured on the
        // MEGA65, whose RETURN key is down at start-up: the joystick example
        // counted a confirm() nobody pressed until begin() primed this.
        input.poll();
    }

    // Read the page's snapshot and work out what began this frame. Once
    // a frame, right after waitFrame().
    function poll(): void {
        before = held;
        held = memory.read(WebRegisters.INPUT_OFFSET);
        began = held & (before ^ 0xFF);
        if (WebRegisters.HAS_POINTER) {
            pointerHere = memory.read(WebRegisters.POINTER_BASE) != 0;
            buttonBefore = buttonHeld;
            buttonHeld = (memory.read(WebRegisters.POINTER_BASE + 1) & 1) != 0;
            pointerX = memory.read(WebRegisters.POINTER_BASE + 3);
            pointerX = (pointerX << 8) | memory.read(WebRegisters.POINTER_BASE + 2);
            pointerY = memory.read(WebRegisters.POINTER_BASE + 5);
            pointerY = (pointerY << 8) | memory.read(WebRegisters.POINTER_BASE + 4);
        }
    }

    function left(): bool {
        return (began & Edge.LEFT) != 0;
    }

    function right(): bool {
        return (began & Edge.RIGHT) != 0;
    }

    function up(): bool {
        return (began & Edge.UP) != 0;
    }

    function down(): bool {
        return (began & Edge.DOWN) != 0;
    }

    function confirm(): bool {
        return (began & Edge.CONFIRM) != 0;
    }

    function cancel(): bool {
        return (began & Edge.CANCEL) != 0;
    }

    // A device property, not a press: true while the page has marked this
    // host as a touchscreen. Not edge-triggered; does not need poll().
    function touch(): bool {
        return (memory.read(WebRegisters.HOST_OFFSET) & HostStatus.TOUCH) != 0;
    }

    // A device property, not a press: true while the page believes this
    // host has a keyboard to press arrows on — false on a phone or a
    // tablet in the hands, and true again from the first key a plugged-in
    // keyboard sends. Not edge-triggered; does not need poll().
    function keyboard(): bool {
        return (memory.read(WebRegisters.HOST_OFFSET) & HostStatus.NO_KEYBOARD) == 0;
    }

    // The browser's own cursor over the picture: a mouse, or the spot a
    // finger last touched. True once the page has written a position.
    function pointer(): bool {
        if (WebRegisters.HAS_POINTER) {
            return pointerHere;
        }
        return false;
    }

    // Where it is, as a flat cell index, the unit text.print() takes.
    function pointerCell(): usmallint {
        if (WebRegisters.HAS_POINTER) {
            return (pointerY >> 3) * Video.columns() + (pointerX >> 3);
        }
        return 0;
    }

    // The left button (or a tap), on the frame its press began.
    function pointerButton(): bool {
        if (WebRegisters.HAS_POINTER) {
            return buttonHeld && !buttonBefore;
        }
        return false;
    }
}

// Compile-time names for the confirm control, interpolated into catalogs
// as {control} / {other}. OR / ODER lives in the catalog, not here.
export namespace Input {
    const CONFIRM_LABEL: string = "ENTER";
    const ALT_CONFIRM_LABEL: string = "ENTER";
    const CONFIRM_LABELS: string = "ENTER";
}

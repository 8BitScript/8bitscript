// @8bitscript/web/input — the browser runtime behind @8bitscript/input.
//
// Named by "8bitscript".exports["./input"] in this package's package.json,
// and by "8bitscript".entry.web in @8bitscript/input's, so a portable
// program writes
//
//     import { input } from "@8bitscript/input";
//
// and gets this file in a browser.
//
// ---- the one machine whose facts are decisions ---------------------------
//
// Every "hardware" fact about this target is something someone chose and
// wrote down in the runtime's source (see ../AGENTS.md), and input is the
// clearest case: the browser plainly has a keyboard and a mouse, and this
// target's fact sheet says `input.keyboard` false — because the *runtime*
// does not deliver either to a program yet, and a fact that describes the
// browser rather than the runtime would make Studio offer an editor that
// cannot be typed into.
//
// So everything here returns false, and it is false for a reason that has
// nothing to do with the hardware:
//
//   - **The runtime does not listen.** `packages/cli/src/web-runtime.mjs`
//     paces `waitFrame()` and owns the canvas; nothing attaches a
//     `keydown` or `pointermove` handler, and there is no shared byte for
//     a handler to write into.
//   - **The worker cannot read the DOM.** The program runs in a worker
//     with the main thread signalling frames through `Atomics`, so input
//     would arrive the same way: the page's handlers write a small state
//     block into the shared buffer, and this file reads it. That block is
//     the design decision waiting to be made, and it is the same shape as
//     every other machine's snapshot — a byte of directions, a cell for
//     the pointer.
//
// When that lands, this becomes the *easiest* of the nine — a real
// pointer, four real arrow keys, and an ALT key that actually exists — and
// `input.keyboard` and `input.mouse` become true in the catalog in the
// same commit. Until then this file says no, and Studio reads the fact and
// makes the web a viewer.

namespace Edge {
    const LEFT: utinyint = 1;
    const RIGHT: utinyint = 2;
    const UP: utinyint = 4;
    const DOWN: utinyint = 8;
    const CONFIRM: utinyint = 16;
    const CANCEL: utinyint = 32;
}

let held: utinyint = 0;
let before: utinyint = 0;
let began: utinyint = 0;

export namespace input {

    // Nothing to set up until the runtime delivers something.
    function begin(): void {
    }

    // Reads nothing yet — see the header. A real function rather than an
    // absent one, so a program written for nine machines calls the same
    // thing on all nine.
    function poll(): void {
        before = held;
        held = 0;
        began = held & (before ^ 0xFF);
    }

    function left(): bool {
        return (began & Edge.LEFT) != 0;
    }

    function right(): bool {
        return (began & Edge.RIGHT) != 0;
    }

    function up(): bool {
        return (began & Edge.UP) != 0;
    }

    function down(): bool {
        return (began & Edge.DOWN) != 0;
    }

    function confirm(): bool {
        return (began & Edge.CONFIRM) != 0;
    }

    function cancel(): bool {
        return (began & Edge.CANCEL) != 0;
    }

    function pointer(): bool {
        return false;
    }

    function pointerCell(): usmallint {
        return 0;
    }

    function pointerButton(): bool {
        return false;
    }
}

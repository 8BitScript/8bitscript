// @8bitscript/web — browser target support for 8BitScript: the "hardware"
// underneath.
//
// The module entry point named by the "8bitscript".entry field in this
// package's package.json, resolved and linked for:
//
//     import { WebRegisters } from "@8bitscript/web";
//
// What a program usually wants sits one layer up, in this package's own
// implementations of the portable capability packages — `./src/screen.8bs`
// behind @8bitscript/screen and `./src/text.8bs` behind @8bitscript/text,
// named by the "8bitscript".exports map in package.json — which are built
// on what this file exports and on nothing else.
//
// There is no $900F or $D020 here: the web target has no fixed hardware, so
// "the screen" is a canvas the host paints from wasm's own linear memory
// (the `--initialMemory 1` page every web build reserves, per
// @8bitscript/compiler/wasm). This package's hardware surface is therefore an
// AGREEMENT rather than a register map: a handful of fixed byte offsets in
// that memory — two for the border and background colors, a virtual
// character screen for everything `text` pokes, one byte of input the page
// writes, and one host-status byte (`HOST_OFFSET`) — which the host
// (packages/cli's browser runtime, packages/cli/src/web-runtime.mjs) paints
// from once per display refresh. It is the same deferred-apply contract a
// VIC-II register has, aimed at a buffer instead.
//
// The character screen's size is a property of the build: 48×27 on the
// default 16:9 host, or a machine skin's grid via geometry.8bs twins. Two
// side-by-side regions, not interleaved, so a caller that only ever
// touches a handful of cells leaves most of both untouched.
import { Video } from "./geometry.8bs";

export namespace WebRegisters {
    const BORDER_OFFSET: usmallint = 0;
    const BACKGROUND_OFFSET: usmallint = 1;
    const CHAR_BASE: usmallint = Video.CHAR_BASE;
    const COLOR_BASE: usmallint = Video.COLOR_BASE;
    // Directions, confirm and cancel as the same Edge bits every input
    // layer uses. The page writes this; poll() in ./input.8bs reads it.
    // First byte after the color cells at COLOR_BASE.
    const INPUT_OFFSET: usmallint = Video.INPUT_OFFSET;
    // Device properties the page sets, not keys. Bit 0 is TOUCH: this
    // host is a touchscreen. A screenshot has no viewport, so that bit
    // stays clear there.
    const HOST_OFFSET: usmallint = Video.HOST_OFFSET;
    // The per-scanline raster list ./rasterline.8bs keeps: one control
    // byte (the renderer applies the list while it is nonzero), one count
    // byte, then RASTER_MAX_ENTRIES three-byte entries — the line's low
    // byte, the slot byte (bit 7 carries the line's ninth bit, so every
    // picture line the resizable host reaches fits), the value. The
    // renderer reads it fresh at every paint.
    const RASTER_CONTROL_OFFSET: usmallint = Video.RASTER_CONTROL_OFFSET;
    const RASTER_COUNT_OFFSET: usmallint = Video.RASTER_COUNT_OFFSET;
    const RASTER_BASE: usmallint = Video.RASTER_BASE;
    const RASTER_MAX_ENTRIES: utinyint = Video.RASTER_MAX_ENTRIES;
}

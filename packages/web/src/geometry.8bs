// @8bitscript/web — the screen's geometry for the Modern host, the one grid
// on this target that changes shape while a program runs.
//
// Every other machine 8BitScript builds for has a chip to be faithful to, and
// a C64 is 40×25 because a C64 is 40×25. The web target has no such chip, so
// the grid is a decision — and a decision can be revisited when the window
// it is being shown in turns sideways. Machine skins (a PET 2001, a C64, a
// VIC-20) are hardware tags with a twin beside this file
// (`geometry.web.pet-2001.8bs`, …) whose numbers fold at compile time with no
// runtime probe, exactly as they did before: picking "Commodore" means
// picking a machine, and a machine is what it is.
//
// ---- a fixed map for a moving grid ---------------------------------------
//
// The offsets below are sized for the LARGEST grid this host will ever hand
// out, not for the current one. If COLOR_BASE were CHAR_BASE + columns×rows,
// every offset in the program would move the moment the window turned, and
// the program and the host would disagree for exactly as long as it took
// both to notice. Sizing the two regions for MAX_CELLS costs 8K of the
// wasm page and nothing else, and leaves `columns` as the only thing that
// varies: a cell is still `row * columns + col`.
//
//   0      border color
//   1      background color
//   2      live columns      (the host writes these two; see columns() below)
//   3      live rows
//   4      CHAR_BASE         MAX_CELLS character codes
//   4100   COLOR_BASE        MAX_CELLS color bytes
//   8196   INPUT_OFFSET
//   8197   HOST_OFFSET
//   8198   RASTER_CONTROL    the renderer applies the raster list while nonzero
//   8199   RASTER_COUNT      how many entries the list holds
//   8200   RASTER_BASE       RASTER_MAX_ENTRIES three-byte entries: the line's
//                            low byte, the slot byte (bit 7 = the line's ninth
//                            bit, so all MAX_ROWS * 8 = 512 picture lines fit),
//                            the value
//   8392   the end of the agreement. The program's own data section — every
//          string literal and const array — starts on the next 256-byte
//          boundary above this (8448), placed there by the wasm backend from
//          the same agreement the CLI writes for the page (`reservedEnd` in
//          packages/cli/src/web-layout.mjs, `dataBaseFor()` in the
//          compiler). It used to start at a fixed 8192, inside this map:
//          the first literal's bytes sat under INPUT_OFFSET and the raster
//          list, and the page's input writes and the program's strings
//          overwrote each other.

export namespace Video {
    // The largest grid the host will hand out, and what the map is sized for.
    const MAX_COLUMNS: utinyint = 64;
    const MAX_ROWS: utinyint = 64;
    const MAX_CELLS: usmallint = 4096;

    // The grid a 16:9 window gets, and the one this host has always had.
    // It is what columns()/rows() answer before the host has written
    // anything — see below — not a limit on what they can answer.
    const COLUMNS: utinyint = 48;
    const ROWS: utinyint = 27;
    const CELL_COUNT: usmallint = 1296;

    const COLUMNS_OFFSET: usmallint = 2;
    const ROWS_OFFSET: usmallint = 3;
    const CHAR_BASE: usmallint = 4;
    const COLOR_BASE: usmallint = 4100;
    const INPUT_OFFSET: usmallint = 8196;
    const HOST_OFFSET: usmallint = 8197;

    // The raster list ./rasterline.8bs keeps: HOST_OFFSET + 1/2/3, the same
    // arithmetic agreementFor() in packages/cli/src/web-layout.mjs does.
    const RASTER_CONTROL_OFFSET: usmallint = 8198;
    const RASTER_COUNT_OFFSET: usmallint = 8199;
    const RASTER_BASE: usmallint = 8200;
    const RASTER_MAX_ENTRIES: utinyint = 64;

    // True where the grid can change under a running program. A build-time
    // fact, so `if (screen.RESIZABLE)` folds away entirely on every machine
    // that cannot — see ./screen.8bs.
    const RESIZABLE: bool = true;

    // The live grid. Zero means the host has not written yet: the program
    // starts the instant the worker has its memory, and the page writes these
    // when it first sees that memory, so there is a frame in which a program
    // that asks would otherwise get nothing. Answering with the compiled
    // default makes that frame lay out like a 16:9 window rather than like a
    // zero-column screen, and the next resized() corrects it.
    function columns(): utinyint {
        let live: utinyint = memory.read(Video.COLUMNS_OFFSET);
        if (live == 0) {
            return Video.COLUMNS;
        }
        return live;
    }

    function rows(): utinyint {
        let live: utinyint = memory.read(Video.ROWS_OFFSET);
        if (live == 0) {
            return Video.ROWS;
        }
        return live;
    }

    // Widened before the multiply, not after: columns() and rows() are both
    // utinyint, and 27 x 48 is 1296 — a product that does not fit in the type
    // its operands have. Every cell index on this host has the same hazard,
    // which is why a derived layout computes them in usmallint throughout.
    function cells(): usmallint {
        let wide: usmallint = Video.columns();
        return wide * Video.rows();
    }
}

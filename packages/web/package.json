{
  "name": "@8bitscript/web",
  "version": "0.23.0",
  "description": "Browser target support for 8BitScript: the hardware underneath the portable APIs, where the hardware is a canvas.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/8BitScript/8bitscript.git",
    "directory": "packages/web"
  },
  "8bitscript": {
    "title": "Web",
    "emulator": {
      "binary": null,
      "label": "the browser",
      "family": "browser",
      "screenshot": "web",
      "framesUnit": "frames",
      "defaultFrames": 180
    },
    "entry": "./src/index.8bs",
    "exports": {
      "./screen": "./src/screen.8bs",
      "./text": "./src/text.8bs",
      "./input": "./src/input.8bs",
      "./pointer": "./src/pointer.8bs",
      "./rasterline": "./src/rasterline.8bs"
    },
    "hardware": {
      "facts": {
        "video.columns": 48,
        "video.rows": 27,
        "video.cellWidth": 8,
        "video.cellHeight": 8,
        "video.palette": 16,
        "video.cellColors": 2,
        "video.colorPerCell": true,
        "video.glyphs": 0,
        "video.blockWidth": 2,
        "video.blockHeight": 2,
        "video.bitmap": false,
        "video.layers": 1,
        "video.scroll": false,
        "video.raster": true,
        "video.sprites": 0,
        "video.spritesPerLine": 0,
        "video.spriteWidth": 0,
        "video.spriteHeight": 0,
        "video.spriteColors": 0,
        "video.frameRate": 60,
        "audio.voices": 0,
        "audio.noise": false,
        "audio.envelope": false,
        "audio.filter": false,
        "audio.pcm": false,
        "audio.volume": false,
        "audio.entropy": false,
        "input.keyboard": true,
        "input.joysticks": 0,
        "input.pads": 0,
        "input.controls": [],
        "input.mouse": false,
        "input.paddles": false,
        "storage.save": false,
        "memory.ram": 57344,
        "memory.banked": false,
        "memory.bankedKib": 0,
        "storage.kib": 0
      },
      "options": {
        "machine": {
          "label": "Machine",
          "default": "hifi",
          "values": {
            "hifi": {
              "label": "16:9 high-fidelity host (48×27)",
              "tag": null,
              "build": {},
              "facts": {
                "video.columns": 48,
                "video.rows": 27,
                "video.palette": 16,
                "video.colorPerCell": true
              }
            },
            "pet-2001": {
              "label": "PET 2001 — 40×25 green phosphor, 4:3",
              "build": {},
              "facts": {
                "video.columns": 40,
                "video.rows": 25,
                "video.palette": 2,
                "video.cellColors": 2,
                "video.colorPerCell": false,
                "video.glyphs": 0,
                "video.frameRate": 60,
                "video.characterSetSwapped": true
              }
            },
            "c64": {
              "label": "Commodore 64 — 40×25, 16 colors, 4:3",
              "build": {},
              "facts": {
                "video.columns": 40,
                "video.rows": 25,
                "video.palette": 16,
                "video.cellColors": 2,
                "video.colorPerCell": true,
                "video.frameRate": 60
              }
            },
            "vic20": {
              "label": "VIC-20 — 22×23, 16 colors, 4:3",
              "build": {},
              "facts": {
                "video.columns": 22,
                "video.rows": 23,
                "video.palette": 16,
                "video.cellColors": 2,
                "video.colorPerCell": true,
                "video.frameRate": 60
              }
            }
          }
        }
      },
      "presets": {
        "c64": {
          "machine": "c64"
        },
        "pet-2001": {
          "machine": "pet-2001"
        },
        "vic20": {
          "machine": "vic20"
        }
      }
    }
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@8bitscript/web",
  "version": "0.27.0",
  "description": "Browser target support for 8BitScript: the hardware underneath the portable APIs, where the hardware is a canvas.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/8BitScript/8bitscript.git",
    "directory": "packages/web"
  },
  "8bitscript": {
    "title": "Web",
    "emulator": {
      "binary": null,
      "label": "the browser",
      "family": "browser",
      "screenshot": "web",
      "framesUnit": "frames",
      "defaultFrames": 180,
      "wasm": {
        "available": true
      }
    },
    "media": "./media/index.cjs",
    "entry": "./src/index.8bs",
    "exports": {

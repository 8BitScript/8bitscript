// What a sprite looks like on the C64: a 24 x 21 sprite, drawn into the
// first shape block at start-up — a ring, so the sprites read as objects
// rather than tiles. `shapes.8bs` beside this file is the other eight.
import { sprites as hardware } from "@8bitscript/c64/sprites";
import { spriteShapes } from "@8bitscript/c64/video";

// 21 rows of 3 bytes: a rounded ring, 24 wide.
const RING: array<utinyint, 63> = [
    0x00, 0x7E, 0x00,
    0x03, 0xFF, 0xC0,
    0x0F, 0xFF, 0xF0,
    0x1F, 0x81, 0xF8,
    0x3E, 0x00, 0x7C,
    0x7C, 0x00, 0x3E,
    0x78, 0x00, 0x1E,
    0xF0, 0x00, 0x0F,
    0xF0, 0x00, 0x0F,
    0xF0, 0x00, 0x0F,
    0xF0, 0x00, 0x0F,
    0xF0, 0x00, 0x0F,
    0xF0, 0x00, 0x0F,
    0xF0, 0x00, 0x0F,
    0x78, 0x00, 0x1E,
    0x7C, 0x00, 0x3E,
    0x3E, 0x00, 0x7C,
    0x1F, 0x81, 0xF8,
    0x0F, 0xFF, 0xF0,
    0x03, 0xFF, 0xC0,
    0x00, 0x7E, 0x00,
];

export namespace shapes {
    const ACTOR: utinyint = hardware.FIRST_BLOCK;

    function begin(): void {
        for (let i: utinyint = 0; i < 63; i++) {
            spriteShapes[hardware.blockOffset(shapes.ACTOR) + i] = RING[i];
        }
    }
}

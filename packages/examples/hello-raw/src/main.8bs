// Eleven stores. No text package, no strings, no function but main. The
// first program the native backend builds, and the acceptance test for the
// .prg writer, the BASIC stub, the assembler's encodings, and the first
// lowering rule: the build must be exactly the seventy bytes the "Hello,
// PET" roadmap lists, and `8bs run pet --screenshot` must show HELLO WORLD
// on row 0.
//
// The PET's screen is plain RAM at $8000, one byte per cell, 40 columns by
// 25 rows, cell 0 top-left. The bytes are screen codes, not ASCII: A to Z
// are 1 to 26, space is 32. A 3032 boots in the upper-case set, so nothing
// else has to be set up before the first byte is visible.
export function main(): void {
    memory.write(0x8000, 8);   // H
    memory.write(0x8001, 5);   // E
    memory.write(0x8002, 12);  // L
    memory.write(0x8003, 12);  // L
    memory.write(0x8004, 15);  // O
    memory.write(0x8005, 32);
    memory.write(0x8006, 23);  // W
    memory.write(0x8007, 15);  // O
    memory.write(0x8008, 18);  // R
    memory.write(0x8009, 12);  // L
    memory.write(0x800A, 4);   // D
}

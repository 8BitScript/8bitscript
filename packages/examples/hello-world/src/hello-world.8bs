// The smallest whole program: blank the screen, print, return. The screen
// and text packages resolve per target — @8bitscript/pet/text on a PET
// build, @8bitscript/web/text on a web build — and each writes its own
// screen the way that machine wants; this file does not know which, which
// is the point of it.
//
// Four pillars: `.8bs` (this file), `Mark.8bx` (one compile-time
// composition), `mark.8bg` / `chime.8ba` (portable media). The logo and
// blip are the smallest assets that exercise graphics and audio on every
// release target; the greeting itself stays a direct `text.print()` so
// hello-bx remains the component-only proof.
import { screen } from "@8bitscript/screen";
import { text } from "@8bitscript/text";
import { audio } from "@8bitscript/audio";
import { chime } from "./chime.8ba";
import { Mark } from "./Mark.8bx";

export function main(): void {
    screen.blank();
    text.print(0, "Hello World!");
    Mark();
    audio.play(chime);
    audio.update();
    text.releaseCursor();
}

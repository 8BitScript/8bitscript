// The program 0.2.0 exists to run. The text package resolves per target —
// @8bitscript/pet/text on a PET build, @8bitscript/web/text on a web
// build — and each one writes its own screen the way that machine wants;
// this file does not know which. See the "Hello, PET" roadmap for the
// milestones between here and this actually building.
import { screen } from "@8bitscript/screen";
import { text } from "@8bitscript/text";

// Prints, then returns. There is no holding loop: main() falling off its
// end lands back in the BASIC SYS that started it, which prints READY. —
// the greeting stays on screen above the prompt, and the machine is given
// back in the character set it was launched in (`restoreOnExit`, on by
// default; see 8bitscript.config.ts).
export function main(): void {
    screen.blank();
    text.print(0, "Hello World!");
}

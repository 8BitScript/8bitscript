// The smallest whole program: blank the screen, print, return. The screen
// and text packages resolve per target — @8bitscript/pet/text on a PET
// build, @8bitscript/web/text on a web build — and each writes its own
// screen the way that machine wants; this file does not know which, which
// is the point of it.
import { screen } from "@8bitscript/screen";
import { text } from "@8bitscript/text";

// There is no holding loop in this file. On a PET or a VIC-20, main()
// falling off its end lands back in the BASIC SYS that started it, which
// prints READY. so the greeting stays on screen above the prompt. On the
// C64 that return would take the picture with it — setupVideo() has
// already banked the KERNAL out and the greeting lives at $E000, not on
// BASIC's $0400 — so the compiler's epilogue spins instead. The Atari
// does the same for its own reason. This file does not know which; that
// is the point of it.
//
// `"Hello World!"` is drawn as it is written, on every machine. On a PET
// that takes selecting the text character set, the only one holding both
// cases of the alphabet; the models that boot into the graphics set
// (every one but the 8032) are moved there and left there, because the
// bit is retroactive and putting it back would re-render the greeting it
// was switched for. See packages/pet/src/text.8bs for what each model
// ends up looking like.
export function main(): void {
    screen.blank();
    text.print(0, "Hello World!");
}

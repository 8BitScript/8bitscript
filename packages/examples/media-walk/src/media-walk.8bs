use @8bitscript::screen::screen;
use @8bitscript::audio::audio;
use @8bitscript::graphics::graphics;
use self::Walk::Walk;
use self::chime::chime;
use self::mark::mark;

pub fn main() {
    screen::blank();
    Walk();
    graphics::place(mark, 120, 0);
    audio::play(chime);
    loop {
        waitFrame();
        graphics::update();
        audio::update();
    }
}

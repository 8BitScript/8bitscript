// French — index.8bs's twin for `--locale fr`. CLDR fr: decimal ",",
// group U+202F narrow no-break space (1 234,5); a character grid has one
// space, so it is 32.
pub mod Locale {
    const DECIMAL: utinyint = 44; // ','
    const GROUP: utinyint = 32; // ' '
}

pub mod i18n {
    // Interpolate {name} slots in a catalog string. Folded at every
    // call site; the body is never linked on a retro build.
    fn format(template: string) {
    }
}

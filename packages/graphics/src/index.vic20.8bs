// @8bitscript/graphics on the VIC-20: quadrant-block cells, one or two wide
// and one or two high.
//
// This used to write the object's bitmap into a RAM character set at $1400
// and leave it at that. Three things were wrong with it, and the first one
// was fatal: $1400 is inside the program. A `.prg` loads at $1001 on the
// unexpanded machine and $1201 on an expanded one, so any program big
// enough to reach $1400 — hello-world is 1922 bytes, which reaches it
// either way — had its own code overwritten by the glyph stores. Measured
// under xvic: the store through $11/$12 at the fourth glyph byte turned a
// `LDA $1451,Y` into `LDA $7E00,Y`, execution fell through the data that
// followed into a BRK, and the KERNAL warm-started — which is why the
// greeting vanished and a bare `READY.` came back on a cleared screen.
//
// The second was that nothing ever pointed the VIC at that character set:
// `$9005` was only ever set to MEMORY_POINTER_UPPERCASE, the ROM font at
// $8000, so the glyphs were written somewhere the video chip does not read.
// The third was that `writeGlyph` ignored its own `slot`, so all eight
// objects shared one set of four characters.
//
// So this draws the way @8bitscript/pet does instead, for the same reason
// that package gives: the ROM already has the sixteen quadrant blocks, and
// using them costs no RAM, no character set, and nothing of the program.
//
// ---- what the build hands over -------------------------------------------
//
// packages/vic20/media/index.cjs works the picture out while the program is
// built: the sprite's frames are reduced to screen codes there, and what
// arrives here is those codes, `cells wide × cells high` per frame, frame
// after frame (`bind`), then the object's size, frame count and animation
// speed (`meta`). Nothing is worked out on the machine except where to put
// them. The codes live in one small pool shared by every object
// (`POOL` bytes); an object that does not fit is not drawn.
//
// ---- what drawing does ----------------------------------------------------
//
// The object is at the cell its position falls in — x and y are stage
// pixels, a cell is 8 of them, and the smallest move that shows is one
// cell. It is drawn into screen memory and color RAM, and:
//
//  * Cells that would fall off the screen are not drawn. The screen is the
//    22 × 23 cells at `Video.SCREEN`, and on a machine with 8K or more the
//    program starts right after it ($1201), so a store one cell past the
//    last would be a store into the program.
//  * Moving an object blanks the cells it was drawn in before it is drawn
//    in the new ones, so it leaves no trail. What was under it is not put
//    back — this is not the PET's `sprites` twin, which keeps what it
//    covered. Text printed where an object stands stays until the object
//    moves, and is blanked when it does; a program prints where objects
//    are not.
//  * Every update redraws every object that is on the screen, after the
//    ones that moved have been blanked, so objects that overlap come out
//    the same whichever of them moved (the later slot is on top), and an
//    object a program has printed over comes back on the next update.
//  * An object with more than one frame advances one frame every `every`
//    updates and starts over after the last.
import { Video } from "@8bitscript/vic20/geometry";

const MAX: utinyint = 8;
const POOL: utinyint = 64;
const INK: utinyint = 1; // white, the color text.8bs also defaults to
const SPACE: utinyint = 32;
const OFF: utinyint = 40; // a cell number past either edge of the screen

let pool: array<u8, 64>;     // the screen codes of every object's frames
let base: array<u8, 8>;      // where in the pool the object's codes start
let wide: array<u8, 8>;      // cells across, 1 or 2
let high: array<u8, 8>;      // cells down, 1 or 2
let stride: array<u8, 8>;    // cells in a frame: wide × high
let frames: array<u8, 8>;    // how many frames; 0 for an object that did not fit
let every: array<u8, 8>;     // updates per frame
let tick: array<u8, 8>;      // updates since the frame last changed
let frame: array<u8, 8>;     // the frame showing
let col: array<u8, 8>;       // the cell the object is placed at; OFF past the screen
let row: array<u8, 8>;
let seen: array<u8, 8>;      // 1 once placed
let drawn: array<u8, 8>;     // 1 while cells of it are on the screen
let drawnCol: array<u8, 8>;  // where they are
let drawnRow: array<u8, 8>;
let moved: array<u8, 8>;     // 1 until the cells it was drawn in have been blanked
let top: utinyint = 0;       // the first free byte of the pool

// The object's cells, drawn or (with `blank`) blanked at the cell it was
// drawn in. A cell past the screen's edge is skipped: `col` and `row` are
// capped at OFF, so adding a cell or two to either cannot wrap a byte.
function paint(slot: utinyint, blank: bool): void {
    let c0: utinyint = col[slot];
    let r0: utinyint = row[slot];
    if (blank) {
        c0 = drawnCol[slot];
        r0 = drawnRow[slot];
    }
    let at: usmallint = base[slot] + frame[slot] * stride[slot];
    let dy: utinyint = 0;
    while (dy < high[slot]) {
        let r: usmallint = r0 + dy; // 16 bits: row 12 times 22 does not fit a byte
        let line: usmallint = r * Video.COLUMNS;
        let dx: utinyint = 0;
        while (dx < wide[slot]) {
            let c: utinyint = c0 + dx;
            if (c < Video.COLUMNS && r < Video.ROWS) {
                let cell: usmallint = line + c;
                if (blank) {
                    memory.write(Video.SCREEN + cell, SPACE);
                } else {
                    memory.write(Video.SCREEN + cell, pool[at]);
                    memory.write(Video.COLOR + cell, INK);
                }
            }
            at = at + 1;
            dx = dx + 1;
        }
        dy = dy + 1;
    }
}

function flush(): void {
    let slot: utinyint = MAX;
    while (slot > 0) {
        slot = slot - 1;
        if (moved[slot] != 0 && drawn[slot] != 0) {
            paint(slot, true);
            drawn[slot] = 0;
        }
    }
    while (slot < MAX) {
        if (seen[slot] != 0) {
            paint(slot, false);
            drawn[slot] = 1;
            drawnCol[slot] = col[slot];
            drawnRow[slot] = row[slot];
            moved[slot] = 0;
        }
        slot = slot + 1;
    }
}

export namespace graphics {
    function bind(slot: utinyint, index: utinyint, value: utinyint): void {
        if (slot >= MAX) {
            return;
        }
        if (index == 0) {
            base[slot] = top;
        }
        let at: usmallint = base[slot] + index;
        if (at < POOL) {
            pool[at] = value;
        }
    }

    function meta(slot: utinyint, count: utinyint, rate: utinyint, which: utinyint, width: utinyint, height: utinyint): void {
        if (slot >= MAX) {
            return;
        }
        wide[slot] = width >> 3;
        high[slot] = height >> 3;
        stride[slot] = wide[slot] * high[slot];
        let end: usmallint = base[slot] + count * stride[slot];
        if (end > POOL) {
            frames[slot] = 0;
            return;
        }
        top = end;
        frames[slot] = count;
        every[slot] = rate;
        tick[slot] = 0;
        frame[slot] = 0;
    }

    function place(slot: utinyint, x: usmallint, y: usmallint): void {
        if (slot >= MAX) {
            return;
        }
        if (frames[slot] == 0) {
            return;
        }
        col[slot] = OFF;
        if (x < 320) {
            col[slot] = x >> 3;
        }
        row[slot] = OFF;
        if (y < 320) {
            row[slot] = y >> 3;
        }
        seen[slot] = 1;
        moved[slot] = 1;
        flush();
    }

    function update(): void {
        let slot: utinyint = 0;
        while (slot < MAX) {
            if (seen[slot] != 0 && frames[slot] > 1) {
                tick[slot] = tick[slot] + 1;
                if (tick[slot] >= every[slot]) {
                    tick[slot] = 0;
                    frame[slot] = frame[slot] + 1;
                    if (frame[slot] >= frames[slot]) {
                        frame[slot] = 0;
                    }
                }
            }
            slot = slot + 1;
        }
        flush();
    }
}

// @8bitscript/graphics on the VIC-20: quadrant-block cells, one or two wide
// and one or two high.
//
// This used to write the object's bitmap into a RAM character set at $1400
// and leave it at that. Three things were wrong with it, and the first one
// was fatal: $1400 is inside the program. A `.prg` loads at $1001 on the
// unexpanded machine and $1201 on an expanded one, so any program big
// enough to reach $1400 — hello-world is 1922 bytes, which reaches it
// either way — had its own code overwritten by the glyph stores. Measured
// under xvic: the store through $11/$12 at the fourth glyph byte turned a
// `LDA $1451,Y` into `LDA $7E00,Y`, execution fell through the data that
// followed into a BRK, and the KERNAL warm-started — which is why the
// greeting vanished and a bare `READY.` came back on a cleared screen.
//
// The second was that nothing ever pointed the VIC at that character set:
// `$9005` was only ever set to MEMORY_POINTER_UPPERCASE, the ROM font at
// $8000, so the glyphs were written somewhere the video chip does not read.
// The third was that `writeGlyph` ignored its own `slot`, so all eight
// objects shared one set of four characters.
//
// So this draws the way @8bitscript/pet does instead, for the same reason
// that package gives: the ROM already has the sixteen quadrant blocks, and
// using them costs no RAM, no character set, and nothing of the program.
//
// ---- what the build hands over -------------------------------------------
//
// packages/vic20/media/index.cjs works the picture out while the program is
// built: the sprite's frames are reduced to screen codes there, and what
// arrives here is those codes, `cells wide × cells high` per frame, frame
// after frame (`bind`), then the object's size, frame count and animation
// speed (`meta`). Nothing is worked out on the machine except where to put
// them. The codes live in one small pool shared by every object
// (`POOL` bytes); an object that does not fit is not drawn.
//
// ---- what drawing does ----------------------------------------------------
//
// The object is at the cell its position falls in — x and y are stage
// pixels, a cell is 8 of them, and the smallest move that shows is one
// cell. It is drawn into screen memory and color RAM, and:
//
//  * Cells that would fall off the screen are not drawn. The screen is the
//    22 × 23 cells at `Video.SCREEN`, and on a machine with 8K or more the
//    program starts right after it ($1201), so a store one cell past the
//    last would be a store into the program.
//  * Moving or hiding an object blanks the cells it was drawn in before it
//    is drawn in the new ones, so it leaves no trail — and puts their color
//    RAM back to white (`INK`, the color text.8bs defaults to), so a
//    character a program stores there later is not in the object's color.
//    What was under it is not put back — this is not the PET's `sprites`
//    twin, which keeps what it covered. Text printed where an object stands
//    stays until the object moves, and is blanked when it does; a program
//    prints where objects are not.
//  * Every update redraws every object that is on the screen, after the
//    ones that moved have been blanked, so objects that overlap come out
//    the same whichever of them moved (the later slot is on top), and an
//    object a program has printed over comes back on the next update.
//  * An object with more than one frame advances one frame every `every`
//    updates and starts over after the last.
use @8bitscript::vic20::geometry::Video;

const SLOTS: utinyint = 8;
const POOL: utinyint = 64;
const INK: utinyint = 1; // white, the color text.8bs also defaults to
const SPACE: utinyint = 32;
const OFF: utinyint = 40; // a cell number past either edge of the screen

let mut pool: [u8; 64]; // the screen codes of every object's frames
let mut base: [u8; 8]; // where in the pool the object's codes start
let mut wide: [u8; 8]; // cells across, 1 or 2
let mut high: [u8; 8]; // cells down, 1 or 2
let mut stride: [u8; 8]; // cells in a frame: wide × high
let mut frames: [u8; 8]; // how many frames; 0 for an object that did not fit
let mut every: [u8; 8]; // updates per frame
let mut tick: [u8; 8]; // updates since the frame last changed
let mut frame: [u8; 8]; // the frame showing
let mut col: [u8; 8]; // the cell the object is placed at; OFF past the screen
let mut row: [u8; 8];
let mut ink: [u8; 8]; // the color RAM value its cells are drawn with
let mut paused: [u8; 8]; // 1: automatic stepping paused
let mut seen: [u8; 8]; // 1 once placed and not hidden
let mut drawn: [u8; 8]; // 1 while cells of it are on the screen
let mut drawnCol: [u8; 8]; // where they are
let mut drawnRow: [u8; 8];
let mut moved: [u8; 8]; // 1 until the cells it was drawn in have been blanked
let mut top: utinyint = 0; // the first free byte of the pool

// The object's cells, drawn or (with `blank`) blanked at the cell it was
// drawn in. A cell past the screen's edge is skipped: `col` and `row` are
// capped at OFF, so adding a cell or two to either cannot wrap a byte.
fn paint(slot: utinyint, blank: bool) {
    let mut c0: utinyint = col[slot];
    let mut r0: utinyint = row[slot];
    if blank {
        c0 = drawnCol[slot];
        r0 = drawnRow[slot];
    }
    let mut at: usmallint = base[slot] + frame[slot] * stride[slot];
    let mut dy: utinyint = 0;
    while dy < high[slot] {
        let r: usmallint = r0 + dy; // 16 bits: row 12 times 22 does not fit a byte
        let line: usmallint = r * Video::COLUMNS;
        let mut dx: utinyint = 0;
        while dx < wide[slot] {
            let c: utinyint = c0 + dx;
            if c < Video::COLUMNS && r < Video::ROWS {
                let cell: usmallint = line + c;
                if blank {
                    memory::write(Video::SCREEN + cell, SPACE);
                    memory::write(Video::COLOR + cell, INK); // not left in the ink it was drawn in
                } else {
                    memory::write(Video::SCREEN + cell, pool[at]);
                    memory::write(Video::COLOR + cell, ink[slot]);
                }
            }
            at = at + 1;
            dx = dx + 1;
        }
        dy = dy + 1;
    }
}

fn flush() {
    let mut slot: utinyint = SLOTS;
    while slot > 0 {
        slot = slot - 1;
        if moved[slot] != 0 && drawn[slot] != 0 {
            paint(slot, true);
            drawn[slot] = 0;
        }
    }
    while slot < SLOTS {
        if seen[slot] != 0 {
            paint(slot, false);
            drawn[slot] = 1;
            drawnCol[slot] = col[slot];
            drawnRow[slot] = row[slot];
            moved[slot] = 0;
        }
        slot = slot + 1;
    }
}

pub mod graphics {
    // The portable contract (index.8bs): what this machine answers.
    const MAX: utinyint = 8;
    const FRAMES: utinyint = 8; // the lowering keeps the first eight; the 64-byte pool is shared
    const WIDTH: utinyint = 16; // 2 × 2 cells
    const HEIGHT: utinyint = 16;
    const COLORS: utinyint = 1; // one color RAM value a cell
    const RECOLORS: bool = true; // color() sets what its cells are drawn with
    const STEP_X: utinyint = 8; // a cell
    const STEP_Y: utinyint = 8;
    const RESTORES: bool = false; // moving blanks the cells; what was under is not put back
    const TRANSPARENT: bool = false; // a cell is drawn whole

    fn bind(slot: utinyint, index: utinyint, value: utinyint) {
        if slot >= SLOTS {
            return;
        }
        if index == 0 {
            base[slot] = top;
        }
        let at: usmallint = base[slot] + index;
        if at < POOL {
            pool[at] = value;
        }
    }

    fn meta(slot: utinyint, count: utinyint, rate: utinyint, which: utinyint, width: utinyint, height: utinyint) {
        if slot >= SLOTS {
            return;
        }
        wide[slot] = width >> 3;
        high[slot] = height >> 3;
        stride[slot] = wide[slot] * high[slot];
        let end: usmallint = base[slot] + count * stride[slot];
        if end > POOL {
            frames[slot] = 0;
            return;
        }
        top = end;
        frames[slot] = count;
        every[slot] = rate;
        tick[slot] = 0;
        frame[slot] = 0;
        ink[slot] = INK;
        paused[slot] = 0;
    }

    fn place(slot: utinyint, x: usmallint, y: usmallint) {
        if slot >= SLOTS {
            return;
        }
        if frames[slot] == 0 {
            return;
        }
        col[slot] = OFF;
        if x < 320 {
            col[slot] = x >> 3;
        }
        row[slot] = OFF;
        if y < 320 {
            row[slot] = y >> 3;
        }
        seen[slot] = 1;
        moved[slot] = 1;
        flush();
    }

    fn hide(slot: utinyint) {
        if slot >= SLOTS {
            return;
        }
        seen[slot] = 0;
        moved[slot] = 1;
        flush();
    }

    // The frame shows from the next update().
    fn setFrame(slot: utinyint, n: utinyint) {
        if slot >= SLOTS {
            return;
        }
        if frames[slot] == 0 {
            return;
        }
        if n >= frames[slot] {
            n = frames[slot] - 1;
        }
        frame[slot] = n;
        tick[slot] = 0;
    }

    fn animate(slot: utinyint, on: bool) {
        if slot >= SLOTS {
            return;
        }
        paused[slot] = 1;
        if on {
            paused[slot] = 0;
        }
    }

    // The color shows from the next update(). A character takes one of the
    // first eight colors; color RAM's bit 3 would make its cells multicolor,
    // so 8–15 wrap to 0–7 — text.putColor does the same.
    fn color(slot: utinyint, c: utinyint) {
        if slot >= SLOTS {
            return;
        }
        ink[slot] = c & 0x07;
    }

    fn update() {
        let mut slot: utinyint = 0;
        while slot < SLOTS {
            if seen[slot] != 0 && frames[slot] > 1 && paused[slot] == 0 {
                tick[slot] = tick[slot] + 1;
                if tick[slot] >= every[slot] {
                    tick[slot] = 0;
                    frame[slot] = frame[slot] + 1;
                    if frame[slot] >= frames[slot] {
                        frame[slot] = 0;
                    }
                }
            }
            slot = slot + 1;
        }
        flush();
    }
}

// @8bitscript/graphics on the PET: a 4×4 quadrant-block object. The
// compiler's PET media lowering (packages/pet/media) hands over four bytes
// a frame, one nibble per row — a picture too faint to survive the
// downsample arrives as a small centre block, one frame — and bind() turns
// each frame into a shape of @8bitscript/sprites as it arrives.
//
// An animation spends one shape a frame, all defined here, once, before
// main() runs: the sprite layer erases a sprite by the shape it was drawn
// with, so a shape cannot be redefined while it is on screen, and
// defining one costs more than a frame. Changing frame is then one
// setShape(). The layer holds `sprites.SHAPES` shapes in all, shared by
// every picture in the program: a picture that does not fit gets the
// frames that do, and one that finds none left is not drawn. A static
// picture costs one shape, a four-frame walk four.
use @8bitscript::sprites::sprites;

const SLOTS: utinyint = 8;
let mut base: [u8; 8]; // a picture's first shape
let mut frameCount: [u8; 8]; // frames it has shapes for; 0: it is not drawn
let mut interval: [u8; 8];
let mut tick: [u8; 8];
let mut frame: [u8; 8];
let mut paused: [u8; 8]; // 1: automatic stepping paused
let mut held: [u8; 3]; // the rows of the frame bind() is part-way through
let mut used: utinyint = 0; // shapes handed out so far
let mut started: bool = false;

fn ensure() {
    if !started {
        sprites::begin(SLOTS);
        started = true;
    }
}

let mut hitX: [u16; 8];
let mut hitY: [u16; 8];
let mut hitOn: [u8; 8];
let mut hitL: [u8; 8];
let mut hitT: [u8; 8];
let mut hitR: [u8; 8];
let mut hitB: [u8; 8];

pub mod graphics {
    // The portable contract (index.8bs): what this machine answers.
    const MAX: utinyint = 8;
    const FRAMES: utinyint = sprites::SHAPES; // the layer's shapes are shared by every picture
    const WIDTH: utinyint = sprites::WIDTH; // 4 × 4 pseudo-pixels of 4 × 4 real pixels
    const HEIGHT: utinyint = sprites::HEIGHT;
    const COLORS: utinyint = 1; // the PET's one ink
    const RECOLORS: bool = false; // color() is a no-op: there is no colour to choose
    const STEP_X: utinyint = sprites::STEP_X; // a pseudo-pixel
    const STEP_Y: utinyint = sprites::STEP_Y;
    const RESTORES: bool = sprites::RESTORES; // what an object covers comes back
    const TRANSPARENT: bool = true; // an unlit pseudo-pixel merges with a quadrant block under it

    fn bind(slot: utinyint, index: utinyint, value: utinyint) {
        if slot >= SLOTS {
            return;
        }
        ensure();
        if index == 0 {
            base[slot] = used;
        }
        let row: utinyint = index & 3;
        if row < 3 {
            held[row] = value;
            return;
        }
        let shape: utinyint = base[slot] + (index >> 2);
        if shape < sprites::SHAPES {
            sprites::defineShape(shape, held[0], held[1], held[2], value);
            used = shape + 1;
        }
    }

    fn meta(slot: utinyint, frames: utinyint, every: utinyint, which: utinyint, width: utinyint, height: utinyint) {
        if slot >= SLOTS {
            return;
        }
        hitOn[slot] = 0;
        ensure();
        tick[slot] = 0;
        frame[slot] = 0;
        paused[slot] = 0;
        interval[slot] = every;
        // bind() stopped at the last shape that existed, so what was
        // defined is what `used` has moved past.
        let mut have: utinyint = 0;
        if used > base[slot] {
            have = used - base[slot];
        }
        if have > frames {
            have = frames;
        }
        frameCount[slot] = have;
        if have > 0 {
            sprites::setShape(slot, base[slot]);
        }
    }

    fn place(slot: utinyint, x: usmallint, y: usmallint) {
        if slot >= SLOTS {
            return;
        }
        hitX[slot] = x;
        hitY[slot] = y;
        hitOn[slot] = 1;
        ensure();
        if frameCount[slot] == 0 {
            return;
        }
        sprites::place(slot, x, y);
    }

    fn hide(slot: utinyint) {
        if slot >= SLOTS {
            return;
        }
        hitOn[slot] = 0;
        ensure();
        sprites::hide(slot);
    }

    fn setFrame(slot: utinyint, n: utinyint) {
        if slot >= SLOTS {
            return;
        }
        if frameCount[slot] == 0 {
            return;
        }
        ensure();
        if n >= frameCount[slot] {
            n = frameCount[slot] - 1;
        }
        frame[slot] = n;
        tick[slot] = 0;
        sprites::setShape(slot, base[slot] + n);
    }

    fn animate(slot: utinyint, on: bool) {
        if slot >= SLOTS {
            return;
        }
        paused[slot] = 1;
        if on {
            paused[slot] = 0;
        }
    }

    // Not yet, and not possible here: the PET has one ink, so there is no
    // colour to choose. graphics.RECOLORS is false.
    fn color(slot: utinyint, c: utinyint) {
    }

    fn update() {
        if !started {
            return;
        }
        for slot: utinyint in 0..SLOTS {
            if frameCount[slot] < 2 || paused[slot] != 0 {
                continue;
            }
            tick[slot] = tick[slot] + 1;
            if tick[slot] >= interval[slot] {
                tick[slot] = 0;
                frame[slot] = frame[slot] + 1;
                if frame[slot] >= frameCount[slot] {
                    frame[slot] = 0;
                }
                sprites::setShape(slot, base[slot] + frame[slot]);
            }
        }
        sprites::update();
    }

    // ---- hit ----
    fn bounds(slot: utinyint, left: utinyint, top: utinyint, right: utinyint, bottom: utinyint) {
        if slot >= SLOTS {
            return;
        }
        hitL[slot] = left;
        hitT[slot] = top;
        hitR[slot] = right;
        hitB[slot] = bottom;
    }

    fn hit(a: utinyint, b: utinyint) -> bool {
        if a == b || a >= SLOTS || b >= SLOTS {
            return false;
        }
        if hitOn[a] == 0 || hitOn[b] == 0 || hitR[a] == 0 || hitR[b] == 0 {
            return false;
        }
        if hitX[a] >= 32768 || hitY[a] >= 32768 || hitX[b] >= 32768 || hitY[b] >= 32768 {
            return false;
        }
        let aLeft: usmallint = hitL[a];
        let aTop: usmallint = hitT[a];
        let aRight: usmallint = hitR[a];
        let aBottom: usmallint = hitB[a];
        let bLeft: usmallint = hitL[b];
        let bTop: usmallint = hitT[b];
        let bRight: usmallint = hitR[b];
        let bBottom: usmallint = hitB[b];
        if hitX[a] + aLeft >= hitX[b] + bRight || hitX[b] + bLeft >= hitX[a] + aRight {
            return false;
        }
        if hitY[a] + aTop >= hitY[b] + bBottom || hitY[b] + bTop >= hitY[a] + aBottom {
            return false;
        }
        return true;
    }

    fn hitAny(a: utinyint) -> utinyint {
        for b: utinyint in 0..SLOTS {
            if graphics::hit(a, b) {
                return b;
            }
        }
        return 255;
    }
    // ---- end hit ----
}

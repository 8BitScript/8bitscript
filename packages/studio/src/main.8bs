// Studio's one entry: every machine starts here, and the machine picks the
// tier. System.CURRENT is a compile-time constant, so on any one build the
// other machines' branches cost nothing, and there is one file to read to
// see which machine gets what — see AGENTS.md for the tiers and why each
// machine sits where it does.
import { System } from "@8bitscript/system";
import { studio, Tier } from "./studio.8bs";

export function main(): void {
    let tier: utinyint = Tier.FULL;
    if (System.CURRENT == System.NES) {
        // No keyboard, and nowhere to save on the cartridge built today.
        tier = Tier.VIEWER;
    } else if (System.CURRENT == System.VIC20) {
        // No hardware sprites, and a little over 5K unexpanded.
        tier = Tier.BASIC;
    } else if (System.CURRENT == System.PET) {
        // No hardware sprites, and one voice with no volume.
        tier = Tier.BASIC;
    }
    studio.start(tier);
}

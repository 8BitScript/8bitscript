// Studio's one entry: every machine starts here, and the machine's facts
// pick the tier. Each fact is resolved by 8bitscript before any target
// toolchain runs, so on any one build the other tiers' branches cost
// nothing, and a tenth machine gets the right tier without anyone editing
// this file — see AGENTS.md for the tiers and what each needs.
import { Input, Video } from "@8bitscript/system";
import { studio, Tier } from "./studio.8bs";

export function main(): void {
    let tier: utinyint = Tier.FULL;
    if (!Input.KEYBOARD) {
        // Nothing to type with: look, don't edit. The NES, and the web
        // until its runtime reads keys.
        tier = Tier.VIEWER;
    } else if (Video.SPRITES == 0) {
        // Moving objects are software here, so the sprite editor stays
        // out: the VIC-20 and the PET.
        tier = Tier.BASIC;
    }
    studio.start(tier);
}

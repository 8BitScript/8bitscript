// 8BitScript Studio: the shared program every tier's entry file starts.
//
// What exists today is the front door — the title, the version, the tier
// this machine gets, and which of Studio's editors that tier opens — drawn
// with the same @8bitscript/screen and @8bitscript/text every program uses,
// so it builds and runs on all nine targets. Nothing behind the door exists
// yet: the language has no input, sound, sprite, or storage capability to
// build an editor on. AGENTS.md lists those prerequisites and the design
// each editor waits for; nothing here claims more than it draws.
import { screen, BorderColor, BackgroundColor } from "@8bitscript/screen";
import { text, TextColor } from "@8bitscript/text";
import { Audio, Storage, Video } from "@8bitscript/system";

// How much of Studio a machine gets. A higher tier opens every editor a
// lower one does, and a file is never tied to the tier that made it — the
// tier gates the editors, not the formats (see AGENTS.md).
//
// The tier says whether this machine edits at all; the facts below say
// which editors there is anything to edit *with*. So a viewer is
// read-only, not featureless: it still shows a character set and a sprite,
// plays a tune if the machine has a voice, and loads a file if the machine
// has anywhere to load one from — which is every PET and every VIC-20.
export namespace Tier {
    const VIEWER: utinyint = 0; // read-only: view, play, load — never edit or save
    const BASIC: utinyint = 1;  // the editors this machine's hardware has something for
    const FULL: utinyint = 2;   // every editor
}

// One row of cells on this machine's grid, resolved by 8bitscript from the
// text package the build picked: 22 on the VIC-20, 40 on a C64, 28 inside
// the NES's frame.
const ROW: usmallint = text.COLUMNS;

// The library's version: Studio ships with the toolchain, and its version
// is the toolchain's. test/studio.test.mjs checks this literal against
// package.json, which in turn is the workspace's one version.
const VERSION: string = "0.0.0";

// Helpers stay at top level: a namespace function reaches a sibling only
// through the namespace's name, and these are not part of Studio's surface.
function printTier(cell: usmallint, tier: utinyint): void {
    if (tier == Tier.FULL) {
        text.print(cell, "FULL TIER");
    }
    if (tier == Tier.BASIC) {
        text.print(cell, "BASIC TIER");
    }
    if (tier == Tier.VIEWER) {
        text.print(cell, "VIEWER TIER");
    }
}

// One line per editor: its name, then what this build can do in it — the
// tier for whether it edits, and the machine's own fact for whether there
// is anything to edit. Every row reads the same way: EDIT where both say
// so, and the best read-only thing the machine can do otherwise.
function printEditors(cell: usmallint, tier: utinyint): void {
    // Characters are editable where the program can redefine the font.
    // The PET's is in ROM, so a PET shows one and never changes it.
    text.print(cell, "CHARACTERS");
    if (tier != Tier.VIEWER && Video.GLYPHS > 0) {
        text.print(cell + 12, "EDIT");
    } else {
        text.print(cell + 12, "VIEW");
    }
    cell = cell + ROW;

    // Sprites are editable where the machine has hardware ones; elsewhere
    // a shape is still worth looking at on the display it is meant for.
    text.print(cell, "SPRITES");
    if (tier != Tier.VIEWER && Video.SPRITES > 0) {
        text.print(cell + 12, "EDIT");
    } else {
        text.print(cell + 12, "VIEW");
    }
    cell = cell + ROW;

    // Music needs more than one voice to be worth writing; one voice — the
    // PET's square wave — is enough to hear what someone else wrote.
    text.print(cell, "MUSIC");
    if (tier != Tier.VIEWER && Audio.VOICES > 1) {
        text.print(cell + 12, "EDIT");
    } else if (Audio.VOICES > 0) {
        text.print(cell + 12, "PLAY");
    } else {
        text.print(cell + 12, "VIEW");
    }
    cell = cell + ROW;

    // A viewer loads but never saves: reading a file is how an asset gets
    // onto the machine it is for. Where there is no storage at all — the
    // NES on a plain cartridge, the web — there is neither.
    text.print(cell, "FILES");
    if (tier != Tier.VIEWER && Storage.SAVE) {
        text.print(cell + 12, "LOAD SAVE");
    } else if (Storage.SAVE) {
        text.print(cell + 12, "LOAD");
    } else {
        text.print(cell + 12, "NONE");
    }
}

export namespace studio {

    // Blank and draw everything before the loop, the way every program
    // does: the NES only accepts screen writes while the picture is off,
    // and screen.blank() leaves it off until the first waitFrame().
    function start(tier: utinyint): void {
        screen.blank(BorderColor.BLUE, BackgroundColor.BLACK);
        text.setColor(TextColor.WHITE);

        let cell: usmallint = 0;
        text.print(cell, "8BITSCRIPT STUDIO");
        cell = cell + ROW;
        text.print(cell, "VERSION ");
        text.print(cell + 8, VERSION);
        cell = cell + ROW + ROW;
        printTier(cell, tier);
        cell = cell + ROW + ROW;
        printEditors(cell, tier);
        cell = cell + ROW + ROW + ROW + ROW + ROW;
        text.print(cell, "NO INPUT YET");

        while (true) {
            waitFrame();
        }
    }
}

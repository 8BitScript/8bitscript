// 8BitScript Studio: the shell and its modules. The shell paints the
// screen, puts the mark in the corner and runs the frame loop; a module
// draws everything else. The DAW (src/daw) is the only module today and
// Studio opens straight into it. Built on the same pillars as ever: the
// mark as media, the chime on start, the Commander X16 as the baseline.
import { screen, BorderColor, BackgroundColor } from "@8bitscript/screen";
import { text, TextColor } from "@8bitscript/text";
import { graphics } from "@8bitscript/graphics";
import { audio } from "@8bitscript/audio";
import { mark } from "./mark.8bg";
import { chime } from "./chime.8ba";
import { daw } from "./daw/daw.8bs";

function paint(): void {
    screen.blank(BorderColor.BLUE, BackgroundColor.BLACK);
    text.setColor(TextColor.WHITE);
}

export namespace studio {
    function start(): void {
        let columns: utinyint = text.columns();
        let rows: utinyint = text.rows();
        paint();
        daw.draw();
        graphics.place(mark, 4, 4);
        audio.play(chime);
        while (true) {
            waitFrame();
            // A fluid grid (the browser's) changes between frames: paint the
            // whole screen again on the new size.
            if (text.columns() != columns || text.rows() != rows) {
                columns = text.columns();
                rows = text.rows();
                paint();
                daw.draw();
            }
            graphics.update();
            audio.update();
        }
    }
}

// 8BitScript Studio: a bare top bar and the mark in the corner. Built on
// four pillars — Bar.8bx for the row, mark.8bg for the logo, chime.8ba on
// start, and the Commander X16 as the baseline machine everything else is
// measured against. Editors, menus and input wait on capabilities listed in
// AGENTS.md.
import { screen, BorderColor, BackgroundColor } from "@8bitscript/screen";
import { text, TextColor } from "@8bitscript/text";
import { menubar } from "@8bitscript/ui/menubar";
import { graphics } from "@8bitscript/graphics";
import { audio } from "@8bitscript/audio";
import { sprites } from "@8bitscript/sprites";
import { mark } from "./mark.8bg";
import { chime } from "./chime.8ba";
import { StudioBar } from "./Bar.8bx";

function paint(): void {
    screen.blank(BorderColor.BLUE, BackgroundColor.BLACK);
    menubar.setColors(TextColor.CYAN, TextColor.WHITE);
    text.setColor(TextColor.WHITE);
}

export namespace studio {
    function start(): void {
        paint();
        StudioBar();
        text.setColor(TextColor.WHITE);
        graphics.place(mark, sprites.ORIGIN_X + 4, sprites.ORIGIN_Y + 4);
        audio.play(chime);
        while (true) {
            waitFrame();
            graphics.update();
            audio.update();
        }
    }
}

// 8BitScript Studio: the shared program every tier's entry file starts.
//
// What exists today is the front door — the title, the version, the tier
// this machine gets, and which of Studio's editors that tier opens — drawn
// with the same @8bitscript/screen and @8bitscript/text every program uses,
// so it builds and runs on all nine targets. Nothing behind the door exists
// yet: the language has no sound, sprite, or storage capability to build an
// editor on. AGENTS.md lists those prerequisites and the design each editor
// waits for; nothing here claims more than it draws.
//
// **The bar moves now.** @8bitscript/input arrived, so the front door reads
// whatever the machine it is on has — a C64's cursor keys, an NES D-pad, an
// Atari joystick, a 1351 in a port, the X16's KERNAL mouse — and the
// highlight steps between the icon and FILE under it. The bar starts
// deselected, the way a menu bar does before anyone has touched it.
import { screen, BorderColor, BackgroundColor } from "@8bitscript/screen";
import { text, TextColor } from "@8bitscript/text";
import { input } from "@8bitscript/input";
import { pointer } from "@8bitscript/pointer";
import { Audio, Input, Storage, System, Video } from "@8bitscript/system";
import { menubar } from "@8bitscript/ui/menubar";

// How much of Studio a machine gets. A higher tier opens every editor a
// lower one does, and a file is never tied to the tier that made it — the
// tier gates the editors, not the formats (see AGENTS.md).
//
// The tier says whether this machine edits at all; the facts below say
// which editors there is anything to edit *with*. So a viewer is
// read-only, not featureless: it still shows a character set and a sprite,
// plays a tune if the machine has a voice, and loads a file if the machine
// has anywhere to load one from — which is every PET and every VIC-20.
export namespace Tier {
    const VIEWER: utinyint = 0; // read-only: view, play, load — never edit or save
    const BASIC: utinyint = 1;  // the editors this machine's hardware has something for
    const FULL: utinyint = 2;   // every editor
}

// One row of cells on this machine's grid, resolved by 8bitscript from the
// text package the build picked: 22 on the VIC-20, 40 on a C64, 28 inside
// the NES's frame.
const ROW: usmallint = text.COLUMNS;

// The library's version: Studio ships with the toolchain, and its version
// is the toolchain's. test/studio.test.mjs checks this literal against
// package.json, which in turn is the workspace's one version.
const VERSION: string = "0.2.6";

// Studio's menu bar, across the top row on every machine, from
// @8bitscript/ui — the first component Studio takes from the shared
// library rather than drawing itself.
//
// **It is Studio's mark and one menu**, and that is the whole bar for now.
// A desktop's leftmost item is its own badge rather than a word, and the
// menus beside it arrive as there is something behind them to open; FILE
// is the one that has meaning on every machine, because every machine
// either loads or does not and the front door already says which.
//
// Two cells and four letters fits every one of the nine, including the
// VIC-20's 22 columns and the NES's 28 — which is why there is no longer
// a short-name branch here. The four-editor bar this used to draw needed
// 35 cells and had to be abbreviated on two machines; a bar that fits
// everywhere needs no abbreviating, and the editors it named are reached
// from the FILE menu's own list rather than from the top row.
function drawMenu(): void {
    menubar.begin(0, text.COLUMNS);
    menubar.icon();
    menubar.item("FILE");
    menubar.end();
}

// Helpers stay at top level: a namespace function reaches a sibling only
// through the namespace's name, and these are not part of Studio's surface.
function printTier(cell: usmallint, tier: utinyint): void {
    if (tier == Tier.FULL) {
        text.print(cell, "FULL TIER");
    }
    if (tier == Tier.BASIC) {
        text.print(cell, "BASIC TIER");
    }
    if (tier == Tier.VIEWER) {
        text.print(cell, "VIEWER TIER");
    }
}

// One line per editor: its name, then what this build can do in it — the
// tier for whether it edits, and the machine's own fact for whether there
// is anything to edit. Every row reads the same way: EDIT where both say
// so, and the best read-only thing the machine can do otherwise.
function printEditors(cell: usmallint, tier: utinyint): void {
    // Characters are editable where the program can redefine the font.
    // The PET's is in ROM, so a PET shows one and never changes it.
    text.print(cell, "CHARACTERS");
    if (tier != Tier.VIEWER && Video.GLYPHS > 0) {
        text.print(cell + 12, "EDIT");
    } else {
        text.print(cell + 12, "VIEW");
    }
    cell = cell + ROW;

    // Sprites are editable where the machine has hardware ones; elsewhere
    // a shape is still worth looking at on the display it is meant for.
    text.print(cell, "SPRITES");
    if (tier != Tier.VIEWER && Video.SPRITES > 0) {
        text.print(cell + 12, "EDIT");
    } else {
        text.print(cell + 12, "VIEW");
    }
    cell = cell + ROW;

    // Music needs more than one voice to be worth writing; one voice — the
    // PET's square wave — is enough to hear what someone else wrote.
    text.print(cell, "MUSIC");
    if (tier != Tier.VIEWER && Audio.VOICES > 1) {
        text.print(cell + 12, "EDIT");
    } else if (Audio.VOICES > 0) {
        text.print(cell + 12, "PLAY");
    } else {
        text.print(cell + 12, "VIEW");
    }
    cell = cell + ROW;

    // A viewer loads but never saves: reading a file is how an asset gets
    // onto the machine it is for. Where there is no storage at all — the
    // NES on a plain cartridge, the web — there is neither.
    text.print(cell, "FILES");
    if (tier != Tier.VIEWER && Storage.SAVE) {
        text.print(cell + 12, "LOAD SAVE");
    } else if (Storage.SAVE) {
        text.print(cell + 12, "LOAD");
    } else {
        text.print(cell + 12, "NONE");
    }
}

export namespace studio {

    // Blank and draw everything before the loop, the way every program
    // does: the NES only accepts screen writes while the picture is off,
    // and screen.blank() leaves it off until the first waitFrame().
    function start(tier: utinyint): void {
        screen.blank(BorderColor.BLUE, BackgroundColor.BLACK);

        // The bar first, then the front door's own color: drawing a bar
        // leaves the text color set to the bar's, because that is how the
        // component gets its colors on without a second pass over every
        // cell it just wrote (see packages/ui/AGENTS.md). A program that
        // cares picks its color after the bar, not before.
        menubar.setColors(TextColor.CYAN, TextColor.WHITE);
        drawMenu();
        text.setColor(TextColor.WHITE);

        // The front door starts on the row after the bar. menubar.HEIGHT is
        // how a program lays out under a bar without knowing how tall one
        // is, and both it and ROW are constants, so this is one number by
        // the time the machine sees it.
        let cell: usmallint = menubar.HEIGHT * ROW;
        text.print(cell, "8BITSCRIPT STUDIO");
        cell = cell + ROW;
        text.print(cell, "VERSION ");
        text.print(cell + 8, VERSION);
        cell = cell + ROW + ROW;
        printTier(cell, tier);
        cell = cell + ROW + ROW;
        printEditors(cell, tier);
        cell = cell + ROW + ROW + ROW + ROW + ROW;

        // What is driving the bar on this machine. `Input.KEYBOARD` and
        // `Input.PADS` are facts folded while compiling, so each machine
        // compiles the one line that is true of it and none of the others:
        // the NES says PAD, the computers (including the X16, which has a
        // keyboard even though this layer does not read it yet) say KEYS,
        // and the web reads arrow keys through the runtime's snapshot and
        // says KEYS too — it is still a viewer because it has nothing to
        // edit.
        text.print(cell, "INPUT ");
        if (Input.KEYBOARD) {
            text.print(cell + 6, "KEYS");
        } else if (Input.PADS > 0) {
            text.print(cell + 6, "PAD");
        } else {
            text.print(cell + 6, "NONE");
        }

        // Once, before the first poll: on a machine with a pointer this
        // gives it its ceiling and points the hardware at the right port;
        // elsewhere it is an empty call.
        input.begin();

        // And the arrow the user aims with, on the machines that have
        // something to draw one with — one of the VIC's sprites on a C64
        // or C128 fitted with a mouse, the KERNAL's own sprite on the X16.
        // `pointer.DRAWS` is a compile-time constant, so on the other six
        // this call and the update() below are deleted rather than made.
        pointer.begin();
        pointer.setColor(TextColor.WHITE);

        // Where the pointer last sat, as a cell. `point()` is updated
        // whenever it changes so a click can read `pointed()`; the bar is
        // not redrawn for that — nothing on screen changes. 65535 is
        // `menubar`'s own "no pointer" cell, so the first real reading
        // always counts as a move.
        let pointerCell: usmallint = 65535;

        while (true) {
            waitFrame();
            // Exactly once a frame, and never twice — every direction is
            // edge-triggered, so a second poll would see each press once
            // and then swallow it.
            input.poll();
            // Right after the poll that moved it, and once a frame like the
            // poll: the arrow is drawn where the mouse got to this frame.
            pointer.update();

            let moved: bool = false;

            // The pointer, on a build fitted with one. `input.pointer()` is
            // a constant false everywhere else, so on a machine without a
            // mouse — and on a stock C64 — this whole block is proved dead
            // and deleted rather than tested every frame. The X16's stock
            // sheet has a mouse, so this is live there.
            if (input.pointer()) {
                let at: usmallint = input.pointerCell();
                if (at != pointerCell) {
                    pointerCell = at;
                    menubar.point(at);
                }
                // A click takes the item under the pointer, and clicking
                // the bar's own padding or anywhere off it means "nothing"
                // — the same thing RUN/STOP means.
                if (input.pointerButton()) {
                    let over: utinyint = menubar.pointed();
                    if (over == menubar.NONE) {
                        if (menubar.selected() != menubar.NONE) {
                            menubar.deselect();
                            moved = true;
                        }
                    } else {
                        if (over != menubar.selected()) {
                            menubar.select(over);
                            moved = true;
                        }
                    }
                }
            }

            if (input.right()) {
                menubar.next();
                moved = true;
            }
            if (input.left()) {
                menubar.previous();
                moved = true;
            }
            if (input.cancel()) {
                menubar.deselect();
                moved = true;
            }
            if (moved) {
                // Redraw the bar and put the color back the way the
                // opening sequence above does: a bar leaves the text
                // color set to its own.
                // waitFrame() returns in the top half of the frame, while
                // VIC-II is about to scan the bar. Rewrite it after that
                // row has been drawn this frame.
                if (#system() == System.C64 || #system() == System.C128) {
                    let line: utinyint = memory.read(0xD012);
                    while (line < 58) {
                        line = memory.read(0xD012);
                    }
                }
                drawMenu();
                text.setColor(TextColor.WHITE);
            }
        }
    }
}

{
  "name": "@8bitscript/studio",
  "version": "0.22.1",
  "description": "8BitScript Studio: the asset editor that ships with the toolchain and runs on the machines themselves \u2014 characters, sprites, and music, with the full editor on the Commander X16, a smaller one on an expanded VIC-20, and a read-only viewer on the PET and the NES.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/8BitScript/8bitscript.git",
    "directory": "packages/studio"
  },
  "type": "module",
  "8bitscript": {
    "app": {
      "title": "Studio",
      "entry": "./src/main.8bs"
    }
  },
  "files": [
    "src",
    "8bs.config.ts"
  ],
  "scripts": {
    "start": "8bs run cx16",
    "start:cx16": "8bs run cx16",
    "start:cx16-web": "8bs run cx16 --web",
    "start:c64": "8bs run c64",
    "start:vic20": "8bs run vic20",
    "start:pet": "8bs run pet",
    "start:web": "8bs run web",
    "test": "node --test",
    "build": "8bs build --target pet"
  },
  "dependencies": {
    "@8bitscript/audio": "workspace:*",
    "@8bitscript/graphics": "workspace:*",
    "@8bitscript/screen": "workspace:*",
    "@8bitscript/sprites": "workspace:*",
    "@8bitscript/text": "workspace:*",
    "@8bitscript/ui": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}

// BX wrappers over the menu bar beside this file — same immediate-mode calls,
// composed declaratively. Elaboration inlines to menubar.begin/item/end.
import { menubar } from "./menubar.8bs";

component MenuBar(row: utinyint, width: usmallint) {
    menubar.begin(row, width);
}

component MenuItem(label: string) {
    menubar.item(label);
}

component MenuBarEnd() {
    menubar.end();
}

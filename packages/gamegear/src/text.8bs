import { Video } from "./geometry.8bs";

let ink: utinyint = 1;

export namespace text {
    const CELL_COUNT: usmallint = Video.CELL_COUNT;
    const COLUMNS: utinyint = Video.COLUMNS;
    const ROWS: utinyint = Video.ROWS;

    function columns(): utinyint {
        return text.COLUMNS;
    }

    function rows(): utinyint {
        return text.ROWS;
    }

    function releaseCursor(): void {
    }

    function setReverse(on: bool): void {
    }

    function setColor(color: utinyint): void {
        ink = color;
    }

    function putChar(cell: usmallint, code: utinyint): void {
        // Game Gear LCD is 160×144 of the SMS 256×192: the visible origin is
        // tile (6, 3). Nametable at $3800, two bytes per cell. ASCII is the
        // tile index the CRT0 font loaded (space = 32).
        let row: usmallint = 3 + cell / text.COLUMNS;
        let col: usmallint = 6 + cell % text.COLUMNS;
        let addr: usmallint = 0x3800 + (row * 32 + col) * 2;
        port.write(0xBF, addr % 256);
        port.write(0xBF, 64 + addr / 256);
        port.write(0xBE, code);
        port.write(0xBE, 0);
    }

    function putColor(cell: usmallint, color: utinyint): void {
    }

    function print(cell: usmallint, s: string): void {
        for (let i: utinyint = 0; i < s.length; i++) {
            text.putChar(cell + i, s[i]);
        }
    }


    function fill(cell: usmallint, count: usmallint, code: utinyint): void {
        for (let i: usmallint = 0; i < count; i++) {
            text.putChar(cell + i, code);
        }
    }

    function printNumber(cell: usmallint, value: usmallint, width: utinyint): void {
        let n: usmallint = value;
        let i: utinyint = width;
        while (i > 0) {
            i = i - 1;
            let digit: utinyint = 0;
            let place: usmallint = 1;
            let w: utinyint = 0;
            while (w < i) {
                place = place * 10;
                w = w + 1;
            }
            while (n >= place) {
                n = n - place;
                digit = digit + 1;
            }
            text.putChar(cell + i, 48 + digit);
        }
    }
}

export namespace TextColor {
    const BLACK: utinyint = 0;
    const WHITE: utinyint = 1;
    const RED: utinyint = 2;
    const CYAN: utinyint = 3;
    const PURPLE: utinyint = 4;
    const GREEN: utinyint = 5;
    const BLUE: utinyint = 6;
    const YELLOW: utinyint = 7;
}

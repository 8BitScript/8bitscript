{
  "name": "@8bitscript/gamegear",
  "version": "0.22.1",
  "description": "Sega Game Gear target support for 8BitScript: the hardware underneath the portable APIs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/8BitScript/8bitscript.git",
    "directory": "packages/gamegear"
  },
  "8bitscript": {
    "title": "Sega Game Gear",
    "emulator": {
      "binary": "mednafen",
      "family": "dedicated",
      "screenshot": "window",
      "framesUnit": "frames",
      "defaultFrames": 180,
      "installer": "mednafen",
      "deferred": "Mednafen is a GUI app"
    },
    "entry": "./src/index.8bs",
    "exports": {
      "./screen": "./src/screen.8bs",
      "./text": "./src/text.8bs",
      "./input": "./src/input.8bs",
      "./pointer": "./src/pointer.8bs",
      "./rasterline": "./src/rasterline.8bs"
    },
    "hardware": {
      "build": {
        "defsym": {
          "__load_address": 0,
          "__ram_size": 8
        },
        "output": "gg"
      },
      "facts": {
        "video.columns": 20,
        "video.rows": 18,
        "video.cellWidth": 8,
        "video.cellHeight": 8,
        "video.palette": 4096,
        "video.cellColors": 2,
        "video.colorPerCell": false,
        "video.glyphs": 0,
        "video.blockWidth": 0,
        "video.blockHeight": 0,
        "video.bitmap": false,
        "video.layers": 1,
        "video.scroll": false,
        "video.raster": false,
        "video.sprites": 64,
        "video.spritesPerLine": 8,
        "video.spriteWidth": 8,
        "video.spriteHeight": 16,
        "video.spriteColors": 15,
        "video.frameRate": 60,
        "audio.voices": 4,
        "audio.noise": true,
        "audio.envelope": false,
        "audio.filter": false,
        "audio.pcm": false,
        "audio.volume": false,
        "audio.entropy": false,
        "input.keyboard": false,
        "input.joysticks": 0,
        "input.pads": 1,
        "input.controls": [
          "up",
          "down",
          "left",
          "right",
          "a",
          "b",
          "start"
        ],
        "input.mouse": false,
        "input.paddles": false,
        "storage.save": false,
        "storage.kib": 0,
        "memory.ram": 8192,
        "memory.banked": false,
        "memory.bankedKib": 0
      },
      "options": {},
      "presets": {}
    }
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test"
  }
}

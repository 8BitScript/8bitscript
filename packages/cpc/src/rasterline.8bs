pub mod Slot {
    const BORDER: utinyint = 0;
    const BACKGROUND: utinyint = 1;
    const SCROLL_X: utinyint = 2;
    const CHARSET: utinyint = 3; // the machine's alternate character set, where one exists
}

pub mod raster {
    const ENTRIES: utinyint = 0;
    const STRIDE: utinyint = 0;
    const FINE_SCROLL: bool = false; // Slot.SCROLL_X entries are refused
    const COLORS: bool = false; // Slot.BORDER/BACKGROUND entries are accepted
    const CHARSET: bool = false; // Slot.CHARSET entries are refused
    const FRAME_COUNTER: bool = false; // no video-frame counter: frame() answers 0

    fn clear() {
    }

    fn at(line: utinyint, slot: utinyint, value: utinyint) -> bool {
        return false;
    }

    fn insert(line: utinyint, slot: utinyint, value: utinyint) -> bool {
        return false;
    }

    fn setValue(entry: utinyint, value: utinyint) -> bool {
        return false;
    }

    fn commit() {
    }

    fn count() -> utinyint {
        return 0;
    }

    fn frame() -> utinyint {
        return 0;
    }

    fn enable() {
    }

    fn disable() {
    }
}

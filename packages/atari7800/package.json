{
  "name": "@8bitscript/atari7800",
  "version": "0.23.0",
  "description": "Atari 7800 target support for 8BitScript: the hardware underneath the portable APIs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/8BitScript/8bitscript.git",
    "directory": "packages/atari7800"
  },
  "8bitscript": {
    "title": "Atari 7800",
    "emulator": {
      "binary": "mame",
      "family": "mame",
      "screenshot": "mame",
      "framesUnit": "seconds",
      "defaultFrames": 8,
      "installer": "mame",
      "system": "a7800",
      "deferred": "MAME needs a ROM set this project does not ship",
      "slot": "cart"
    },
    "entry": "./src/index.8bs",
    "exports": {
      "./screen": "./src/screen.8bs",
      "./text": "./src/text.8bs",
      "./input": "./src/input.8bs",
      "./pointer": "./src/pointer.8bs",
      "./rasterline": "./src/rasterline.8bs"
    },
    "hardware": {
      "build": {
        "defsym": {
          "__load_address": 32768,
          "__rom_size": 32768,
          "__bss_origin": 512,
          "__bss_ceiling": 4608,
          "__ram_ceiling": 65536
        },
        "output": "a78",
        "mameSystem": "a7800"
      },
      "facts": {
        "video.columns": 20,
        "video.rows": 12,
        "video.cellWidth": 8,
        "video.cellHeight": 8,
        "video.palette": 256,
        "video.cellColors": 2,
        "video.colorPerCell": false,
        "video.glyphs": 0,
        "video.blockWidth": 0,
        "video.blockHeight": 0,
        "video.bitmap": false,
        "video.layers": 1,
        "video.scroll": false,
        "video.raster": true,
        "video.sprites": 30,
        "video.spritesPerLine": 30,
        "video.spriteWidth": 32,
        "video.spriteHeight": 16,
        "video.spriteColors": 3,
        "video.frameRate": 60,
        "audio.voices": 2,
        "audio.noise": true,
        "audio.envelope": false,
        "audio.filter": false,
        "audio.pcm": false,
        "audio.volume": false,
        "audio.entropy": false,
        "input.keyboard": false,
        "input.joysticks": 2,
        "input.pads": 0,
        "input.controls": [
          "up",
          "down",
          "left",
          "right",
          "a"
        ],
        "input.mouse": false,
        "input.paddles": false,
        "storage.save": false,
        "storage.kib": 0,
        "memory.ram": 4096,
        "memory.banked": false,
        "memory.bankedKib": 0
      },
      "options": {},
      "presets": {}
    }
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test"
  }
}

// The VIC-20's raster list under xvic, read by test/raster.test.mjs.
// A list built once and enable()d must show on every frame with the
// program's own loop running (waitFrame() applies it — the VIC has no
// interrupt), each entry exactly at its picture line:
//
//   border:     black above 30, red 30-99, green 100-139, black 140 on
//   background: yellow above 60, green 60-61, red 62-139, yellow 140 on
//
// Line 60's value is built blue and rewritten to green by setValue after
// fifty frames, with no commit(): green there proves the loop ran and the
// rewrite went live. Line 61's entry is one line below 60's, and is
// planned two lines below it (62) — the two-line rule. Line 140 is two
// entries on one line, one store pair.
import { raster, Slot } from "@8bitscript/raster";
import { screen } from "@8bitscript/screen";
import { text } from "@8bitscript/text";

let frames: usmallint = 0;

export function main(): void {
    screen.blank();
    raster.clear();
    raster.at(30, Slot.BORDER, 2);
    raster.at(60, Slot.BACKGROUND, 6);
    raster.at(61, Slot.BACKGROUND, 2);
    raster.at(100, Slot.BORDER, 5);
    raster.at(140, Slot.BORDER, 0);
    raster.at(140, Slot.BACKGROUND, 7);
    raster.enable();
    while (true) {
        waitFrame();
        frames = frames + 1;
        if (frames == 50) {
            raster.setValue(3, 5);
        }
        text.printNumber(0, frames, 5);
    }
}

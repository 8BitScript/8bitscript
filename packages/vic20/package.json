{
  "name": "@8bitscript/vic20",
  "version": "0.3.0",
  "description": "VIC-20 target support for 8BitScript: the hardware underneath the portable APIs. Parked in 0.2.0: not a build target until its native backend lands.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/8BitScript/8bitscript.git",
    "directory": "packages/vic20"
  },
  "8bitscript": {
    "entry": "./src/index.8bs",
    "exports": {
      "./screen": "./src/screen.8bs",
      "./text": "./src/text.8bs",
      "./input": "./src/input.8bs",
      "./pointer": "./src/pointer.8bs",
      "./keyboard": "./src/keyboard.8bs",
      "./keys": "./src/keys.8bs"
    },
    "hardware": {
      "facts": {
        "video.columns": 22,
        "video.rows": 23,
        "video.cellWidth": 8,
        "video.cellHeight": 8,
        "video.palette": 16,
        "video.cellColors": 2,
        "video.colorPerCell": true,
        "video.glyphs": 256,
        "video.blockWidth": 2,
        "video.blockHeight": 2,
        "video.bitmap": false,
        "video.layers": 1,
        "video.scroll": false,
        "video.sprites": 0,
        "video.spritesPerLine": 0,
        "video.spriteWidth": 0,
        "video.spriteHeight": 0,
        "video.spriteColors": 0,
        "video.frameRate": 60,
        "audio.voices": 4,
        "audio.noise": true,
        "audio.envelope": false,
        "audio.filter": false,
        "audio.pcm": false,
        "audio.volume": false,
        "audio.entropy": false,
        "input.keyboard": true,
        "input.joysticks": 1,
        "input.pads": 0,
        "input.mouse": false,
        "input.paddles": false,
        "storage.save": true,
        "memory.ram": 3583,
        "memory.banked": false,
        "memory.bankedKib": 0,
        "storage.kib": 164
      },
      "options": {
        "ram": {
          "label": "RAM expansion",
          "default": "none",
          "values": {
            "none": {
              "label": "Unexpanded (3583 bytes for the program)",
              "build": {
                "defsym": {
                  "__memory_expansion": 0
                }
              },
              "run": {
                "xvic": [
                  "-memory",
                  "none"
                ]
              },
              "facts": {
                "memory.ram": 3583
              }
            },
            "3k": {
              "label": "3K (VIC-1210): $0400-$0FFF",
              "tag": "3k",
              "build": {
                "defsym": {
                  "__memory_expansion": 3
                }
              },
              "run": {
                "xvic": [
                  "-memory",
                  "3k"
                ]
              },
              "facts": {
                "memory.ram": 6655
              }
            },
            "8k": {
              "label": "8K: screen moves to $1000",
              "tag": "expanded",
              "build": {
                "defsym": {
                  "__memory_expansion": 8
                }
              },
              "run": {
                "xvic": [
                  "-memory",
                  "8k"
                ]
              },
              "facts": {
                "memory.ram": 11775
              }
            },
            "16k": {
              "label": "16K: screen moves to $1000",
              "tag": "expanded",
              "build": {
                "defsym": {
                  "__memory_expansion": 16
                }
              },
              "run": {
                "xvic": [
                  "-memory",
                  "16k"
                ]
              },
              "facts": {
                "memory.ram": 19967
              }
            },
            "24k": {
              "label": "24K: screen moves to $1000",
              "tag": "expanded",
              "build": {
                "defsym": {
                  "__memory_expansion": 24
                }
              },
              "run": {
                "xvic": [
                  "-memory",
                  "24k"
                ]
              },
              "facts": {
                "memory.ram": 28159
              }
            }
          }
        },
        "port1": {
          "label": "Control port 1",
          "default": "joystick",
          "values": {
            "none": {
              "label": "Nothing plugged in",
              "run": {
                "xvic": [
                  "-controlport1device",
                  "0"
                ]
              }
            },
            "joystick": {
              "label": "Joystick",
              "run": {
                "xvic": [
                  "-controlport1device",
                  "1"
                ]
              }
            },
            "paddles": {
              "label": "Paddles",
              "run": {
                "xvic": [
                  "-controlport1device",
                  "2"
                ]
              },
              "facts": {
                "input.paddles": true
              }
            },
            "mouse1351": {
              "label": "Commodore 1351 mouse",
              "run": {
                "xvic": [
                  "-controlport1device",
                  "3",
                  "-mouse"
                ]
              },
              "facts": {
                "input.mouse": true
              }
            }
          }
        },
        "drive": {
          "label": "Disk drive",
          "default": "1541",
          "values": {
            "1541": {
              "label": "1541 (170K disk)",
              "facts": {
                "storage.save": true,
                "storage.kib": 164
              },
              "tag": null
            },
            "1581": {
              "label": "1581 (800K disk)",
              "facts": {
                "storage.save": true,
                "storage.kib": 783
              },
              "tag": null
            },
            "none": {
              "label": "No drive (tape or nothing)",
              "facts": {
                "storage.save": false,
                "storage.kib": 0
              },
              "tag": null
            }
          }
        }
      },
      "presets": {
        "unexpanded": {
          "ram": "none"
        },
        "3k": {
          "ram": "3k"
        },
        "8k": {
          "ram": "8k"
        },
        "16k": {
          "ram": "16k"
        },
        "24k": {
          "ram": "24k"
        }
      }
    }
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  }
}

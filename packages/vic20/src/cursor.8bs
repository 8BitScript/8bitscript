// The one real-hardware-only piece of @8bitscript/vic20/text's
// releaseCursor(): the KERNAL's own PLOT call. Split out of text.8bs so it
// alone can carry a `.web` twin (cursor.vic20.web.8bs) — see that file, and
// build.mjs's own comment on the `web` tag it resolves against — rather
// than duplicating everything else in text.8bs just to change this one
// function. text.8bs's `releaseCursor()` calls this and does nothing else,
// so the linker's single-call-site inlining folds the two back into one on
// every build, real hardware or wasm.
//
// Tells the KERNAL screen editor the cursor is at the start of row 1,
// through PLOT ($FFF0: carry clear, row in X, column in Y). print()/
// putChar() write straight into screen memory, which the editor's own
// cursor tracking never sees, so without this BASIC's next PRINT —
// READY. included — lands wherever the cursor was before the program
// ran, not under what the program just drew.
//
// Row 1 rather than row 0: PLOT's own pointer math walks the screen
// line link table ($D9, one byte per row — bit 7 clear on a row means
// "this row continues the one above") looking for where the cursor's
// logical line actually starts, and row 0's entry is whatever the boot
// banner's scrolling left there. Measured under xvic: PLOT to row 0
// landed READY. on row 2, same as row 1 — the stale table sends both
// to the same place — so row 1 is the one that costs nothing extra
// and is provably stable (rows 1, 2 and 5 all measured one row below
// where PLOT put them).
export function releaseCursor(): void {
    asm6502 {
        ldx #1
        ldy #0
        clc
        jsr $FFF0
    }
}

// @8bitscript/vic20/sound — the VIC's three squares and noise at $900A–$900D.
// One shared volume at $900E; divisor a = (~reg) & 127 per channel.
export namespace sound {
    function tone(voice: utinyint, period: utinyint): void {
        let v: utinyint = (~period) & 127;
        v = v | 128;
        memory.write(0x900A + voice, v);
    }

    function volume(level: utinyint): void {
        memory.write(0x900E, level & 15);
    }

    function quiet(): void {
        memory.write(0x900A, 0);
        memory.write(0x900B, 0);
        memory.write(0x900C, 0);
        memory.write(0x900D, 0);
    }
}

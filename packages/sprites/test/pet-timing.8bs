// How long the PET twin's update() takes, in cycles, read off the VIA's
// timer 1 ($E844/5, free-running with ACR $E84B = $40, counting down at
// 1 MHz): COUNT ring sprites, every one moved a pseudo-pixel on even
// frames (the worst case — the erase and redraw run over all of them),
// only the last on odd frames (one erase, one redraw, and the set test
// over the rest). Both counts are written as sixteen binary cells (solid
// block: 1) on rows 22 and 23, high bit first — readable off a
// screenshot's cell map exactly, where digits are not. A PET frame at
// 60 Hz is ~16,667 cycles. Measured 2026-09-19 on the 3032 (`8bs run pet
// --profile 3032 --frames 300 --screenshot`), all moving / one moving:
// COUNT 8: 21,155 / 4,582; 5: 13,746 / 3,930; 3: 7,980 / 3,546.
import { screen } from "@8bitscript/screen";
import { text } from "@8bitscript/text";
import { sprites } from "../src/index.8bs";

const COUNT: utinyint = 8;
let step: utinyint = 0;

function layout(all: bool): void {
    let dx: utinyint = (step & 7) << 2;
    let dy: utinyint = ((step >> 1) & 3) << 2;
    let first: utinyint = 0;
    if (!all) {
        first = COUNT - 1;
    }
    for (let i: utinyint = first; i < COUNT; i++) {
        let x: usmallint = (i & 3);
        x = x * 72 + 16 + dx;
        let y: usmallint = (i >> 2);
        y = y * 40 + 24 + dy;
        sprites.place(i, x, y);
    }
}

export function main(): void {
    screen.blank();
    text.print(0, "SIXTEEN QUADRANT SPRITES: CYCLES PER UPDATE");
    text.print(text.COLUMNS, "ALL MOVING: ROW 22. ONE MOVING: ROW 23");
    sprites.defineShape(1, 6, 9, 9, 6);
    sprites.begin(COUNT);
    for (let i: utinyint = 0; i < COUNT; i++) {
        sprites.setShape(i, 1);
    }
    layout(true);
    sprites.update();
    memory.write(0xE84B, 0x40);
    while (true) {
        waitFrame();
        step = step + 1;
        let all: bool = (step & 1) == 0;
        layout(all);
        memory.write(0xE844, 0xFF);
        memory.write(0xE845, 0xFF);
        sprites.update();
        let lo: utinyint = memory.read(0xE844);
        let hi: utinyint = memory.read(0xE845);
        let elapsed: usmallint = hi;
        elapsed = (elapsed << 8) | lo;
        elapsed = 0xFFFF - elapsed;
        let cell: usmallint = 880; // row 22 (a literal: `22 * 40` folds at eight bits)
        if (!all) {
            cell = 920;            // row 23
        }
        for (let bit: utinyint = 0; bit < 16; bit++) {
            let code: utinyint = 32;
            if ((elapsed & 0x8000) != 0) {
                code = 160;
            }
            memory.write(0x8000 + cell + bit, code);
            elapsed = elapsed << 1;
        }
    }
}

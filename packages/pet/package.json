            "4": {
              "label": "4 KiB — the 2001's own stock RAM, the smallest real PET",
              "build": {
                "defsym": {
                  "__ram_size": 4
                }
              },
              "run": {
                "xpet": [
                  "-ramsize",
                  "4"
                ]
              },
              "facts": {
                "memory.ram": 3071
              }
            },
            "8": {
              "label": "8 KiB — the 3008's own stock RAM, and a common on-board 2001 upgrade",
              "build": {
                "defsym": {
                  "__ram_size": 8
                }
              },
              "run": {
                "xpet": [
                  "-ramsize",
                  "8"

  "repository": {
    "type": "git",
    "url": "https://github.com/8BitScript/8bitscript.git",
    "directory": "packages/pet"
  },
  "8bitscript": {
    "entry": "./src/index.8bs",
    "exports": {
      "./screen": "./src/screen.8bs",
      "./text": "./src/text.8bs",
      "./keyboard": "./src/keyboard.8bs",
      "./keys": "./src/keys.8bs",
      "./blocks": "./src/blocks.8bs",
      "./input": "./src/input.8bs",
      "./pointer": "./src/pointer.8bs"
    },
    "hardware": {

          "label": "Speaker",
          "default": "none",
          "values": {
            "none": {
              "label": "None — stock on the non-CRTC 2001/3008/3016/3032, which have no speaker at all",
              "build": {},
              "run": {
                "xpet": [
                  "+sound"
                ]
              },
              "facts": {
                "audio.voices": 0
              }
            },
            "attached": {
              "label": "Attached — built in on the CRTC 4016/4032/8032, or wired to the user port's CB2 pin on a 2001/3008/3016/3032 (the real \"user port speaker hack\")",
              "build": {},
              "run": {
                "xpet": [
                  "-sound"
                ]
              },
              "facts": {

// Links every answer @8bitscript/pet/input gives a portable program —
// input.test.mjs proves this file links clean for the PET and that each
// call resolves to a real function in the IR. Drawing one byte per answer
// keeps every call reachable (an unread result would prune the function
// before the test could see it).
import { input } from "../src/input.8bs";

export function main(): void {
    input.begin();
    while (true) {
        waitFrame();
        input.poll();
        let out: utinyint = 0;
        if (input.left()) {
            out = out | 1;
        }
        if (input.right()) {
            out = out | 2;
        }
        if (input.up()) {
            out = out | 4;
        }
        if (input.down()) {
            out = out | 8;
        }
        if (input.confirm()) {
            out = out | 16;
        }
        if (input.cancel()) {
            out = out | 32;
        }
        memory.write(0x8000, out);
    }
}

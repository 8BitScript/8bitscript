// The PET's character-set raster split under xpet (3032 model), read by
// test/raster.test.mjs: a list built once, enable()d, and a frame loop
// kept running — every split must land on its target picture line and
// hold still from frame to frame, the same discipline
// packages/vic20/test/raster-probe.8bs uses for its own machine.
//
// Every screen cell holds code 1, whose glyph differs between the
// graphics and text character sets (packages/pet/AGENTS.md, "Raster:
// character-set switching" has the two bitmaps). The split: graphics
// above line 30, text from 30 to 139, graphics again from 140. A frame
// counter (raw digit screen codes, $30-$39 — shared, unchanged between
// the two character sets, so it proves the loop is live without itself
// writing the PCR the way text.print would) cycles cell 0 every frame.
import { raster, Slot } from "@8bitscript/raster";

let frames: utinyint = 0;

export function main(): void {
    for (let cell: usmallint = 0; cell < 1000; cell++) {
        memory.write(0x8000 + cell, 1);
    }
    raster.clear();
    raster.at(30, Slot.CHARSET, 1);
    raster.at(140, Slot.CHARSET, 0);
    raster.enable();
    while (true) {
        waitFrame();
        frames = frames + 1;
        if (frames >= 10) {
            frames = 0;
        }
        memory.write(0x8000, 0x30 + frames);
    }
}

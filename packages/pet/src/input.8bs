// @8bitscript/pet/input — the PET behind @8bitscript/input.
//
// Named by "8bitscript".exports["./input"] in this package's package.json,
// and by "8bitscript".entry.pet in @8bitscript/input's, so a portable
// program writes
//
//     use @8bitscript::input::input;
//
// and gets this file on a PET. The matrix itself is ./keyboard.8bs with
// ./keys.8bs, which stay available to a program that wants a key this file
// does not map.
//
// ---- a keyboard and nothing else -----------------------------------------
//
// The PET is the machine with the least to offer this surface, and saying
// so plainly is the job. There are **no control ports** — no joystick, no
// paddles, no mouse, nothing to plug in — because the machine predates the
// idea. `pointer()` is a constant false, and so every `if
// (input.pointer())` in a component folds away to nothing here.
//
// What there is is a keyboard, and it has the two cursor keys the
// Commodore machines all have rather than four: `CURSOR_RIGHT` and
// `CURSOR_DOWN`, each reversed by SHIFT. So left is SHIFT plus the right
// key. That is what the machine has, and this file reports it rather than
// pretending otherwise.
//
//   - **left / right / up / down** — the two cursor keys, with SHIFT.
//   - **confirm** — RETURN.
//   - **cancel** — RUN/STOP.
//
// ---- edges, not levels — and on the PHYSICAL key, not the direction ------
//
// Every answer is **edge-triggered**: true on the one frame the press
// begins, false while it is held. `poll()` must be called exactly once a
// frame, right after waitFrame().
//
// The edge is detected on the physical cursor key, and SHIFT is sampled
// at that instant to decide which direction the edge means. Detecting
// edges on the *direction* instead — "LEFT began" as a bit of
// shift-AND-cursor — is the obvious spelling and it is wrong on real
// fingers: nobody releases SHIFT and the cursor key on the same frame,
// so every left/up release leaves one or two frames of bare cursor key,
// which reads as a brand-new RIGHT/DOWN press. Measured before this was
// fixed (VICE, synthetic keys with a 120ms release skew, the 2048 game):
// every left move was followed by a phantom right move that slid the
// board straight back — "my keypress did nothing." A key that is DOWN
// can't begin again, whatever SHIFT does around it.
//
// One thing worth knowing about this keyboard specifically: the PET's
// matrix is read a row at a time and has the same ghosting every
// undiodedmatrix does — three keys down can read as four. Two keys are
// always safe, and SHIFT plus a cursor key is two.
use self::keyboard::keyboard;
use self::keys::Key;

mod Edge {
    const LEFT: utinyint = 1;
    const RIGHT: utinyint = 2;
    const UP: utinyint = 4;
    const DOWN: utinyint = 8;
    const CONFIRM: utinyint = 16;
    const CANCEL: utinyint = 32;
}

// The physical keys, one bit each — what edge detection actually runs on.
mod Held {
    const CURSOR_RIGHT: utinyint = 1;
    const CURSOR_DOWN: utinyint = 2;
    const RETURN: utinyint = 4;
    const STOP: utinyint = 8;
}

let mut keysBefore: utinyint = 0;
let mut began: utinyint = 0;

pub mod input {
    // Nothing to set up: there is no pointer to give a ceiling to and the
    // matrix needs no configuration. Here so a program written for nine
    // machines calls the same thing on all of them.
    fn begin() {
        // One poll before the program's first, so the edge detector starts
        // from what is actually held rather than from nothing. `before` is
        // zero until something fills it, and an edge is "held now, not held
        // before" — so without this, anything already down when a program
        // starts reads as a fresh press on frame one. Measured on the
        // MEGA65, whose RETURN key is down at start-up: the joystick example
        // counted a confirm() nobody pressed until begin() primed this.
        input::poll();
    }

    // Snapshot the matrix and work out what began this frame. Once a
    // frame, right after waitFrame(). Edges come from the physical keys;
    // SHIFT only decides what a cursor key's own edge means (see the
    // header for why the other order reads releases as phantom presses).
    fn poll() {
        keyboard::scan();

        let mut keys: utinyint = 0;
        if keyboard::pressed(Key::CURSOR_RIGHT) {
            keys = keys | Held::CURSOR_RIGHT;
        }
        if keyboard::pressed(Key::CURSOR_DOWN) {
            keys = keys | Held::CURSOR_DOWN;
        }
        if keyboard::pressed(Key::RETURN) {
            keys = keys | Held::RETURN;
        }
        if keyboard::pressed(Key::STOP) {
            keys = keys | Held::STOP;
        }
        let newKeys: utinyint = keys & (keysBefore ^ 0xFF);
        keysBefore = keys;

        let shifted: bool = keyboard::pressed(Key::SHIFT_LEFT) || keyboard::pressed(Key::SHIFT_RIGHT);
        began = 0;
        if (newKeys & Held::CURSOR_RIGHT) != 0 {
            if shifted {
                began = began | Edge::LEFT;
            } else {
                began = began | Edge::RIGHT;
            }
        }
        if (newKeys & Held::CURSOR_DOWN) != 0 {
            if shifted {
                began = began | Edge::UP;
            } else {
                began = began | Edge::DOWN;
            }
        }
        if (newKeys & Held::RETURN) != 0 {
            began = began | Edge::CONFIRM;
        }
        if (newKeys & Held::STOP) != 0 {
            began = began | Edge::CANCEL;
        }
    }

    fn left() -> bool {
        return (began & Edge::LEFT) != 0;
    }

    fn right() -> bool {
        return (began & Edge::RIGHT) != 0;
    }

    fn up() -> bool {
        return (began & Edge::UP) != 0;
    }

    fn down() -> bool {
        return (began & Edge::DOWN) != 0;
    }

    fn confirm() -> bool {
        return (began & Edge::CONFIRM) != 0;
    }

    fn cancel() -> bool {
        return (began & Edge::CANCEL) != 0;
    }

    // No control ports on this machine, so no pointer — a constant, not a
    // measurement.
    fn pointer() -> bool {
        return false;
    }

    fn pointerCell() -> usmallint {
        return 0;
    }

    fn pointerButton() -> bool {
        return false;
    }
}

// Compile-time names for the confirm control, interpolated into catalogs
// as {control} / {other}. OR / ODER lives in the catalog, not here.
pub mod Input {
    const CONFIRM_LABEL: string = "RETURN";
    const ALT_CONFIRM_LABEL: string = "RETURN";
    const CONFIRM_LABELS: string = "RETURN";
}

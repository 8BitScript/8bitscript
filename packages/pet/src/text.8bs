// @8bitscript/pet/text — the PET's implementation of @8bitscript/text.
//
// Named by "8bitscript".exports["./text"] in this package's package.json,
// and what
//
//     import { text } from "@8bitscript/text";
//
// resolves to when the build is for the PET. Built on the register
// @8bitscript/pet exports. Every machine's text.8bs exports this same
// namespace — the same names, the same shapes, ASCII codes, and a cell 0
// at the top-left corner of the screen — so a program that imports it from
// @8bitscript/text draws the same thing on every target.
import { viaPeripheralControl } from "./index.8bs";
import { Video } from "./geometry.8bs";

// PET screen memory is at $8000 on every model: 1000 cells for the 40x25
// display of the 2001/3xxx/4xxx machines, 2000 for the 80x25 of the 8032 —
// which is the build's `--profile` to say (PET_PROFILES in
// packages/compiler/src/mos), and reaches this file as ./geometry.8bs's
// `Video` namespace, whose 8032 version the profile selects. There is no
// color RAM to go with it — a character's screen code alone decides how it
// looks — so `putColor` and `setColor` exist only so portable code written
// against every machine's `text` namespace still compiles; they do nothing,
// the same way this package's `screen.setColors()` does nothing. A call
// to either is deleted before the PET ever sees it (linker/optimize.mjs).
//
// `text.putChar` takes ASCII on every machine — space (32), '0'-'9'
// (48-57), 'A'-'Z' (65-90), 'a'-'z' (97-122) and the punctuation
// `! , - . : ?` — that is the portable set, the characters every target's
// character set has (the NES ships its own font, and that is what it has).
// The PET's own character ROM turns out to hold both cases at once, just
// not at the ASCII-shaped addresses: measured directly against the real
// ROM (`characters-2.901447-10.bin`, 8 bytes/glyph, 128 glyphs per
// character set, both sets in one 2048-byte file) rather than assumed —
// screen codes 32-63 (space, digits, punctuation) render identically in
// both sets; codes 1-26 render as 'A'-'Z' in the **graphics** set (0x0C)
// but as 'a'-'z' in the **text** set (0x0E); codes 65-90 render as
// graphics symbols in the graphics set but as 'A'-'Z' (shifted) in the
// text set. So the text set alone already has everything: lower case at
// 1-26, upper case at 65-90, the rest unchanged — no per-character
// charset switch needed, since the PCR's charset bit is one register for
// the whole screen, not a per-cell choice. asciiToScreenCode() picks
// text-set addresses accordingly: 'A'-'Z' pass straight through (already
// the text set's own uppercase range), 'a'-'z' drop by 96 to reach 1-26,
// everything else is unchanged. This also settles the old graphics/text
// boot-state mismatch the previous, uppercase-only version worked around
// (3032/4032 boot into graphics, 8032 into text) the same way: putChar()
// still selects one character set itself, every call, through the VIA's
// peripheral control register (see @8bitscript/pet) — now the text set,
// which is a strict superset of what the graphics set could show here.
// (See packages/pet/AGENTS.md.)
//
// blocks.8bs's own quadrant-block glyphs (screen codes 96-127) still work
// unchanged: measured directly alongside the letters above, those codes
// are byte-identical between the two character sets (two exceptions in
// the full 96-127 range, 105 and 122, are graphics-only codes blocks.8bs
// never uses), so nothing that draws with them cares which set is active.
//
// One real wrinkle, also only found by measuring the ROM directly rather
// than assuming one file speaks for the family: the original PET 2001's
// own character ROM (901447-08, VICE's `characters-1.901447-08.bin`) has
// the text set's two cases the other way round from every later model's
// (901447-10, measured above) — upper case stays at 1-26 (unchanged from
// the graphics set, not moved to 65-90) and lower case moves to 65-90
// instead. `video.characterSetSwapped` (the PET catalog's `model` option,
// `packages/compiler/src/fold/facts.mjs`) is this fact, `#fact()`-folded
// at build time — true only for the 2001 today — so a `--profile 2001`
// build gets the offsets its own real ROM needs, and no other build pays
// for the branch it can't take.
namespace CharacterSet {
    const TEXT: utinyint = 0x0E;
}

function asciiToScreenCode(code: utinyint): utinyint {
    if (#fact(video.characterSetSwapped)) {
        if (code >= 65 && code < 91) {
            return code - 64; // 'A'-'Z': the 2001's own text set keeps upper case at 1-26
        }
        if (code >= 97 && code < 123) {
            return code - 32; // 'a'-'z': moved to 65-90 instead, on this ROM only
        }
        return code;
    }
    if (code >= 65 && code < 91) {
        return code; // 'A'-'Z': already the text set's own upper-case range
    }
    if (code >= 97 && code < 123) {
        return code - 96; // 'a'-'z': the text set's lower case lives at 1-26
    }
    return code; // space, digits, punctuation: unchanged in either set
}

// ---- print: strings and number fields ------------------------------------
//
// `text.print(cell, s)` writes a string's characters into consecutive
// cells from `cell`, and `text.printNumber(cell, value, width)` writes
// `value` as exactly `width` decimal digits, zero-padded and right-aligned,
// so a field on a HUD never shifts columns. Both draw in the current color —
// white until `text.setColor(TextColor.CYAN)` changes it, and that one
// call then colors everything printed after it, on the machines that have
// per-cell color. They are also the two
// functions the compiler's template layout targets: `text.print(0,
// \`TICK ${ticks:1}\`)` is laid out at compile time into these same calls
// (see packages/compiler/src/ir).
//
// Under them: `place()` puts one character at one cell in the current
// color, and is all a run of text costs per character, with `prepare()`
// selecting the text character set once for the run.
// `text.putChar` and `text.putColor` stay the one-cell pokes a caller can
// build anything from.
let currentReverse: bool = false; // until text.setReverse() says otherwise

// Reverse video is bit 7 of the screen code: 128-255 are the ROM's
// inverted copies of 0-127. A reverse space is a solid block.
function toScreen(code: utinyint): utinyint {
    let screen: utinyint = asciiToScreenCode(code);
    if (currentReverse) {
        screen = screen + 128;
    }
    return screen;
}

// What a run of text needs once, before its first character.
function prepare(): void {
    viaPeripheralControl = CharacterSet.TEXT;
}

function place(cell: usmallint, code: utinyint): void {
    memory.write(0x8000 + cell, toScreen(code));
}

// ---- digits -------------------------------------------------------------
//
// A number is written one place at a time, high to low, by subtracting the
// place value until it no longer fits: the 6502 has no divide instruction,
// and `value / 10` would link a 250-byte routine to do it. Places above the
// field are still taken off, so a field narrower than its number shows the
// low digits; places the number does not reach print as zeros.
const DIGIT_PLACES: array<usmallint, 5> = [10000, 1000, 100, 10, 1];

export namespace text {
    const CELL_COUNT: usmallint = Video.CELL_COUNT; // 40 x 25, or 80 x 25 on the 8032 profile
    const COLUMNS: utinyint = Video.COLUMNS; // cells per row, so cell = y * text.COLUMNS + x

    function putChar(cell: usmallint, code: utinyint): void {
        prepare();
        memory.write(0x8000 + cell, toScreen(code));
    }

    function putColor(cell: usmallint, color: utinyint): void {
        // Deliberately empty — the PET has no color RAM.
    }

    function setColor(color: utinyint): void {
        // Deliberately empty — the PET has no color RAM.
    }

    function setReverse(on: bool): void {
        currentReverse = on;
    }

    // Writes `s`'s characters into consecutive cells starting at `cell`, in
    // the current color — `text.setColor(...)` changes what gets printed
    // after it, not what is already on screen.
    function print(cell: usmallint, s: string): void {
        prepare();
        for (let i: utinyint = 0; i < s.length; i++) {
            place(cell + i, s[i]);
        }
    }

    // Writes `value` as exactly `width` decimal digits, zero-padded and
    // right-aligned, starting at `cell` — a field on a HUD never shifts
    // columns as the number changes.
    function printNumber(cell: usmallint, value: usmallint, width: utinyint): void {
        prepare();
        let k: utinyint = width;
        if (k < DIGIT_PLACES.length) {
            k = DIGIT_PLACES.length;
        }
        while (k > 0) {
            let digit: utinyint = 48; // '0'
            if (k <= DIGIT_PLACES.length) {
                while (value >= DIGIT_PLACES[DIGIT_PLACES.length - k]) {
                    value = value - DIGIT_PLACES[DIGIT_PLACES.length - k];
                    digit++;
                }
            }
            if (k <= width) {
                place(cell + width - k, digit);
            }
            k--;
        }
    }
}

// The colors `text.setColor()` takes. The PET has no color RAM, so the
// names are here for a program that compiles everywhere and their values
// go nowhere.
export namespace TextColor {
    const BLACK: utinyint = 0;
    const WHITE: utinyint = 1;
    const RED: utinyint = 2;
    const CYAN: utinyint = 3;
    const PURPLE: utinyint = 4;
    const GREEN: utinyint = 5;
    const BLUE: utinyint = 6;
    const YELLOW: utinyint = 7;
}

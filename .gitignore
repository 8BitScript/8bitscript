# Dependencies
node_modules/

# Local pnpm content-addressable store (hashed blobs, not lockfile).
# pnpm's default store lives outside the repo; this directory only appears
# if something invoked pnpm with --store-dir pointing here.
.pnpm-store/

# Compiler and bundler output
dist/
build/

# lcov output from `pnpm run test:coverage` (scripts/test-coverage.mjs)
coverage/

# Compiled Commodore program images
*.prg

# prepack output: type-stripped backend JS emitted next to its .ts source
# (packages/compiler/tsconfig.publish.json) — the published package runs
# these; the workspace runs the .ts directly. Everything handwritten under
# the compiler's src is .mjs, so *.js there is always generated.
packages/compiler/src/**/*.js

# Packaged VS Code extension (local `pnpm package` writes
# editors/vscode/dist/8bitscript-lang.vsix)
*.vsix

# Wrangler local state and cache
.wrangler/

# Logs
*.log

# OS cruft
.DS_Store
.claude/worktrees/

# Editor state (per-developer, not project config — see .vscode/launch.json for shared debug config)
.vscode/settings.json
.claude/settings.local.json
.cursor/rules/
.cursor/cli.json

# SonarLint local state. connectedMode.json is the shared Cloud binding.
.sonarlint/*
!.sonarlint/connectedMode.json
